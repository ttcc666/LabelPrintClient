<UserControl x:Class="LabelPrintClient.Views.TemplateManageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="ui:TextBlock">
            <Setter Property="FontTypography" Value="BodyStrong" />
            <Setter Property="Margin" Value="4,0,0,8" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部：页面命令条 -->
        <ui:Card Grid.Row="0" Margin="0,0,0,8" Padding="10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:TextBlock FontTypography="Subtitle" Text="模板维护" VerticalAlignment="Center" Margin="0,0,20,0" />
                    <TextBlock Text="模式: " VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="RunModeText" VerticalAlignment="Center" FontWeight="SemiBold" />
                </StackPanel>

                <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ui:Button Content="刷新" Click="Refresh_Click" Margin="0,0,8,0" Icon="{ui:SymbolIcon ArrowClockwise24}" />
                    <ui:Button Content="初始化示例数据" Click="SeedDemo_Click" Icon="{ui:SymbolIcon Database24}" />
                </WrapPanel>
            </DockPanel>
        </ui:Card>

        <!-- 主从三栏：分类 -> 模板 -> 字段 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="440" MinWidth="350" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="350" />
            </Grid.ColumnDefinitions>

            <!-- 标签分类 -->
            <Grid Grid.Column="0" Margin="0,0,6,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ui:TextBlock Grid.Row="0" Style="{StaticResource SectionTitleStyle}" Text="标签分类" />
                <ui:Card Grid.Row="1" Padding="10" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="CategoryNameBox" Grid.Column="0" PlaceholderText="输入分类名称" Margin="0,0,8,0" />
                            <ui:Button Grid.Column="1" Content="新增" Appearance="Primary" Click="AddCategory_Click" Icon="{ui:SymbolIcon Add24}" />
                        </Grid>

                        <ui:DataGrid x:Name="CategoryGrid"
                                     Grid.Row="1"
                                     SelectionChanged="CategoryGrid_SelectionChanged"
                                     AutoGenerateColumns="False"
                                     IsReadOnly="True"
                                     Margin="0"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" MinWidth="120" />
                                <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsEnabled}" Width="56" />
                            </DataGrid.Columns>
                        </ui:DataGrid>
                        <TextBlock x:Name="CategoryEmptyText"
                                   Grid.Row="1"
                                   Text="暂无标签分类"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="Collapsed" />
                    </Grid>
                </ui:Card>
            </Grid>

            <!-- 拖拽条 1 -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" Margin="2,0" />

            <!-- 标签模板 -->
            <Grid Grid.Column="2" Margin="6,0,6,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ui:TextBlock Grid.Row="0" Style="{StaticResource SectionTitleStyle}" Text="标签模板" Margin="4,0,0,0" />
                <ui:Card Grid.Row="1" Padding="10" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="TemplateNameBox" Grid.Column="0" PlaceholderText="输入模板名称" Margin="0,0,8,0" />
                            <ui:Button Grid.Column="1" Content="新增" Appearance="Primary" Click="AddTemplate_Click" Icon="{ui:SymbolIcon Add24}" />
                        </Grid>

                        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                            <ui:Button Content="上传 .mrt" Click="UploadTemplate_Click" Margin="0,0,8,0" Icon="{ui:SymbolIcon ArrowUp24}" />
                            <ui:Button Content="打开设计器" Click="DesignTemplate_Click" Icon="{ui:SymbolIcon Edit24}" />
                        </WrapPanel>

                        <ui:DataGrid x:Name="TemplateGrid"
                                     Grid.Row="2"
                                     SelectionChanged="TemplateGrid_SelectionChanged"
                                     AutoGenerateColumns="False"
                                     IsReadOnly="True"
                                     Margin="0"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="130" />
                                <DataGridTextColumn Header="存储" Binding="{Binding StorageType}" Width="70" />
                                <DataGridTextColumn Header="文件" Binding="{Binding TemplateFileName}" Width="*" MinWidth="120" />
                            </DataGrid.Columns>
                        </ui:DataGrid>
                        <TextBlock x:Name="TemplateEmptyText"
                                   Grid.Row="2"
                                   Text="请选择分类查看模板"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="Collapsed" />

                        <Border Grid.Row="3" Padding="0,8,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="每页" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ComboBox x:Name="TemplatePageSizeBox" Width="68" SelectedIndex="1" SelectionChanged="TemplatePageSizeBox_SelectionChanged" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <ComboBoxItem Content="10" />
                                    <ComboBoxItem Content="20" />
                                    <ComboBoxItem Content="50" />
                                </ComboBox>
                                <ui:Button x:Name="TemplateFirstPageButton" Content="&lt;&lt;" Style="{StaticResource PagerButtonStyle}" Click="TemplateFirstPage_Click" />
                                <ui:Button x:Name="TemplatePrevPageButton" Content="&lt;" Style="{StaticResource PagerButtonStyle}" Click="TemplatePrevPage_Click" />
                                <ui:TextBlock x:Name="TemplatePageInfoText" VerticalAlignment="Center" MinWidth="70" TextAlignment="Center" FontWeight="SemiBold" />
                                <ui:Button x:Name="TemplateNextPageButton" Content="&gt;" Style="{StaticResource PagerButtonStyle}" Click="TemplateNextPage_Click" />
                                <ui:Button x:Name="TemplateLastPageButton" Content="&gt;&gt;" Style="{StaticResource PagerButtonStyle}" Click="TemplateLastPage_Click" />
                            </StackPanel>
                        </Border>

                    </Grid>
                </ui:Card>
            </Grid>

            <!-- 拖拽条 2 -->
            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" Margin="2,0" />

            <!-- 模板字段 -->
            <Grid Grid.Column="4" Margin="6,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ui:TextBlock Grid.Row="0" Style="{StaticResource SectionTitleStyle}" Text="模板字段" />
                <ui:Card Grid.Row="1" Padding="10" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <WrapPanel Margin="0,0,0,6">
                                <ui:TextBox x:Name="FieldNameBox" Width="130" PlaceholderText="字段名称" Margin="0,0,8,6" />
                                <ui:TextBox x:Name="FieldCodeBox" Width="130" PlaceholderText="字段编码" Margin="0,0,8,6" />
                                <ComboBox x:Name="FieldTypeBox" Width="104" SelectedIndex="0" Margin="0,0,8,6">
                                    <ComboBoxItem Content="string" />
                                    <ComboBoxItem Content="int" />
                                    <ComboBoxItem Content="decimal" />
                                    <ComboBoxItem Content="date" />
                                    <ComboBoxItem Content="bool" />
                                </ComboBox>
                                <CheckBox x:Name="FieldRequiredBox" Content="必填" VerticalAlignment="Center" Margin="0,0,8,6" />
                            </WrapPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0" x:Name="FieldRemarkBox" PlaceholderText="备注说明" Margin="0,0,8,0" />
                                <WrapPanel Grid.Column="1">
                                    <ui:Button Content="新增" Appearance="Primary" Click="AddField_Click" Margin="0,0,8,0" Icon="{ui:SymbolIcon Add24}" />
                                    <ui:Button Content="保存" Click="SaveField_Click" Margin="0,0,8,0" Icon="{ui:SymbolIcon Save24}" />
                                    <ui:Button Content="清空" Click="ClearFieldForm_Click" Margin="0,0,8,0" />
                                    <ui:Button Content="上移" Click="MoveFieldUp_Click" Margin="0,0,8,0" />
                                    <ui:Button Content="下移" Click="MoveFieldDown_Click" Margin="0,0,8,0" />
                                    <ui:Button Content="删除" Appearance="Danger" Click="DeleteField_Click" Icon="{ui:SymbolIcon Delete24}" />
                                </WrapPanel>
                            </Grid>
                        </StackPanel>

                        <ui:DataGrid x:Name="FieldGrid"
                                     Grid.Row="1"
                                     AutoGenerateColumns="False"
                                     IsReadOnly="True"
                                     SelectionChanged="FieldGrid_SelectionChanged"
                                     Margin="0"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="排序" Binding="{Binding Sort}" Width="52" />
                                <DataGridTextColumn Header="字段名" Binding="{Binding FieldName}" Width="110" />
                                <DataGridTextColumn Header="字段编码" Binding="{Binding FieldCode}" Width="120" />
                                <DataGridTextColumn Header="类型" Binding="{Binding FieldType}" Width="70" />
                                <DataGridCheckBoxColumn Header="必填" Binding="{Binding IsRequired}" Width="56" />
                                <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="*" MinWidth="140" />
                            </DataGrid.Columns>
                        </ui:DataGrid>
                        <TextBlock x:Name="FieldEmptyText"
                                   Grid.Row="1"
                                   Text="请选择模板查看字段"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="Collapsed" />
                    </Grid>
                </ui:Card>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
