<UserControl x:Class="LabelPrintClient.Views.TemplateManageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*" />
            <ColumnDefinition Width="5*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：分类和模板 -->
        <Grid Grid.Column="0" Margin="0,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1.2*" />
            </Grid.RowDefinitions>

            <!-- 工具栏 -->
            <ui:Card Grid.Row="0" Margin="0,0,0,16" Padding="16">
                <StackPanel>
                    <ui:TextBlock FontTypography="Subtitle" Text="模板维护" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="刷新" Click="Refresh_Click" Margin="0,0,8,0" Icon="{ui:SymbolIcon ArrowClockwise24}" />
                        <ui:Button Content="初始化示例数据" Click="SeedDemo_Click" Margin="0,0,8,0" Icon="{ui:SymbolIcon Database24}" />
                        <TextBlock Text="模式: " VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="RunModeText" VerticalAlignment="Center" FontWeight="SemiBold" Margin="4,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- 标签分类 -->
            <ui:TextBlock Grid.Row="1" FontTypography="BodyStrong" Text="标签分类" Margin="4,0,0,8" />
            <ui:Card Grid.Row="2" Margin="0,0,0,16" Padding="12" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <ui:TextBox x:Name="CategoryNameBox" Width="180" PlaceholderText="输入分类名称" Margin="0,0,8,0" />
                        <ui:Button Content="新增分类" Appearance="Primary" Click="AddCategory_Click" Icon="{ui:SymbolIcon Add24}" />
                    </StackPanel>
                    <ui:DataGrid x:Name="CategoryGrid" Grid.Row="1" SelectionChanged="CategoryGrid_SelectionChanged"
                              AutoGenerateColumns="False" IsReadOnly="True" Margin="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                            <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsEnabled}" Width="70" />
                        </DataGrid.Columns>
                    </ui:DataGrid>
                </Grid>
            </ui:Card>

            <!-- 标签模板 -->
            <ui:TextBlock Grid.Row="3" FontTypography="BodyStrong" Text="标签模板" Margin="4,0,0,8" />
            <ui:Card Grid.Row="4" Padding="12" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:TextBox x:Name="TemplateNameBox" Width="180" PlaceholderText="输入模板名称" Margin="0,0,8,0" />
                        <ui:Button Content="新增模板" Appearance="Primary" Click="AddTemplate_Click" Icon="{ui:SymbolIcon Add24}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                        <ui:Button Content="上传 .mrt" Click="UploadTemplate_Click" Margin="0,0,8,0" Icon="{ui:SymbolIcon ArrowUp24}" />
                        <ui:Button Content="打开设计器" Click="DesignTemplate_Click" Icon="{ui:SymbolIcon Edit24}" />
                    </StackPanel>
                    <ui:DataGrid x:Name="TemplateGrid" Grid.Row="2" SelectionChanged="TemplateGrid_SelectionChanged"
                              AutoGenerateColumns="False" IsReadOnly="True" Margin="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="140" />
                            <DataGridTextColumn Header="存储" Binding="{Binding StorageType}" Width="70" />
                            <DataGridTextColumn Header="文件" Binding="{Binding TemplateFileName}" Width="*" />
                        </DataGrid.Columns>
                    </ui:DataGrid>
                </Grid>
            </ui:Card>
        </Grid>

        <!-- 右侧：模板字段 -->
        <Grid Grid.Column="1" Margin="8,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ui:TextBlock Grid.Row="0" FontTypography="BodyStrong" Text="模板字段" Margin="4,0,0,8" />
            <ui:Card Grid.Row="1" Padding="12" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ui:TextBox x:Name="FieldNameBox" Width="140" PlaceholderText="字段名称" Margin="0,0,12,0" />
                            <ui:TextBox x:Name="FieldCodeBox" Width="140" PlaceholderText="字段编码" Margin="0,0,12,0" />
                            <ComboBox x:Name="FieldTypeBox" Width="110" SelectedIndex="0" Margin="0,0,12,0">
                                <ComboBoxItem Content="string" />
                                <ComboBoxItem Content="int" />
                                <ComboBoxItem Content="decimal" />
                                <ComboBoxItem Content="date" />
                                <ComboBoxItem Content="bool" />
                            </ComboBox>
                            <CheckBox x:Name="FieldRequiredBox" Content="必填" VerticalAlignment="Center" />
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" x:Name="FieldRemarkBox" PlaceholderText="备注说明" Margin="0,0,16,0" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ui:Button Content="新增" Appearance="Primary" Click="AddField_Click" Margin="0,0,8,0" Icon="{ui:SymbolIcon Add24}" />
                                <ui:Button Content="删除" Appearance="Danger" Click="DeleteField_Click" Icon="{ui:SymbolIcon Delete24}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <ui:DataGrid x:Name="FieldGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Margin="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="排序" Binding="{Binding Sort}" Width="50" />
                            <DataGridTextColumn Header="字段名" Binding="{Binding FieldName}" Width="120" />
                            <DataGridTextColumn Header="字段编码" Binding="{Binding FieldCode}" Width="120" />
                            <DataGridTextColumn Header="类型" Binding="{Binding FieldType}" Width="70" />
                            <DataGridCheckBoxColumn Header="必填" Binding="{Binding IsRequired}" Width="50" />
                            <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="*" />
                        </DataGrid.Columns>
                    </ui:DataGrid>
                </Grid>
            </ui:Card>
        </Grid>
    </Grid>
</UserControl>