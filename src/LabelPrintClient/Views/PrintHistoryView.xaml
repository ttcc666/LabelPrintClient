<UserControl x:Class="LabelPrintClient.Views.PrintHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="ui:TextBlock">
            <Setter Property="FontTypography" Value="BodyStrong" />
            <Setter Property="Margin" Value="4,0,0,8" />
        </Style>

        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:Card Grid.Row="0" Margin="0,0,0,8" Padding="10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:TextBlock FontTypography="Subtitle" Text="打印记录" VerticalAlignment="Center" Margin="0,0,20,0" />
                    <TextBlock Style="{StaticResource FormLabelStyle}" Text="状态" />
                    <ComboBox x:Name="StatusFilterBox" Width="120" SelectedIndex="0" SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="全部" />
                        <ComboBoxItem Content="已打印" Tag="Printed" />
                        <ComboBoxItem Content="失败" Tag="Failed" />
                        <ComboBoxItem Content="打印中" Tag="Printing" />
                    </ComboBox>
                </StackPanel>

                <ui:Button DockPanel.Dock="Right"
                           Content="刷新"
                           Icon="{ui:SymbolIcon ArrowClockwise24}"
                           Click="Refresh_Click" />
            </DockPanel>
        </ui:Card>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" MinHeight="180" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1.4*" MinHeight="220" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <ui:TextBlock Style="{StaticResource SectionTitleStyle}" Text="打印任务" Margin="4,0,0,0" />
                </Grid>

                <ui:Card Grid.Row="1" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:DataGrid x:Name="JobGrid" Grid.Row="0"
                                     SelectionChanged="JobGrid_SelectionChanged"
                                     AutoGenerateColumns="False"
                                     IsReadOnly="True"
                                     Margin="0"
                                     BorderThickness="0"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="76" />
                                <DataGridTextColumn Header="创建时间" Binding="{Binding CreateTime, StringFormat=MM-dd HH:mm}" Width="112" />
                                <DataGridTextColumn Header="打印时间" Binding="{Binding PrintTime, StringFormat=MM-dd HH:mm}" Width="112" />
                                <DataGridTextColumn Header="模板" Binding="{Binding TemplateName}" Width="150" />
                                <DataGridTextColumn Header="张数" Binding="{Binding SelectedRowCount}" Width="58" />
                                <DataGridTextColumn Header="打印机" Binding="{Binding PrinterNameText}" Width="150" />
                                <DataGridTextColumn Header="操作人" Binding="{Binding OperatorName}" Width="90" />
                                <DataGridTextColumn Header="错误信息" Binding="{Binding ErrorMessage}" Width="*" MinWidth="180" />
                            </DataGrid.Columns>
                        </ui:DataGrid>
                        <Border Grid.Row="1" Padding="0,8,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="8,8,8,8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="每页" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ComboBox x:Name="JobPageSizeBox" Width="68" SelectedIndex="1" SelectionChanged="JobPageSizeBox_SelectionChanged" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <ComboBoxItem Content="10" />
                                    <ComboBoxItem Content="20" />
                                    <ComboBoxItem Content="50" />
                                </ComboBox>
                                <ui:Button x:Name="JobFirstPageButton" Content="&lt;&lt;" Style="{StaticResource PagerButtonStyle}" Click="JobFirstPage_Click" />
                                <ui:Button x:Name="JobPrevPageButton" Content="&lt;" Style="{StaticResource PagerButtonStyle}" Click="JobPrevPage_Click" />
                                <ui:TextBlock x:Name="JobPageInfoText" VerticalAlignment="Center" MinWidth="70" TextAlignment="Center" FontWeight="SemiBold" />
                                <ui:Button x:Name="JobNextPageButton" Content="&gt;" Style="{StaticResource PagerButtonStyle}" Click="JobNextPage_Click" />
                                <ui:Button x:Name="JobLastPageButton" Content="&gt;&gt;" Style="{StaticResource PagerButtonStyle}" Click="JobLastPage_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ui:Card>
            </Grid>

            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent" Cursor="SizeNS" Margin="0,2" />

            <Grid Grid.Row="2" Margin="0,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <ui:TextBlock Style="{StaticResource SectionTitleStyle}" Text="打印明细" Margin="4,0,0,0" />
                </Grid>

                <ui:Card Grid.Row="1" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:DataGrid x:Name="RowGrid" Grid.Row="0"
                                     AutoGenerateColumns="False"
                                     IsReadOnly="True"
                                     Margin="0"
                                     BorderThickness="0"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto" />
                        <Border Grid.Row="1" Padding="0,8,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="8,8,8,8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="每页" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ComboBox x:Name="RowPageSizeBox" Width="68" SelectedIndex="1" SelectionChanged="RowPageSizeBox_SelectionChanged" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <ComboBoxItem Content="20" />
                                    <ComboBoxItem Content="50" />
                                    <ComboBoxItem Content="100" />
                                    <ComboBoxItem Content="200" />
                                </ComboBox>
                                <ui:Button x:Name="RowFirstPageButton" Content="&lt;&lt;" Style="{StaticResource PagerButtonStyle}" Click="RowFirstPage_Click" />
                                <ui:Button x:Name="RowPrevPageButton" Content="&lt;" Style="{StaticResource PagerButtonStyle}" Click="RowPrevPage_Click" />
                                <ui:TextBlock x:Name="RowPageInfoText" VerticalAlignment="Center" MinWidth="70" TextAlignment="Center" FontWeight="SemiBold" />
                                <ui:Button x:Name="RowNextPageButton" Content="&gt;" Style="{StaticResource PagerButtonStyle}" Click="RowNextPage_Click" />
                                <ui:Button x:Name="RowLastPageButton" Content="&gt;&gt;" Style="{StaticResource PagerButtonStyle}" Click="RowLastPage_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ui:Card>
            </Grid>
        </Grid>

        <ui:Card Grid.Row="2" Padding="10" Margin="0,8,0,0">
            <ui:TextBlock x:Name="HistorySummaryText"
                          VerticalAlignment="Center"
                          FontTypography="BodyStrong"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </ui:Card>
    </Grid>
</UserControl>
