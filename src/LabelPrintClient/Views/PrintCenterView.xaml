<UserControl x:Class="LabelPrintClient.Views.PrintCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="ui:TextBlock">
            <Setter Property="FontTypography" Value="BodyStrong" />
            <Setter Property="Margin" Value="4,0,0,8" />
        </Style>

        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="CommandGroupStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Margin" Value="0,0,16,6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：模板选择、Excel 操作、筛选条件 -->
        <ui:Card Grid.Row="0" Margin="0,0,0,8" Padding="10">
            <Grid>
                <WrapPanel VerticalAlignment="Center">
                    <ui:TextBlock FontTypography="Subtitle" Text="标签打印中心" VerticalAlignment="Center" Margin="0,0,20,6" />
                    <StackPanel Style="{StaticResource CommandGroupStyle}">
                    <TextBlock Style="{StaticResource FormLabelStyle}" Text="分类" />
                    <ComboBox x:Name="CategoryBox" Width="150" DisplayMemberPath="Name"
                              SelectionChanged="CategoryBox_SelectionChanged" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource CommandGroupStyle}">
                    <TextBlock Style="{StaticResource FormLabelStyle}" Text="模板" />
                    <ComboBox x:Name="TemplateBox" Width="170" DisplayMemberPath="Name"
                              SelectionChanged="TemplateBox_SelectionChanged" VerticalAlignment="Center" />
                    </StackPanel>
                    <ui:Button Content="刷新" Click="Refresh_Click" Margin="0,0,8,6" Icon="{ui:SymbolIcon ArrowClockwise24}" />
                    <ui:Button Content="下载 Excel 模板" Click="DownloadExcel_Click" Margin="0,0,8,6" Icon="{ui:SymbolIcon ArrowDown24}" />
                    <ui:Button Content="导入 Excel 入库" Appearance="Primary" Click="ImportExcel_Click" Margin="0,0,20,6" Icon="{ui:SymbolIcon ArrowUp24}" />
                    <CheckBox x:Name="OnlyInvalidBox" Content="只看错误" VerticalAlignment="Center" Margin="0,0,16,6"
                              Checked="Filter_Changed" Unchecked="Filter_Changed" />
                    <CheckBox x:Name="OnlyUnprintedBox" Content="只看未打印" VerticalAlignment="Center" Margin="0,0,20,6"
                              Checked="Filter_Changed" Unchecked="Filter_Changed" />
                    <StackPanel Style="{StaticResource CommandGroupStyle}" Margin="0,0,0,6">
                    <TextBlock Style="{StaticResource FormLabelStyle}" Text="打印机" />
                    <ui:TextBox x:Name="PrinterNameBox" Width="190" PlaceholderText="留空使用默认打印机" VerticalAlignment="Center" />
                    </StackPanel>
                </WrapPanel>
            </Grid>
        </ui:Card>

        <!-- 中部：批次列表 + 数据明细 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <ui:TextBlock Style="{StaticResource SectionTitleStyle}" Text="导入批次记录" Margin="4,0,0,0" />
                    <ui:Button Content="刷新批次"
                               Click="LoadBatches_Click"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Icon="{ui:SymbolIcon ArrowClockwise24}" />
                </Grid>
                <ui:Card Grid.Row="1" Padding="10" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <ui:DataGrid x:Name="BatchGrid" Grid.Row="0" SelectionChanged="BatchGrid_SelectionChanged"
                                     IsReadOnly="True" Margin="0"
                                     AutoGenerateColumns="False"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="导入时间" Binding="{Binding ImportTime, StringFormat=MM-dd HH:mm}" Width="112" />
                                <DataGridTextColumn Header="Excel" Binding="{Binding ExcelFileName}" Width="*" MinWidth="130" />
                                <DataGridTextColumn Header="总" Binding="{Binding TotalRows}" Width="44" />
                                <DataGridTextColumn Header="错" Binding="{Binding InvalidRows}" Width="44" />
                            </DataGrid.Columns>
                        </ui:DataGrid>
                    </Grid>
                </ui:Card>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ui:TextBlock Grid.Row="0" Style="{StaticResource SectionTitleStyle}" Text="批次明细数据" />
                <ui:Card Grid.Row="1" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <ui:DataGrid x:Name="RowGrid"
                                 AutoGenerateColumns="False"
                                 CanUserAddRows="False"
                                 Margin="0"
                                 BorderThickness="0"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto" />
                </ui:Card>
            </Grid>
        </Grid>

        <!-- 底部：选择与打印操作 -->
        <ui:Card Grid.Row="2" Padding="10" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:TextBlock x:Name="SummaryText"
                              Grid.Column="0"
                              VerticalAlignment="Center"
                              FontTypography="BodyStrong"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ui:Button Content="全选有效未打印" Click="SelectValidUnprinted_Click" Margin="0,0,8,0" />
                    <ui:Button Content="全选有效行" Click="SelectValid_Click" Margin="0,0,8,0" />
                    <ui:Button Content="反选" Click="ReverseSelect_Click" Margin="0,0,8,0" />
                    <ui:Button Content="清空" Click="ClearSelect_Click" Margin="0,0,16,0" />
                    <ui:Button Content="预览选中行" Click="PreviewSelected_Click" Margin="0,0,8,0" Icon="{ui:SymbolIcon Search24}" />
                    <ui:Button Content="打印选中行" Appearance="Primary" Click="PrintSelected_Click" Icon="{ui:SymbolIcon Print24}" />
                </WrapPanel>
            </Grid>
        </ui:Card>
    </Grid>
</UserControl>
