<UserControl x:Class="LabelPrintClient.Views.PrintCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：批次和筛选 -->
        <Grid Grid.Column="0" Margin="0,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 顶部选择栏 -->
            <ui:Card Grid.Row="0" Margin="0,0,0,16" Padding="16">
                <StackPanel>
                    <ui:TextBlock FontTypography="Subtitle" Text="标签打印中心" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="分类" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ComboBox x:Name="CategoryBox" Width="140" DisplayMemberPath="Name"
                                  SelectionChanged="CategoryBox_SelectionChanged" Margin="0,0,16,0" />
                        <TextBlock Text="模板" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ComboBox x:Name="TemplateBox" Width="160" DisplayMemberPath="Name"
                                  SelectionChanged="TemplateBox_SelectionChanged" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="刷新" Click="Refresh_Click" Margin="0,0,8,0" Icon="{ui:SymbolIcon ArrowClockwise24}" />
                        <ui:Button Content="下载 Excel 模板" Click="DownloadExcel_Click" Margin="0,0,8,0" Icon="{ui:SymbolIcon ArrowDown24}" />
                        <ui:Button Content="导入 Excel 入库" Appearance="Primary" Click="ImportExcel_Click" Icon="{ui:SymbolIcon ArrowUp24}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- 筛选和操作 -->
            <ui:TextBlock Grid.Row="1" FontTypography="BodyStrong" Text="筛选与操作" Margin="4,0,0,8" />
            <ui:Card Grid.Row="2" Margin="0,0,0,16" Padding="12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <CheckBox x:Name="OnlyInvalidBox" Content="只看错误" VerticalAlignment="Center" Margin="0,0,16,0"
                                  Checked="Filter_Changed" Unchecked="Filter_Changed" />
                        <CheckBox x:Name="OnlyUnprintedBox" Content="只看未打印" VerticalAlignment="Center"
                                  Checked="Filter_Changed" Unchecked="Filter_Changed" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="指定打印机" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ui:TextBox x:Name="PrinterNameBox" Width="200" PlaceholderText="留空使用默认打印机" />
                    </StackPanel>
                    <WrapPanel>
                        <ui:Button Content="全选有效未打印" Click="SelectValidUnprinted_Click" Margin="0,0,8,8" />
                        <ui:Button Content="全选有效行" Click="SelectValid_Click" Margin="0,0,8,8" />
                        <ui:Button Content="反选" Click="ReverseSelect_Click" Margin="0,0,8,8" />
                        <ui:Button Content="清空" Click="ClearSelect_Click" Margin="0,0,8,8" />
                    </WrapPanel>
                </StackPanel>
            </ui:Card>

            <!-- 导入批次 -->
            <ui:TextBlock Grid.Row="3" FontTypography="BodyStrong" Text="导入批次记录" Margin="4,0,0,8" />
            <ui:Card Grid.Row="4" Padding="12" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <ui:Button Grid.Row="0" Content="刷新批次" Click="LoadBatches_Click"
                            HorizontalAlignment="Left" Margin="0,0,0,12" Icon="{ui:SymbolIcon ArrowClockwise24}" />
                    <ui:DataGrid x:Name="BatchGrid" Grid.Row="1" SelectionChanged="BatchGrid_SelectionChanged"
                              IsReadOnly="True" Margin="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="导入时间" Binding="{Binding ImportTime, StringFormat=yyyy-MM-dd HH:mm}" Width="120" />
                            <DataGridTextColumn Header="Excel" Binding="{Binding ExcelFileName}" Width="120" />
                            <DataGridTextColumn Header="总" Binding="{Binding TotalRows}" Width="45" />
                            <DataGridTextColumn Header="对" Binding="{Binding ValidRows}" Width="45" />
                            <DataGridTextColumn Header="错" Binding="{Binding InvalidRows}" Width="45" />
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="60" />
                        </DataGrid.Columns>
                    </ui:DataGrid>
                </Grid>
            </ui:Card>
        </Grid>

        <!-- 右侧：数据行和操作 -->
        <Grid Grid.Column="1" Margin="8,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            
            <ui:TextBlock Grid.Row="0" FontTypography="BodyStrong" Text="批次明细数据" Margin="4,0,0,8" />
            
            <!-- 导入数据行 -->
            <ui:Card Grid.Row="1" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" Margin="0,0,0,16">
                <ui:DataGrid x:Name="RowGrid" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0" BorderThickness="0" />
            </ui:Card>

            <!-- 底部操作栏 -->
            <ui:Card Grid.Row="2" Padding="16">
                <Grid>
                    <ui:TextBlock x:Name="SummaryText" VerticalAlignment="Center" FontTypography="BodyStrong" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ui:Button Content="预览选中行" Click="PreviewSelected_Click" Margin="0,0,12,0" Icon="{ui:SymbolIcon Search24}" />
                        <ui:Button Content="打印选中行" Appearance="Primary" Click="PrintSelected_Click" Icon="{ui:SymbolIcon Print24}" />
                    </StackPanel>
                </Grid>
            </ui:Card>
        </Grid>
    </Grid>
</UserControl>