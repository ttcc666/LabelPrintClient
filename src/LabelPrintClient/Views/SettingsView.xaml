<UserControl x:Class="LabelPrintClient.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="ui:TextBlock">
            <Setter Property="FontTypography" Value="BodyStrong" />
            <Setter Property="Margin" Value="4,0,0,8" />
        </Style>

        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="Width" Value="130" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="FormRowStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:Card Grid.Row="0" Margin="0,0,0,8" Padding="10">
            <DockPanel LastChildFill="True">
                <ui:TextBlock DockPanel.Dock="Left"
                              FontTypography="Subtitle"
                              Text="系统配置"
                              VerticalAlignment="Center"
                              Margin="0,0,20,0" />
                <TextBlock x:Name="ConfigPathText"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </ui:Card>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ui:TextBlock Grid.Row="0" Style="{StaticResource SectionTitleStyle}" Text="应用运行配置" />

            <ui:Card Grid.Row="1" Padding="16" VerticalAlignment="Top">
                <Grid MaxWidth="920" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Style="{StaticResource FormRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="360" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FormLabelStyle}" Text="运行模式" />
                        <ComboBox x:Name="RunModeBox" Grid.Column="1" Width="220" HorizontalAlignment="Left">
                            <ComboBoxItem Content="LocalSqlite" Tag="LocalSqlite" />
                            <ComboBoxItem Content="LanPostgreSql" Tag="LanPostgreSql" />
                        </ComboBox>
                    </Grid>

                    <Grid Grid.Row="1" Style="{StaticResource FormRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FormLabelStyle}" Text="SQLite 连接串" />
                        <ui:TextBox x:Name="SqliteConnectionBox" Grid.Column="1" MinWidth="520" Margin="0,0,8,0" />
                        <ui:Button Grid.Column="2" Content="测试" Click="TestSqliteConnection_Click" />
                    </Grid>

                    <Grid Grid.Row="2" Style="{StaticResource FormRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FormLabelStyle}" Text="PostgreSQL 连接串" />
                        <ui:TextBox x:Name="PostgreSqlConnectionBox" Grid.Column="1" MinWidth="520" Margin="0,0,8,0" />
                        <ui:Button Grid.Column="2" Content="测试" Click="TestPostgreSqlConnection_Click" />
                    </Grid>

                    <Grid Grid.Row="3" Style="{StaticResource FormRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FormLabelStyle}" Text="本地模板目录" />
                        <ui:TextBox x:Name="LocalTemplateFolderBox" Grid.Column="1" MinWidth="420" Margin="0,0,8,0" />
                        <ui:Button Grid.Column="2" Content="浏览" Click="BrowseTemplateFolder_Click" Icon="{ui:SymbolIcon FolderOpen24}" />
                    </Grid>

                    <Grid Grid.Row="4" Style="{StaticResource FormRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="360" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FormLabelStyle}" Text="操作人" />
                        <ui:TextBox x:Name="OperatorNameBox" Grid.Column="1" Width="260" HorizontalAlignment="Left" />
                    </Grid>

                    <Grid Grid.Row="5" Style="{StaticResource FormRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="360" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FormLabelStyle}" Text="默认打印机" />
                        <ComboBox x:Name="DefaultPrinterBox" Grid.Column="1" Width="300" HorizontalAlignment="Left" IsTextSearchEnabled="True" />
                    </Grid>

                    <Grid Grid.Row="6" Style="{StaticResource FormRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="360" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FormLabelStyle}" Text="默认打印" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:TextBox x:Name="DefaultPrintCopiesBox" Width="80" Margin="0,0,12,0" />
                            <TextBlock Text="份" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <CheckBox x:Name="ConfirmBeforePrintBox" Content="打印前确认" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="7"
                               Margin="142,4,0,0"
                               Text="保存后会写入 appsettings.json；运行模式、连接串、模板目录等配置需要重启应用后完全生效。"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </Grid>
            </ui:Card>
        </Grid>

        <ui:Card Grid.Row="2" Padding="10" Margin="0,8,0,0">
            <DockPanel LastChildFill="False">
                <ui:TextBlock x:Name="StatusText"
                              DockPanel.Dock="Left"
                              VerticalAlignment="Center"
                              FontTypography="BodyStrong"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <ui:Button Content="重新加载" Click="Reload_Click" Margin="0,0,8,0" Icon="{ui:SymbolIcon ArrowClockwise24}" />
                    <ui:Button Content="保存配置" Appearance="Primary" Click="Save_Click" Icon="{ui:SymbolIcon Save24}" />
                </WrapPanel>
            </DockPanel>
        </ui:Card>
    </Grid>
</UserControl>
