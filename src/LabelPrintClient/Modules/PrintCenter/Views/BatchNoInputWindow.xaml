<Window x:Class="LabelPrintClient.Modules.PrintCenter.Views.BatchNoInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="{DynamicResource BatchNo.Title}"
        Width="460"
        Height="310"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource SecondaryRegionBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Style="{StaticResource AppPageTitleStyle}" Text="{DynamicResource BatchNo.InputTitle}" Margin="0,0,0,16" />

        <!-- 主体区域 -->
        <StackPanel Grid.Row="1">
            <!-- 极富工业高级感的提示横幅 -->
            <Border CornerRadius="8" 
                    Background="#0D0066FF" 
                    BorderThickness="1,0,0,0" 
                    BorderBrush="{DynamicResource PrimaryBrush}" 
                    Padding="12" 
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <iconPacks:PackIconMaterial Kind="InformationOutline" 
                                               Foreground="{DynamicResource PrimaryBrush}" 
                                               Width="16" 
                                               Height="16" 
                                               Margin="0,2,8,0" 
                                               VerticalAlignment="Top"/>
                    <TextBlock Grid.Column="1" 
                               Text="{DynamicResource BatchNo.Hint}" 
                               TextWrapping="Wrap" 
                               FontSize="12" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                               LineHeight="18" />
                </Grid>
            </Border>

            <!-- 输入框控件 -->
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{DynamicResource BatchNo.Name}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBox x:Name="BatchNoBox" 
                         MaxLength="100" 
                         Padding="10,8" 
                         hc:InfoElement.Placeholder="{DynamicResource BatchNo.Placeholder}" />
            </StackPanel>
        </StackPanel>

        <!-- 底部确定与取消按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Width="100" Style="{StaticResource AppDialogPrimaryButtonStyle}" Click="Ok_Click" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Check" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Common.Ok}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Width="90" Style="{StaticResource AppDialogCancelButtonStyle}" Click="Cancel_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Common.Cancel}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
