<UserControl x:Class="LabelPrintClient.Modules.PrintCenter.Views.PrintCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:infra="clr-namespace:LabelPrintClient.Infrastructure"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <UserControl.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource AppSectionTitleStyle}" />

        <Style x:Key="FormLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource AppFormLabelStyle}" />
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：模板选择、Excel 操作、筛选条件 -->
        <Border Grid.Row="0" Style="{StaticResource AppToolbarCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Style="{StaticResource AppPageTitleStyle}" Text="标签打印中心" Margin="0,0,16,0" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="分类" />
                        <ComboBox x:Name="CategoryBox" Width="140" DisplayMemberPath="Name"
                                  infra:SearchableComboBoxBehavior.IsEnabled="True"
                                  infra:SearchableComboBoxBehavior.SearchMemberPath="Name"
                                  SelectionChanged="CategoryBox_SelectionChanged" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="模板" />
                        <ComboBox x:Name="TemplateBox" Width="160" DisplayMemberPath="Name"
                                  infra:SearchableComboBoxBehavior.IsEnabled="True"
                                  infra:SearchableComboBoxBehavior.SearchMemberPath="Name"
                                  SelectionChanged="TemplateBox_SelectionChanged" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="打印机" />
                        <ComboBox x:Name="PrinterNameBox" Width="190" VerticalAlignment="Center"
                                  infra:SearchableComboBoxBehavior.IsEnabled="True" />
                    </StackPanel>

                    <Button Grid.Column="4" Style="{StaticResource AppSecondaryButtonStyle}" Click="Refresh_Click" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Refresh" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="刷新" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,8,0,0">
                    <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="DownloadExcel_Click" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Download" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="下载 Excel 模板" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ButtonPrimary}" Click="ImportExcel_Click" Margin="0,0,20,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="MicrosoftExcel" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="导入 Excel" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <CheckBox x:Name="OnlyInvalidBox" Content="只看错误" VerticalAlignment="Center" Margin="0,0,16,0"
                              Checked="Filter_Changed" Unchecked="Filter_Changed" />
                    <CheckBox x:Name="OnlyUnprintedBox" Content="只看未打印" VerticalAlignment="Center"
                              Checked="Filter_Changed" Unchecked="Filter_Changed" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 中部：批次列表 + 数据明细 -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" MinHeight="220" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1*" MinHeight="200" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource SectionTitleStyle}" Text="导入批次记录" Margin="4,0,16,0" />
                    <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource FormLabelStyle}" Text="关键词" />
                            <TextBox x:Name="BatchSearchBox"
                                     Width="180"
                                     VerticalAlignment="Center"
                                     KeyDown="BatchSearchBox_KeyDown" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource FormLabelStyle}" Text="状态" />
                            <ComboBox x:Name="BatchStatusFilterBox"
                                      Width="110"
                                      SelectedIndex="0"
                                      SelectionChanged="BatchStatusFilterBox_SelectionChanged"
                                      VerticalAlignment="Center">
                                <ComboBoxItem Content="正常批次" Tag="Active" />
                                <ComboBoxItem Content="全部" Tag="All" />
                                <ComboBoxItem Content="已导入" Tag="Imported" />
                                <ComboBoxItem Content="部分错误" Tag="PartError" />
                                <ComboBoxItem Content="已作废" Tag="Voided" />
                            </ComboBox>
                        </StackPanel>
                        <Button  Style="{StaticResource AppSecondaryButtonStyle}" Click="BatchFilter_Click" Margin="0,0,8,0">
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="Magnify" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="查询" VerticalAlignment="Center" />
        </StackPanel>
    </Button>
                        <Button  Style="{StaticResource AppSecondaryButtonStyle}" Click="LoadBatches_Click">
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="Refresh" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="刷新批次" VerticalAlignment="Center" />
        </StackPanel>
    </Button>
                    </WrapPanel>
                </DockPanel>
                <Border Grid.Row="1" Style="{StaticResource AppDataCardStyle}" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="BatchGrid" SelectionChanged="BatchGrid_SelectionChanged"
                                     IsReadOnly="True" Margin="0" BorderThickness="0"
                                     AutoGenerateColumns="False" Grid.Row="0"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="操作" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button  Style="{StaticResource ButtonDanger}"
                                                       Height="28"

                                                       Click="VoidBatch_Click">
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="Cancel" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="作废" VerticalAlignment="Center" />
        </StackPanel>
    </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="导入时间" Binding="{Binding ImportTime, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}" Width="170" />
                                <DataGridTextColumn Header="Excel" Binding="{Binding ExcelFileName}" Width="*" MinWidth="130" />
                                <DataGridTemplateColumn Header="状态" Width="96" SortMemberPath="Status">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentControl Content="{Binding Status}" ContentTemplate="{StaticResource AppStatusBadgeTemplate}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="总行数" Binding="{Binding TotalRows}" Width="80" />
                                <DataGridTextColumn Header="错误行数" Binding="{Binding InvalidRows}" Width="80" />
                                <DataGridTextColumn Header="操作人" Binding="{Binding OperatorName}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="0"
                                    Style="{StaticResource AppDataGridEmptyStatePanelStyle}"
                                    Visibility="{Binding Visibility, ElementName=BatchEmptyText}">
                            <Border Style="{StaticResource AppEmptyStateIconFrameStyle}">
                                <iconPacks:PackIconMaterial Kind="FormatListText" Style="{StaticResource AppEmptyStateIconStyle}" />
                            </Border>
                            <TextBlock x:Name="BatchEmptyText"
                                       Text="暂无导入批次"
                                       Style="{StaticResource AppEmptyStateTitleStyle}"
                                       Visibility="Collapsed" />
                            <TextBlock Text="选择模板后可导入 Excel，生成的批次会显示在这里。"
                                       Style="{StaticResource AppEmptyStateHintStyle}" />
                        </StackPanel>
                        <Border Grid.Row="1" Padding="0,8,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="8,8,8,8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="每页" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ComboBox x:Name="BatchPageSizeBox" Width="68" SelectedIndex="0" SelectionChanged="BatchPageSizeBox_SelectionChanged" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <ComboBoxItem Content="20" />
                                    <ComboBoxItem Content="50" />
                                    <ComboBoxItem Content="100" />
                                </ComboBox>
                                <Button x:Name="BatchFirstPageButton" Style="{StaticResource PagerButtonStyle}" Click="BatchFirstPage_Click">
                                    <iconPacks:PackIconMaterial Kind="PageFirst" Width="16" Height="16" />
                                </Button>
                                <Button x:Name="BatchPrevPageButton" Style="{StaticResource PagerButtonStyle}" Click="BatchPrevPage_Click">
                                    <iconPacks:PackIconMaterial Kind="ChevronLeft" Width="16" Height="16" />
                                </Button>
                                <TextBlock x:Name="BatchPageInfoText" VerticalAlignment="Center" MinWidth="70" TextAlignment="Center" FontWeight="SemiBold" />
                                <Button x:Name="BatchNextPageButton" Style="{StaticResource PagerButtonStyle}" Click="BatchNextPage_Click">
                                    <iconPacks:PackIconMaterial Kind="ChevronRight" Width="16" Height="16" />
                                </Button>
                                <Button x:Name="BatchLastPageButton" Style="{StaticResource PagerButtonStyle}" Click="BatchLastPage_Click">
                                    <iconPacks:PackIconMaterial Kind="PageLast" Width="16" Height="16" />
                                </Button>
                            </StackPanel>
                        </Border>
                        <!-- 批次加载遮罩层 -->
                        <Grid x:Name="BatchLoadingOverlay" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed">
                            <Border Background="{DynamicResource RegionBrush}" Opacity="0.75" CornerRadius="6" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <hc:LoadingCircle Width="36" Height="36" Foreground="{DynamicResource PrimaryBrush}" />
                                <TextBlock Text="正在读取批次记录..." Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 拖拽条 -->
            <GridSplitter Grid.Row="1" Style="{StaticResource AppRowResizeSplitterStyle}" Margin="0,2" />

            <Grid Grid.Row="2" Margin="0,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource SectionTitleStyle}" Text="批次明细数据" Margin="4,0,16,0" />
                    <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource FormLabelStyle}" Text="关键词" />
                            <TextBox x:Name="RowSearchBox"
                                     Width="180"
                                     VerticalAlignment="Center"
                                     KeyDown="RowSearchBox_KeyDown" />
                        </StackPanel>
                        <Button  Style="{StaticResource AppSecondaryButtonStyle}" Click="RowFilter_Click" Margin="0,0,8,0">
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="Magnify" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="查询" VerticalAlignment="Center" />
        </StackPanel>
    </Button>
                        <Button  Style="{StaticResource AppGhostButtonStyle}" Click="ClearRowFilter_Click">
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="FilterRemoveOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="清空" VerticalAlignment="Center" />
        </StackPanel>
    </Button>
                    </WrapPanel>
                </DockPanel>
                <Border Grid.Row="1" Style="{StaticResource AppDataCardStyle}" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="RowGrid" Grid.Row="0"
                                     AutoGenerateColumns="False"
                                     CanUserAddRows="False"
                                     FrozenColumnCount="2"
                                     Margin="0"
                                     BorderThickness="0"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto" />
                        <StackPanel Grid.Row="0"
                                    Style="{StaticResource AppDataGridEmptyStatePanelStyle}"
                                    Visibility="{Binding Visibility, ElementName=RowEmptyText}">
                            <Border Style="{StaticResource AppEmptyStateIconFrameStyle}">
                                <iconPacks:PackIconMaterial Kind="MicrosoftExcel" Style="{StaticResource AppEmptyStateIconStyle}" />
                            </Border>
                            <TextBlock x:Name="RowEmptyText"
                                       Text="请选择批次查看明细"
                                       Style="{StaticResource AppEmptyStateTitleStyle}"
                                       Visibility="Collapsed" />
                            <TextBlock Text="选择导入批次后，可查看明细并勾选需要预览或打印的数据。"
                                       Style="{StaticResource AppEmptyStateHintStyle}" />
                        </StackPanel>
                        <Border Grid.Row="1" Padding="0,8,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="8,8,8,8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="每页" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ComboBox x:Name="PageSizeBox" Width="68" SelectedIndex="1" SelectionChanged="PageSizeBox_SelectionChanged" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <ComboBoxItem Content="20" />
                                    <ComboBoxItem Content="50" />
                                    <ComboBoxItem Content="100" />
                                    <ComboBoxItem Content="200" />
                                </ComboBox>
                                <Button x:Name="FirstPageButton" Style="{StaticResource PagerButtonStyle}" Click="FirstPage_Click">
                                    <iconPacks:PackIconMaterial Kind="PageFirst" Width="16" Height="16" />
                                </Button>
                                <Button x:Name="PrevPageButton" Style="{StaticResource PagerButtonStyle}" Click="PrevPage_Click">
                                    <iconPacks:PackIconMaterial Kind="ChevronLeft" Width="16" Height="16" />
                                </Button>
                                <TextBlock x:Name="PageInfoText" VerticalAlignment="Center" MinWidth="70" TextAlignment="Center" FontWeight="SemiBold" />
                                <Button x:Name="NextPageButton" Style="{StaticResource PagerButtonStyle}" Click="NextPage_Click">
                                    <iconPacks:PackIconMaterial Kind="ChevronRight" Width="16" Height="16" />
                                </Button>
                                <Button x:Name="LastPageButton" Style="{StaticResource PagerButtonStyle}" Click="LastPage_Click">
                                    <iconPacks:PackIconMaterial Kind="PageLast" Width="16" Height="16" />
                                </Button>
                            </StackPanel>
                        </Border>
                        <!-- 明细加载遮罩层 -->
                        <Grid x:Name="RowLoadingOverlay" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed">
                            <Border Background="{DynamicResource RegionBrush}" Opacity="0.75" CornerRadius="6" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <hc:LoadingCircle Width="36" Height="36" Foreground="{DynamicResource PrimaryBrush}" />
                                <TextBlock Text="正在加载明细数据..." Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 底部：批量打印操作 -->
        <Border Grid.Row="2" Style="{StaticResource AppFooterCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="SummaryText"
                              Grid.Row="0"
                              VerticalAlignment="Center"

                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <WrapPanel Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="份数" />
                        <TextBox x:Name="PrintCopiesBox" Width="72" Text="1" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button  Style="{StaticResource AppSecondaryButtonStyle}" Click="SelectValidUnprinted_Click" Margin="0,0,8,0">
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="CheckboxMarked" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="全选有效未打印" VerticalAlignment="Center" />
        </StackPanel>
    </Button>
                    <Button  Style="{StaticResource AppSecondaryButtonStyle}" Click="SelectValid_Click" Margin="0,0,8,0">
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="CheckboxMultipleMarked" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="全选有效行" VerticalAlignment="Center" />
        </StackPanel>
    </Button>
                    <Button  Style="{StaticResource AppGhostButtonStyle}" Click="ReverseSelect_Click" Margin="0,0,8,0">
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="MinusBoxOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="反选" VerticalAlignment="Center" />
        </StackPanel>
    </Button>
                    <Button  Style="{StaticResource AppGhostButtonStyle}" Click="ClearSelect_Click" Margin="0,0,16,0">
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="FilterRemoveOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="清空" VerticalAlignment="Center" />
        </StackPanel>
    </Button>
                    <Button  Style="{StaticResource AppSecondaryButtonStyle}" Click="PreviewSelected_Click" Margin="0,0,8,0">
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="Eye" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="批量预览" VerticalAlignment="Center" />
        </StackPanel>
    </Button>
                    <Button  Style="{StaticResource ButtonPrimary}" Click="PrintSelected_Click">
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="Printer" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="批量打印" VerticalAlignment="Center" />
        </StackPanel>
    </Button>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>