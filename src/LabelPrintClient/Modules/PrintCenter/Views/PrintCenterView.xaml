<UserControl x:Class="LabelPrintClient.Modules.PrintCenter.Views.PrintCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:infra="clr-namespace:LabelPrintClient.Infrastructure"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <UserControl.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">

            <Setter Property="Margin" Value="4,0,0,8" />
        </Style>

        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：模板选择、Excel 操作、筛选条件 -->
        <Border Background="{DynamicResource RegionBrush}" CornerRadius="4" Grid.Row="0" Margin="0,0,0,8" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="标签打印中心" VerticalAlignment="Center" Margin="0,0,16,0" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="分类" />
                        <ComboBox x:Name="CategoryBox" Width="140" DisplayMemberPath="Name"
                                  infra:SearchableComboBoxBehavior.IsEnabled="True"
                                  infra:SearchableComboBoxBehavior.SearchMemberPath="Name"
                                  SelectionChanged="CategoryBox_SelectionChanged" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="模板" />
                        <ComboBox x:Name="TemplateBox" Width="160" DisplayMemberPath="Name"
                                  infra:SearchableComboBoxBehavior.IsEnabled="True"
                                  infra:SearchableComboBoxBehavior.SearchMemberPath="Name"
                                  SelectionChanged="TemplateBox_SelectionChanged" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="打印机" />
                        <ComboBox x:Name="PrinterNameBox" Width="190" VerticalAlignment="Center"
                                  infra:SearchableComboBoxBehavior.IsEnabled="True" />
                    </StackPanel>

                    <Button Grid.Column="4" Click="Refresh_Click" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Refresh" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="刷新" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,8,0,0">
                    <Button Click="DownloadExcel_Click" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Download" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="下载 Excel 模板" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ButtonPrimary}" Click="ImportExcel_Click" Margin="0,0,20,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="MicrosoftExcel" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="导入 Excel" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <CheckBox x:Name="OnlyInvalidBox" Content="只看错误" VerticalAlignment="Center" Margin="0,0,16,0"
                              Checked="Filter_Changed" Unchecked="Filter_Changed" />
                    <CheckBox x:Name="OnlyUnprintedBox" Content="只看未打印" VerticalAlignment="Center"
                              Checked="Filter_Changed" Unchecked="Filter_Changed" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 中部：批次列表 + 数据明细 -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" MinHeight="150" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" MinHeight="200" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource SectionTitleStyle}" Text="导入批次记录" Margin="4,0,16,0" />
                    <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <TextBox x:Name="BatchSearchBox"
                                    Width="180"
                                   
                                    Margin="0,0,8,0"
                                    KeyDown="BatchSearchBox_KeyDown" />
                        <ComboBox x:Name="BatchStatusFilterBox"
                                  Width="110"
                                  SelectedIndex="0"
                                  SelectionChanged="BatchStatusFilterBox_SelectionChanged"
                                  Margin="0,0,8,0">
                            <ComboBoxItem Content="正常批次" Tag="Active" />
                            <ComboBoxItem Content="全部" Tag="All" />
                            <ComboBoxItem Content="已导入" Tag="Imported" />
                            <ComboBoxItem Content="部分错误" Tag="PartError" />
                            <ComboBoxItem Content="已作废" Tag="Voided" />
                        </ComboBox>
                        <Button  Style="{StaticResource ButtonPrimary}" Click="BatchFilter_Click" Margin="0,0,8,0" >
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="Magnify" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="查询" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
                        <Button  Click="LoadBatches_Click" >
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="Refresh" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="刷新批次" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
                    </WrapPanel>
                </DockPanel>
                <Border Background="{DynamicResource RegionBrush}" CornerRadius="4" Grid.Row="1" Padding="0" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="BatchGrid" SelectionChanged="BatchGrid_SelectionChanged"
                                     IsReadOnly="True" Margin="0" BorderThickness="0"
                                     AutoGenerateColumns="False" Grid.Row="0"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="操作" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button  Style="{StaticResource ButtonDanger}"
                                                       Height="28"
                                                      
                                                       Click="VoidBatch_Click" >
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="Cancel" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="作废" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="导入时间" Binding="{Binding ImportTime, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}" Width="170" />
                                <DataGridTextColumn Header="Excel" Binding="{Binding ExcelFileName}" Width="*" MinWidth="130" />
                                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="90" />
                                <DataGridTextColumn Header="总行数" Binding="{Binding TotalRows}" Width="80" />
                                <DataGridTextColumn Header="错误行数" Binding="{Binding InvalidRows}" Width="80" />
                                <DataGridTextColumn Header="操作人" Binding="{Binding OperatorName}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="BatchEmptyText"
                                   Grid.Row="0"
                                   Text="暂无导入批次"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="Collapsed" />
                        <Border Grid.Row="1" Padding="0,8,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="8,8,8,8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="每页" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ComboBox x:Name="BatchPageSizeBox" Width="68" SelectedIndex="0" SelectionChanged="BatchPageSizeBox_SelectionChanged" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <ComboBoxItem Content="20" />
                                    <ComboBoxItem Content="50" />
                                    <ComboBoxItem Content="100" />
                                </ComboBox>
                                <Button x:Name="BatchFirstPageButton" Content="&lt;&lt;" Style="{StaticResource PagerButtonStyle}" Click="BatchFirstPage_Click" />
                                <Button x:Name="BatchPrevPageButton" Content="&lt;" Style="{StaticResource PagerButtonStyle}" Click="BatchPrevPage_Click" />
                                <TextBlock x:Name="BatchPageInfoText" VerticalAlignment="Center" MinWidth="70" TextAlignment="Center" FontWeight="SemiBold" />
                                <Button x:Name="BatchNextPageButton" Content="&gt;" Style="{StaticResource PagerButtonStyle}" Click="BatchNextPage_Click" />
                                <Button x:Name="BatchLastPageButton" Content="&gt;&gt;" Style="{StaticResource PagerButtonStyle}" Click="BatchLastPage_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 拖拽条 -->
            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent" Cursor="SizeNS" Margin="0,2" />

            <Grid Grid.Row="2" Margin="0,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource SectionTitleStyle}" Text="批次明细数据" Margin="4,0,16,0" />
                    <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <TextBox x:Name="RowSearchBox"
                                    Width="180"
                                   
                                    Margin="0,0,8,0"
                                    KeyDown="RowSearchBox_KeyDown" />
                        <Button  Style="{StaticResource ButtonPrimary}" Click="RowFilter_Click" Margin="0,0,8,0" >
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="Magnify" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="查询" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
                        <Button  Style="{StaticResource ButtonDanger}" Click="ClearRowFilter_Click" >
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="FilterRemoveOutline" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="清空" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
                    </WrapPanel>
                </DockPanel>
                <Border Background="{DynamicResource RegionBrush}" CornerRadius="4" Grid.Row="1" Padding="0" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="RowGrid" Grid.Row="0"
                                     AutoGenerateColumns="False"
                                     CanUserAddRows="False"
                                     FrozenColumnCount="2"
                                     Margin="0"
                                     BorderThickness="0"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto" />
                        <TextBlock x:Name="RowEmptyText"
                                   Grid.Row="0"
                                   Text="请选择批次查看明细"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="Collapsed" />
                        <Border Grid.Row="1" Padding="0,8,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="8,8,8,8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="每页" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ComboBox x:Name="PageSizeBox" Width="68" SelectedIndex="1" SelectionChanged="PageSizeBox_SelectionChanged" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <ComboBoxItem Content="20" />
                                    <ComboBoxItem Content="50" />
                                    <ComboBoxItem Content="100" />
                                    <ComboBoxItem Content="200" />
                                </ComboBox>
                                <Button x:Name="FirstPageButton" Content="&lt;&lt;" Style="{StaticResource PagerButtonStyle}" Click="FirstPage_Click" />
                                <Button x:Name="PrevPageButton" Content="&lt;" Style="{StaticResource PagerButtonStyle}" Click="PrevPage_Click" />
                                <TextBlock x:Name="PageInfoText" VerticalAlignment="Center" MinWidth="70" TextAlignment="Center" FontWeight="SemiBold" />
                                <Button x:Name="NextPageButton" Content="&gt;" Style="{StaticResource PagerButtonStyle}" Click="NextPage_Click" />
                                <Button x:Name="LastPageButton" Content="&gt;&gt;" Style="{StaticResource PagerButtonStyle}" Click="LastPage_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 底部：批量打印操作 -->
        <Border Background="{DynamicResource RegionBrush}" CornerRadius="4" Grid.Row="2" Padding="10" Margin="0,8,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="SummaryText"
                              Grid.Row="0"
                              VerticalAlignment="Center"
                             
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <WrapPanel Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="份数" />
                        <TextBox x:Name="PrintCopiesBox" Width="72" Text="1" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button  Click="SelectValidUnprinted_Click" Margin="0,0,8,0" >
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="CheckboxMarked" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="全选有效未打印" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
                    <Button  Click="SelectValid_Click" Margin="0,0,8,0" >
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="CheckboxMultipleMarked" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="全选有效行" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
                    <Button  Click="ReverseSelect_Click" Margin="0,0,8,0" >
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="MinusBoxOutline" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="反选" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
                    <Button  Style="{StaticResource ButtonDanger}" Click="ClearSelect_Click" Margin="0,0,16,0" >
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="FilterRemoveOutline" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="清空" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
                    <Button  Click="PreviewSelected_Click" Margin="0,0,8,0" >
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="Eye" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="批量预览" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
                    <Button  Style="{StaticResource ButtonPrimary}" Click="PrintSelected_Click" >
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="Printer" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="批量打印" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>





