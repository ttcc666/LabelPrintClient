<Window x:Class="LabelPrintClient.Modules.PrintCenter.Views.ImportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="导入前预览"
        Width="980"
        Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SecondaryRegionBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
    <Window.Resources>
        <Style x:Key="ImportPreviewRowStyle" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsValid}" Value="False">
                    <Setter Property="Background" Value="{StaticResource AppDangerSubtleBrush}" />
                    <Setter Property="ToolTip" Value="{Binding ErrorMessage}" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AppDataGridHoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AppDataGridSelectedBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource AppToolbarCardStyle}" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 自适应校验状态面板 -->
                <Grid Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                    <!-- 校验成功卡片 -->
                    <Border x:Name="SuccessAlertCard" Background="#0A00CC66" BorderBrush="#4000CC66" BorderThickness="1" CornerRadius="8" Padding="12,8" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="CheckCircle" Foreground="#00CC66" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource AppPageTitleStyle}" Text="导入前预览" FontSize="16" Margin="0,0,16,0" VerticalAlignment="Center" />
                                
                                <!-- 指标胶囊 -->
                                <Border CornerRadius="10" Padding="8,2" Background="#126B7280" BorderBrush="#206B7280" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="SuccessFileNameText" FontSize="11" Foreground="#6B7280" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Border>
                                <Border CornerRadius="10" Padding="8,2" Background="#122563EB" BorderBrush="#202563EB" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="SuccessTotalText" FontSize="11" Foreground="#2563EB" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Border>
                                <Border CornerRadius="10" Padding="8,2" Background="#1200CC66" BorderBrush="#2000CC66" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="SuccessValidText" FontSize="11" Foreground="#00CC66" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#00CC66" FontSize="12" FontWeight="SemiBold" Text="Excel 数据校验通过，确认后即可写入系统。" />
                        </Grid>
                    </Border>

                    <!-- 校验错误卡片 -->
                    <Border x:Name="ErrorAlertCard" Background="#0AC42B1C" BorderBrush="#40C42B1C" BorderThickness="1" CornerRadius="8" Padding="12,8" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="AlertCircle" Foreground="#C42B1C" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource AppPageTitleStyle}" Text="导入前预览" FontSize="16" Margin="0,0,16,0" VerticalAlignment="Center" />
                                
                                <!-- 指标胶囊 -->
                                <Border CornerRadius="10" Padding="8,2" Background="#126B7280" BorderBrush="#206B7280" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="ErrorFileNameText" FontSize="11" Foreground="#6B7280" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Border>
                                <Border CornerRadius="10" Padding="8,2" Background="#122563EB" BorderBrush="#202563EB" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="ErrorTotalText" FontSize="11" Foreground="#2563EB" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Border>
                                <Border CornerRadius="10" Padding="8,2" Background="#12C42B1C" BorderBrush="#20C42B1C" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="ErrorInvalidText" FontSize="11" Foreground="#C42B1C" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#C42B1C" FontSize="12" FontWeight="SemiBold" Text="存在错误数据行，需修正 Excel 文件后方能确认导入。" />
                        </Grid>
                    </Border>
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Style="{StaticResource AppFormLabelStyle}" Text="关键词" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBox x:Name="PreviewSearchBox"
                             Width="130"
                             Margin="0,0,8,0"
                             KeyDown="PreviewSearchBox_KeyDown" />
                    <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="ApplyFilter_Click" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Magnify" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="查询" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppGhostButtonStyle}" Click="ClearFilter_Click" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="FilterRemoveOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="清空" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <CheckBox x:Name="OnlyErrorRowsBox"
                               Content="只看错误"
                               VerticalAlignment="Center"
                               Checked="OnlyErrorRowsBox_Changed"
                               Unchecked="OnlyErrorRowsBox_Changed" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource AppDataCardStyle}" VerticalAlignment="Stretch">
            <Grid>
                <DataGrid x:Name="PreviewGrid"
                             AutoGenerateColumns="False"
                             IsReadOnly="True"
                             RowStyle="{StaticResource ImportPreviewRowStyle}"
                             Margin="0"
                             BorderThickness="0"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto" />
                <StackPanel Style="{StaticResource AppDataGridEmptyStatePanelStyle}"
                            Visibility="{Binding Visibility, ElementName=EmptyText}">
                    <Border Style="{StaticResource AppEmptyStateIconFrameStyle}">
                        <iconPacks:PackIconMaterial Kind="MicrosoftExcel" Style="{StaticResource AppEmptyStateIconStyle}" />
                    </Border>
                    <TextBlock x:Name="EmptyText"
                               Text="没有可预览的数据"
                               Style="{StaticResource AppEmptyStateTitleStyle}"
                               Visibility="Collapsed" />
                    <TextBlock Text="调整筛选条件，或重新选择包含有效行的 Excel 文件。"
                               Style="{StaticResource AppEmptyStateHintStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource AppFooterCardStyle}">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="ImportHintText"
                           DockPanel.Dock="Left"
                           Text="确认后才会写入导入批次和明细数据。"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <WrapPanel DockPanel.Dock="Right">
                    <Button Style="{StaticResource AppDialogCancelButtonStyle}" Click="Cancel_Click" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="取消" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ConfirmButton"
                            Style="{StaticResource AppPrimaryButtonStyle}"
                            Width="108"
                            Click="Confirm_Click">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Check" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="确认导入" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
