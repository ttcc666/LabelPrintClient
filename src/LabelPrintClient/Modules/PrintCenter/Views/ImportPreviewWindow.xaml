<Window x:Class="LabelPrintClient.Modules.PrintCenter.Views.ImportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="导入前预览"
        Width="980"
        Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SecondaryRegionBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource RegionBrush}" CornerRadius="4" Grid.Row="0" Padding="10" Margin="0,0,0,8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="导入前预览" />
                    <TextBlock x:Name="SummaryText"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBox x:Name="PreviewSearchBox"
                                Width="180"
                               
                                Margin="0,0,8,0"
                                KeyDown="PreviewSearchBox_KeyDown" />
                    <Button  Style="{StaticResource ButtonPrimary}" Click="ApplyFilter_Click" Margin="0,0,8,0" >
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="Magnify" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="查询" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
                    <Button  Style="{StaticResource ButtonDanger}" Click="ClearFilter_Click" Margin="0,0,12,0" >
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="FilterRemoveOutline" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="清空" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
                    <CheckBox x:Name="OnlyErrorRowsBox"
                              Content="只看错误"
                              VerticalAlignment="Center"
                              Checked="OnlyErrorRowsBox_Changed"
                              Unchecked="OnlyErrorRowsBox_Changed" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <Border Background="{DynamicResource RegionBrush}" CornerRadius="4" Grid.Row="1" Padding="0" VerticalAlignment="Stretch">
            <Grid>
                <DataGrid x:Name="PreviewGrid"
                             AutoGenerateColumns="False"
                             IsReadOnly="True"
                             Margin="0"
                             BorderThickness="0"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto" />
                <TextBlock x:Name="EmptyText"
                           Text="没有可预览的数据"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Visibility="Collapsed" />
            </Grid>
        </Border>

        <Border Background="{DynamicResource RegionBrush}" CornerRadius="4" Grid.Row="2" Padding="10" Margin="0,8,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Text="确认后才会写入导入批次和明细数据。"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <WrapPanel DockPanel.Dock="Right">
                    <Button  Style="{StaticResource ButtonDanger}" Click="Cancel_Click" Margin="0,0,8,0" >
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="Close" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="取消" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
                    <Button  Style="{StaticResource ButtonPrimary}" Click="Confirm_Click" >
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="Check" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="确认导入" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
                </WrapPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>






