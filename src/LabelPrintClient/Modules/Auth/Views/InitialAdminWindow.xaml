<hc:Window x:Class="LabelPrintClient.Modules.Auth.Views.InitialAdminWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
           Title="初始化系统管理员"
           Width="480"
           Height="510"
           MinHeight="480"
           WindowStartupLocation="CenterScreen"
           ResizeMode="CanResize"
           Background="{DynamicResource SecondaryRegionBrush}"
           Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部标题区 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Border Width="44" Height="44" CornerRadius="8" Background="#0F0066FF" Margin="0,0,12,0" VerticalAlignment="Center">
                <iconPacks:PackIconMaterial Kind="ShieldAccount" Width="22" Height="22" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="初始化管理员账号"
                           Style="{StaticResource AppPageTitleStyle}"
                           FontSize="16"
                           Margin="0,0,0,4" />
                <TextBlock Text="创建系统首个管理员，以便开始配置系统权限与策略"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           FontSize="11" />
            </StackPanel>
        </DockPanel>

        <!-- 表单与说明条 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
            <StackPanel>
                <!-- 安全提示横幅 -->
                <Border CornerRadius="8" 
                        Background="#0D0066FF" 
                        BorderThickness="1,0,0,0" 
                        BorderBrush="{DynamicResource PrimaryBrush}" 
                        Padding="12" 
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <iconPacks:PackIconMaterial Kind="InformationOutline" 
                                                   Foreground="{DynamicResource PrimaryBrush}" 
                                                   Width="16" 
                                                   Height="16" 
                                                   Margin="0,2,8,0" 
                                                   VerticalAlignment="Top"/>
                        <TextBlock Grid.Column="1" 
                                   Text="当前系统中尚未创建任何管理账号，请在此设定您的首个超级管理员。该用户将自动拥有所有系统及打印管理权限。" 
                                   TextWrapping="Wrap" 
                                   FontSize="12" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   LineHeight="18" />
                    </Grid>
                </Border>

                <!-- 账号输入 -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="用户名" Style="{StaticResource AppFormLabelStyle}" Margin="0,0,0,6" FontWeight="SemiBold" />
                    <TextBox x:Name="UserNameBox" Text="admin" Padding="10,8" hc:InfoElement.Placeholder="请输入管理员用户名" />
                </StackPanel>

                <!-- 显示名输入 -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="显示名 (别名)" Style="{StaticResource AppFormLabelStyle}" Margin="0,0,0,6" FontWeight="SemiBold" />
                    <TextBox x:Name="DisplayNameBox" Text="管理员" Padding="10,8" hc:InfoElement.Placeholder="请输入便于识别的显示姓名" />
                </StackPanel>

                <!-- 密码输入 -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="登录密码" Style="{StaticResource AppFormLabelStyle}" Margin="0,0,0,6" FontWeight="SemiBold" />
                    <PasswordBox x:Name="PasswordBox" Padding="10,8" hc:InfoElement.Placeholder="密码至少包含6位字符" />
                </StackPanel>

                <!-- 确认密码输入 -->
                <StackPanel Margin="0,0,0,6">
                    <TextBlock Text="确认密码" Style="{StaticResource AppFormLabelStyle}" Margin="0,0,0,6" FontWeight="SemiBold" />
                    <PasswordBox x:Name="ConfirmPasswordBox" Padding="10,8" hc:InfoElement.Placeholder="请再次输入密码以确保输入无误" />
                </StackPanel>

                <!-- 错误信息反馈 -->
                <TextBlock x:Name="ErrorText"
                           Foreground="{DynamicResource AppDangerBrush}"
                           FontSize="12"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮区 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Width="100" Style="{StaticResource AppDialogCancelButtonStyle}" Click="Cancel_Click" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="退出" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Width="130" Style="{StaticResource AppDialogPrimaryButtonStyle}" Click="Create_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="AccountCheck" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="创建管理员" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>

    <StackPanel x:Name="ToastHost"
                Width="340"
                Margin="0,34,14,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Panel.ZIndex="1000"
                IsHitTestVisible="False" />
    </Grid>
</hc:Window>
