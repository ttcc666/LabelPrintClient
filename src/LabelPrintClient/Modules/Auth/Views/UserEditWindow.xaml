<hc:Window x:Class="LabelPrintClient.Modules.Auth.Views.UserEditWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
           Title="用户维护"
           Width="420"
           Height="420"
           WindowStartupLocation="CenterOwner"
           ResizeMode="NoResize"
           Background="{DynamicResource SecondaryRegionBrush}"
           Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部标题 -->
        <TextBlock x:Name="TitleText" Grid.Row="0" Style="{StaticResource AppPageTitleStyle}" Text="新增用户" Margin="0,0,0,16" />

        <!-- 主体表单区域 -->
        <StackPanel Grid.Row="1">
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="用户名" Style="{StaticResource AppFormLabelStyle}" Margin="0,0,0,6" FontWeight="SemiBold" />
                <TextBox x:Name="UserNameBox" Padding="10,8" hc:InfoElement.Placeholder="请输入唯一登录账号，例如 zhangsan" />
            </StackPanel>

            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="显示名" Style="{StaticResource AppFormLabelStyle}" Margin="0,0,0,6" FontWeight="SemiBold" />
                <TextBox x:Name="DisplayNameBox" Padding="10,8" hc:InfoElement.Placeholder="请输入便于识别的名字，例如 张三" />
            </StackPanel>

            <StackPanel Margin="0,0,0,14">
                <TextBlock x:Name="PasswordLabel" Text="初始密码" Style="{StaticResource AppFormLabelStyle}" Margin="0,0,0,6" FontWeight="SemiBold" />
                <PasswordBox x:Name="PasswordBox" Padding="10,8" hc:InfoElement.Placeholder="请输入初始登录密码，不少于6位" />
            </StackPanel>

            <CheckBox x:Name="IsEnabledBox" Content="启用该用户" IsChecked="True" VerticalAlignment="Center" />
        </StackPanel>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Width="90" Style="{StaticResource AppDialogPrimaryButtonStyle}" Click="Ok_Click" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Check" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="确定" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Width="90" Style="{StaticResource AppDialogCancelButtonStyle}" Click="Cancel_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="取消" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</hc:Window>
