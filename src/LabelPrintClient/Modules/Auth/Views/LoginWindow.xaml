<hc:Window x:Class="LabelPrintClient.Modules.Auth.Views.LoginWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
           Title="{DynamicResource Auth.LoginTitle}"
           Width="430"
           Height="350"
           WindowStartupLocation="CenterScreen"
           ResizeMode="NoResize"
           Foreground="{DynamicResource PrimaryTextBrush}">
    
    <hc:Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFF2F5FA" Offset="0.0"/>
            <GradientStop Color="#FFFFFFFF" Offset="0.6"/>
            <GradientStop Color="#FFEAF0FB" Offset="1.0"/>
        </LinearGradientBrush>
    </hc:Window.Background>

    <hc:Window.Resources>
        <!-- 登录按钮高级科技感渐变 + 悬浮外发光 -->
        <Style x:Key="LoginPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AppDialogPrimaryButtonStyle}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF4D7FFF" Offset="0"/>
                        <GradientStop Color="#FF0055FF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="1.5" Color="#0055FF" Opacity="0.0" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(Button.Effect).(DropShadowEffect.Opacity)" To="0.35" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetProperty="(Button.Effect).(DropShadowEffect.BlurRadius)" To="10" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(Button.Effect).(DropShadowEffect.Opacity)" To="0.0" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetProperty="(Button.Effect).(DropShadowEffect.BlurRadius)" To="4" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF6692FF" Offset="0"/>
                                <GradientStop Color="#FF1A66FF" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF3366DD" Offset="0"/>
                                <GradientStop Color="#FF0044CC" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 退出按钮圆角与悬浮动画 -->
        <Style x:Key="LoginCancelButtonStyle" TargetType="Button" BasedOn="{StaticResource AppDialogCancelButtonStyle}">
            <Setter Property="Height" Value="36"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0F808080"/>
                    <Setter Property="BorderBrush" Value="#40808080"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </hc:Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部系统 Logo & 标题区 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <Border Width="46" Height="46" CornerRadius="10" Margin="0,0,12,0" VerticalAlignment="Center">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1D0066FF" Offset="0"/>
                        <GradientStop Color="#090066FF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Color="#0066FF" Opacity="0.12" />
                </Border.Effect>
                <iconPacks:PackIconMaterial Kind="Printer" Width="22" Height="22" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource App.Title}"
                           Style="{StaticResource AppPageTitleStyle}"
                           FontSize="17"
                           FontWeight="Bold"
                           Margin="0,0,0,3" />
                <TextBlock Text="{DynamicResource Auth.LoginHint}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           FontSize="11" />
            </StackPanel>
        </DockPanel>

        <!-- 表单区域 -->
        <StackPanel Grid.Row="1">
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="{DynamicResource Auth.UserName}" Style="{StaticResource AppFormLabelStyle}" Margin="0,0,0,6" FontWeight="SemiBold" />
                <TextBox x:Name="UserNameBox" 
                         Padding="10,8" 
                         hc:InfoElement.Placeholder="{DynamicResource Auth.UserNamePlaceholder}" />
            </StackPanel>

            <StackPanel Margin="0,0,0,6">
                <TextBlock Text="{DynamicResource Auth.Password}" Style="{StaticResource AppFormLabelStyle}" Margin="0,0,0,6" FontWeight="SemiBold" />
                <PasswordBox x:Name="PasswordBox" 
                             Padding="10,8" 
                             KeyDown="PasswordBox_KeyDown" 
                             hc:InfoElement.Placeholder="{DynamicResource Auth.PasswordPlaceholder}" />
            </StackPanel>

            <!-- 错误信息反馈 -->
            <TextBlock x:Name="ErrorText"
                       Foreground="{DynamicResource AppDangerBrush}"
                       FontSize="11"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- 底部按钮操作区 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Width="105" Style="{StaticResource LoginCancelButtonStyle}" Click="Cancel_Click" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Common.Exit}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Width="105" Style="{StaticResource LoginPrimaryButtonStyle}" Click="Login_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Login" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Common.Login}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</hc:Window>
