<hc:Window x:Class="LabelPrintClient.Modules.Auth.Views.ResetPasswordWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
           Title="{DynamicResource Account.ResetPasswordTitle}"
           Width="380"
           Height="300"
           WindowStartupLocation="CenterOwner"
           ResizeMode="NoResize"
           Background="{DynamicResource SecondaryRegionBrush}"
           Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部标题 -->
        <TextBlock Grid.Row="0" Style="{StaticResource AppPageTitleStyle}" Text="{DynamicResource Account.ResetUserPasswordTitle}" Margin="0,0,0,16" />

        <!-- 主体区域 -->
        <StackPanel Grid.Row="1">
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="{DynamicResource Account.NewPassword}" Style="{StaticResource AppFormLabelStyle}" Margin="0,0,0,6" FontWeight="SemiBold" />
                <PasswordBox x:Name="PasswordBox" Padding="10,8" hc:InfoElement.Placeholder="{DynamicResource Account.NewPasswordPlaceholder}" />
            </StackPanel>

            <StackPanel Margin="0,0,0,6">
                <TextBlock Text="{DynamicResource Account.ConfirmNewPassword}" Style="{StaticResource AppFormLabelStyle}" Margin="0,0,0,6" FontWeight="SemiBold" />
                <PasswordBox x:Name="ConfirmPasswordBox" Padding="10,8" hc:InfoElement.Placeholder="{DynamicResource Account.ConfirmNewPasswordPlaceholder}" />
            </StackPanel>
        </StackPanel>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Width="90" Style="{StaticResource AppDialogPrimaryButtonStyle}" Click="Ok_Click" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Check" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Common.Ok}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Width="90" Style="{StaticResource AppDialogCancelButtonStyle}" Click="Cancel_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Common.Cancel}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</hc:Window>
