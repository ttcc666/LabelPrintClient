<UserControl x:Class="LabelPrintClient.Modules.Template.Views.TemplateManageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <UserControl.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">

            <Setter Property="Margin" Value="4,0,0,8" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部：页面命令条 -->
        <Border Background="{DynamicResource RegionBrush}" CornerRadius="4" Grid.Row="0" Margin="0,0,0,8" Padding="10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="模板维护" VerticalAlignment="Center" Margin="0,0,20,0" />
                    <TextBlock Text="模式: " VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="RunModeText" VerticalAlignment="Center" FontWeight="SemiBold" />
                </StackPanel>

                <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button  Click="Refresh_Click" Margin="0,0,8,0" >
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="Refresh" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="刷新" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
                    <Button Content="初始化示例数据" Click="SeedDemo_Click" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- 主从三栏：分类 -> 模板 -> 字段 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="450" MinWidth="380" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- 标签分类 -->
            <Grid Grid.Column="0" Margin="0,0,6,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource SectionTitleStyle}" Text="标签分类" />
                <Border Background="{DynamicResource RegionBrush}" CornerRadius="4" Grid.Row="1" Padding="10" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- 分类操作按钮栏 -->
                        <WrapPanel Grid.Row="0" Margin="0,0,0,4">
                            <Button Content="新增分类" Click="AddCategory_Click" Margin="0,0,8,8" />
                            <Button Content="编辑" Click="EditCategory_Click" Margin="0,0,8,8" />
                            <Button  Style="{StaticResource ButtonDanger}" Click="DeleteCategory_Click" Margin="0,0,8,8" >
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="Delete" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="删除" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
                        </WrapPanel>

                        <!-- 分类搜索过滤 -->
                        <WrapPanel Grid.Row="1" Margin="0,0,0,4">
                            <TextBox x:Name="CategorySearchBox"
                                        Width="130"
                                       
                                        Margin="0,0,8,8"
                                        KeyDown="CategorySearchBox_KeyDown" />
                            <Button  Style="{StaticResource ButtonPrimary}" Click="CategoryFilter_Click" Margin="0,0,8,8" >
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="Magnify" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="查询" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
                            <Button  Style="{StaticResource ButtonDanger}" Click="ClearCategoryFilter_Click" Margin="0,0,8,8" >
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="FilterRemoveOutline" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="清空" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
                        </WrapPanel>

                        <DataGrid x:Name="CategoryGrid"
                                     Grid.Row="2"
                                     SelectionChanged="CategoryGrid_SelectionChanged"
                                     AutoGenerateColumns="False"
                                     IsReadOnly="True"
                                     Margin="0"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" MinWidth="120" />
                                <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsEnabled}" Width="56" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="CategoryEmptyText"
                                   Grid.Row="2"
                                   Text="暂无标签分类"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Grid>

            <!-- 拖拽条 1 -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" Margin="2,0" />

            <!-- 标签模板 -->
            <Grid Grid.Column="2" Margin="6,0,6,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource SectionTitleStyle}" Text="标签模板" Margin="4,0,0,0" />
                <Border Background="{DynamicResource RegionBrush}" CornerRadius="4" Grid.Row="1" Padding="10" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- 模板操作按钮栏 -->
                        <WrapPanel Grid.Row="0" Margin="0,0,0,2">
                            <Button Content="新增模板" Click="AddTemplate_Click" Margin="0,0,8,8" />
                            <Button Content="编辑" Click="EditTemplate_Click" Margin="0,0,8,8" />
                            <Button  Style="{StaticResource ButtonDanger}" Click="DeleteTemplate_Click" Margin="0,0,8,8" >
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="Delete" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="删除" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
                        </WrapPanel>

                        <!-- 模板搜索与报表设计 -->
                        <WrapPanel Grid.Row="1" Margin="0,0,0,2">
                            <TextBox x:Name="TemplateSearchBox"
                                        Width="120"
                                       
                                        Margin="0,0,8,8"
                                        KeyDown="TemplateSearchBox_KeyDown" />
                            <Button  Style="{StaticResource ButtonPrimary}" Click="TemplateFilter_Click" Margin="0,0,8,8" >
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="Magnify" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="查询" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
                            <Button  Style="{StaticResource ButtonDanger}" Click="ClearTemplateFilter_Click" Margin="0,0,8,8" >
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="FilterRemoveOutline" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="清空" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
                            <Button Content="上传 .mrt" Click="UploadTemplate_Click" Margin="0,0,8,8" />
                            <Button Content="设计器" Click="DesignTemplate_Click" Margin="0,0,8,8" />
                        </WrapPanel>

                        <DataGrid x:Name="TemplateGrid"
                                     Grid.Row="2"
                                     SelectionChanged="TemplateGrid_SelectionChanged"
                                     AutoGenerateColumns="False"
                                     IsReadOnly="True"
                                     Margin="0"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="130" />
                                <DataGridTextColumn Header="存储" Binding="{Binding StorageType}" Width="70" />
                                <DataGridTextColumn Header="文件" Binding="{Binding TemplateFileName}" Width="*" MinWidth="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="TemplateEmptyText"
                                   Grid.Row="2"
                                   Text="请选择分类查看模板"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="Collapsed" />

                        <Border Grid.Row="3" Padding="0,8,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="每页" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ComboBox x:Name="TemplatePageSizeBox" Width="68" SelectedIndex="1" SelectionChanged="TemplatePageSizeBox_SelectionChanged" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <ComboBoxItem Content="10" />
                                    <ComboBoxItem Content="20" />
                                    <ComboBoxItem Content="50" />
                                </ComboBox>
                                <Button x:Name="TemplateFirstPageButton" Content="&lt;&lt;" Style="{StaticResource PagerButtonStyle}" Click="TemplateFirstPage_Click" />
                                <Button x:Name="TemplatePrevPageButton" Content="&lt;" Style="{StaticResource PagerButtonStyle}" Click="TemplatePrevPage_Click" />
                                <TextBlock x:Name="TemplatePageInfoText" VerticalAlignment="Center" MinWidth="70" TextAlignment="Center" FontWeight="SemiBold" />
                                <Button x:Name="TemplateNextPageButton" Content="&gt;" Style="{StaticResource PagerButtonStyle}" Click="TemplateNextPage_Click" />
                                <Button x:Name="TemplateLastPageButton" Content="&gt;&gt;" Style="{StaticResource PagerButtonStyle}" Click="TemplateLastPage_Click" />
                            </StackPanel>
                        </Border>

                    </Grid>
                </Border>
            </Grid>

            <!-- 拖拽条 2 -->
            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" Margin="2,0" />

            <!-- 模板字段 -->
            <Grid Grid.Column="4" Margin="6,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource SectionTitleStyle}" Text="模板字段" />
                <Border Background="{DynamicResource RegionBrush}" CornerRadius="4" Grid.Row="1" Padding="10" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 字段操作与搜索面板 -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,2">
                            <!-- 字段操作按钮栏 -->
                            <WrapPanel Margin="0,0,0,2">
                                <Button Content="新增字段" Click="AddField_Click" Margin="0,0,8,8" />
                                <Button Content="编辑" Click="EditField_Click" Margin="0,0,8,8" />
                                <Button  Style="{StaticResource ButtonDanger}" Click="DeleteField_Click" Margin="0,0,8,8" >
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="Delete" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="删除" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
                                <Button Content="上移" Click="MoveFieldUp_Click" Margin="0,0,8,8" />
                                <Button Content="下移" Click="MoveFieldDown_Click" Margin="0,0,8,8" />
                            </WrapPanel>

                            <!-- 字段搜索过滤 -->
                            <WrapPanel Margin="0,0,0,2">
                                <TextBox x:Name="FieldSearchBox"
                                            Width="140"
                                           
                                            Margin="0,0,8,8"
                                            KeyDown="FieldSearchBox_KeyDown" />
                                <Button  Style="{StaticResource ButtonPrimary}" Click="FieldFilter_Click" Margin="0,0,8,8" >
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="Magnify" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="查询" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
                                <Button  Style="{StaticResource ButtonDanger}" Click="ClearFieldFilter_Click" Margin="0,0,8,8" >
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="FilterRemoveOutline" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="清空" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
                            </WrapPanel>
                        </StackPanel>

                        <DataGrid x:Name="FieldGrid"
                                     Grid.Row="1"
                                     AutoGenerateColumns="False"
                                     IsReadOnly="True"
                                     SelectionChanged="FieldGrid_SelectionChanged"
                                     Margin="0"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="排序" Binding="{Binding Sort}" Width="52" />
                                <DataGridTextColumn Header="字段名" Binding="{Binding FieldName}" Width="110" />
                                <DataGridTextColumn Header="字段编码" Binding="{Binding FieldCode}" Width="120" />
                                <DataGridTextColumn Header="类型" Binding="{Binding FieldTypeCn}" Width="70" />
                                <DataGridCheckBoxColumn Header="必填" Binding="{Binding IsRequired}" Width="56" />
                                <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="*" MinWidth="140" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="FieldEmptyText"
                                   Grid.Row="1"
                                   Text="请选择模板查看字段"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>





