<UserControl x:Class="LabelPrintClient.Modules.Template.Views.TemplateManageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <UserControl.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource AppSectionTitleStyle}" />
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部：页面命令条 -->
        <Border Grid.Row="0" Style="{StaticResource AppToolbarCardStyle}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource AppPageTitleStyle}" Text="模板维护" Margin="0,0,20,0" />
                    <TextBlock Text="模式: " VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="RunModeText" VerticalAlignment="Center" FontWeight="SemiBold" />
                </StackPanel>

                <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button  Style="{StaticResource AppSecondaryButtonStyle}" Click="Refresh_Click" Margin="0,0,8,0" >
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="Refresh" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="刷新" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
                    <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="SeedDemo_Click">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="DatabasePlusOutline" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="初始化示例数据" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- 主从三栏：分类 -> 模板 -> 字段 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="450" MinWidth="380" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- 标签分类 -->
            <Grid Grid.Column="0" Margin="0,0,6,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource SectionTitleStyle}" Text="标签分类" />
                <Border Grid.Row="1" Style="{StaticResource AppCardStyle}" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- 分类操作按钮栏 -->
                        <WrapPanel Grid.Row="0" Margin="0,0,0,4">
                            <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="AddCategory_Click" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="PlusCircleOutline" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="新增分类" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="EditCategory_Click" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="PencilOutline" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="编辑" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource AppDangerButtonStyle}" Click="DeleteCategory_Click" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="TrashCanOutline" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="删除" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <!-- 分类搜索过滤 -->
                        <WrapPanel Grid.Row="1" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,8">
                                <TextBlock Style="{StaticResource AppFormLabelStyle}" Text="关键词" />
                                <TextBox x:Name="CategorySearchBox"
                                        Width="130"
                                        VerticalAlignment="Center"
                                        KeyDown="CategorySearchBox_KeyDown" />
                            </StackPanel>
                            <Button  Style="{StaticResource AppSecondaryButtonStyle}" Click="CategoryFilter_Click" Margin="0,0,8,8" >
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="Magnify" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="查询" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
                            <Button  Style="{StaticResource AppGhostButtonStyle}" Click="ClearCategoryFilter_Click" Margin="0,0,8,8" >
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="FilterRemoveOutline" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="清空" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
                        </WrapPanel>

                        <DataGrid x:Name="CategoryGrid"
                                     Grid.Row="2"
                                     SelectionChanged="CategoryGrid_SelectionChanged"
                                     AutoGenerateColumns="False"
                                     IsReadOnly="True"
                                     Margin="0"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" MinWidth="120" />
                                <DataGridCheckBoxColumn Header="启用"
                                                        Binding="{Binding IsEnabled}"
                                                        Width="56"
                                                        CellStyle="{StaticResource AppDataGridCenterCellStyle}"
                                                        HeaderStyle="{StaticResource AppDataGridCenterColumnHeaderStyle}"
                                                        ElementStyle="{StaticResource AppDataGridReadOnlyCheckBoxStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="2"
                                    Style="{StaticResource AppDataGridEmptyStatePanelStyle}"
                                    Visibility="{Binding Visibility, ElementName=CategoryEmptyText}">
                            <Border Style="{StaticResource AppEmptyStateIconFrameStyle}">
                                <iconPacks:PackIconMaterial Kind="PencilBoxOutline" Style="{StaticResource AppEmptyStateIconStyle}" />
                            </Border>
                            <TextBlock x:Name="CategoryEmptyText"
                                       Text="暂无标签分类"
                                       Style="{StaticResource AppEmptyStateTitleStyle}"
                                       Visibility="Collapsed" />
                            <TextBlock Text="点击新增分类，先建立标签模板的业务分组。"
                                       Style="{StaticResource AppEmptyStateHintStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- 拖拽条 1 -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" Margin="2,0" />

            <!-- 标签模板 -->
            <Grid Grid.Column="2" Margin="6,0,6,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource SectionTitleStyle}" Text="标签模板" Margin="4,0,0,0" />
                <Border Grid.Row="1" Style="{StaticResource AppCardStyle}" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- 模板操作按钮栏 -->
                        <WrapPanel Grid.Row="0" Margin="0,0,0,2">
                            <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="AddTemplate_Click" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="PlusCircleOutline" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="新增模板" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="EditTemplate_Click" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="PencilOutline" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="编辑" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource AppDangerButtonStyle}" Click="DeleteTemplate_Click" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="TrashCanOutline" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="删除" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <!-- 模板搜索与报表设计 -->
                        <WrapPanel Grid.Row="1" Margin="0,0,0,2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,8">
                                <TextBlock Style="{StaticResource AppFormLabelStyle}" Text="关键词" />
                                <TextBox x:Name="TemplateSearchBox"
                                        Width="120"
                                        VerticalAlignment="Center"
                                        KeyDown="TemplateSearchBox_KeyDown" />
                            </StackPanel>
                            <Button  Style="{StaticResource AppSecondaryButtonStyle}" Click="TemplateFilter_Click" Margin="0,0,8,8" >
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="Magnify" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="查询" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
                            <Button  Style="{StaticResource AppGhostButtonStyle}" Click="ClearTemplateFilter_Click" Margin="0,0,8,8" >
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="FilterRemoveOutline" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="清空" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
                            <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="UploadTemplate_Click" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="CloudUploadOutline" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="上传 .mrt" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="DesignTemplate_Click" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="PaletteOutline" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="设计器" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <DataGrid x:Name="TemplateGrid"
                                     Grid.Row="2"
                                     SelectionChanged="TemplateGrid_SelectionChanged"
                                     AutoGenerateColumns="False"
                                     IsReadOnly="True"
                                     Margin="0"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="130" />
                                <DataGridTextColumn Header="存储" Binding="{Binding StorageType}" Width="70" />
                                <DataGridTextColumn Header="文件" Binding="{Binding TemplateFileName}" Width="*" MinWidth="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="2"
                                    Style="{StaticResource AppDataGridEmptyStatePanelStyle}"
                                    Visibility="{Binding Visibility, ElementName=TemplateEmptyText}">
                            <Border Style="{StaticResource AppEmptyStateIconFrameStyle}">
                                <iconPacks:PackIconMaterial Kind="PencilBoxOutline" Style="{StaticResource AppEmptyStateIconStyle}" />
                            </Border>
                            <TextBlock x:Name="TemplateEmptyText"
                                       Text="请选择分类查看模板"
                                       Style="{StaticResource AppEmptyStateTitleStyle}"
                                       Visibility="Collapsed" />
                            <TextBlock Text="选择分类后可新增模板、上传 .mrt 或打开设计器。"
                                       Style="{StaticResource AppEmptyStateHintStyle}" />
                        </StackPanel>

                        <Border Grid.Row="3" Padding="0,8,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="每页" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ComboBox x:Name="TemplatePageSizeBox" Width="68" SelectedIndex="1" SelectionChanged="TemplatePageSizeBox_SelectionChanged" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <ComboBoxItem Content="10" />
                                    <ComboBoxItem Content="20" />
                                    <ComboBoxItem Content="50" />
                                </ComboBox>
                                <Button x:Name="TemplateFirstPageButton" Style="{StaticResource PagerButtonStyle}" Click="TemplateFirstPage_Click">
                                    <iconPacks:PackIconMaterial Kind="PageFirst" Width="16" Height="16" />
                                </Button>
                                <Button x:Name="TemplatePrevPageButton" Style="{StaticResource PagerButtonStyle}" Click="TemplatePrevPage_Click">
                                    <iconPacks:PackIconMaterial Kind="ChevronLeft" Width="16" Height="16" />
                                </Button>
                                <TextBlock x:Name="TemplatePageInfoText" VerticalAlignment="Center" MinWidth="70" TextAlignment="Center" FontWeight="SemiBold" />
                                <Button x:Name="TemplateNextPageButton" Style="{StaticResource PagerButtonStyle}" Click="TemplateNextPage_Click">
                                    <iconPacks:PackIconMaterial Kind="ChevronRight" Width="16" Height="16" />
                                </Button>
                                <Button x:Name="TemplateLastPageButton" Style="{StaticResource PagerButtonStyle}" Click="TemplateLastPage_Click">
                                    <iconPacks:PackIconMaterial Kind="PageLast" Width="16" Height="16" />
                                </Button>
                            </StackPanel>
                        </Border>

                    </Grid>
                </Border>
            </Grid>

            <!-- 拖拽条 2 -->
            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" Margin="2,0" />

            <!-- 模板字段 -->
            <Grid Grid.Column="4" Margin="6,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource SectionTitleStyle}" Text="模板字段" />
                <Border Grid.Row="1" Style="{StaticResource AppCardStyle}" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 字段操作与搜索面板 -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,2">
                            <!-- 字段操作按钮栏 -->
                            <WrapPanel Margin="0,0,0,2">
                                <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="AddField_Click" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="PlusCircleOutline" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="新增字段" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="EditField_Click" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="PencilOutline" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="编辑" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource AppDangerButtonStyle}" Click="DeleteField_Click" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="TrashCanOutline" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="删除" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="FieldHistory_Click" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="History" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="字段履历" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource AppGhostButtonStyle}" Click="MoveFieldUp_Click" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="ChevronLeft" Margin="0,0,6,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                            <iconPacks:PackIconMaterial.RenderTransform>
                                                <RotateTransform Angle="90"/>
                                            </iconPacks:PackIconMaterial.RenderTransform>
                                        </iconPacks:PackIconMaterial>
                                        <TextBlock Text="上移" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource AppGhostButtonStyle}" Click="MoveFieldDown_Click" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="ChevronLeft" Margin="0,0,6,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                            <iconPacks:PackIconMaterial.RenderTransform>
                                                <RotateTransform Angle="-90"/>
                                            </iconPacks:PackIconMaterial.RenderTransform>
                                        </iconPacks:PackIconMaterial>
                                        <TextBlock Text="下移" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>

                            <!-- 字段搜索过滤 -->
                            <WrapPanel Margin="0,0,0,2">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,8">
                                    <TextBlock Style="{StaticResource AppFormLabelStyle}" Text="关键词" />
                                    <TextBox x:Name="FieldSearchBox"
                                            Width="140"
                                            VerticalAlignment="Center"
                                            KeyDown="FieldSearchBox_KeyDown" />
                                </StackPanel>
                                <Button  Style="{StaticResource AppSecondaryButtonStyle}" Click="FieldFilter_Click" Margin="0,0,8,8" >
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="Magnify" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="查询" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
                                <Button  Style="{StaticResource AppGhostButtonStyle}" Click="ClearFieldFilter_Click" Margin="0,0,8,8" >
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="FilterRemoveOutline" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="清空" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
                            </WrapPanel>
                        </StackPanel>

                        <DataGrid x:Name="FieldGrid"
                                     Grid.Row="1"
                                     AutoGenerateColumns="False"
                                     IsReadOnly="True"
                                     SelectionChanged="FieldGrid_SelectionChanged"
                                     Margin="0"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="排序" Binding="{Binding Sort}" Width="52" />
                                <DataGridTextColumn Header="字段名" Binding="{Binding FieldName}" Width="110" />
                                <DataGridTextColumn Header="字段编码" Binding="{Binding FieldCode}" Width="120" />
                                <DataGridTextColumn Header="类型" Binding="{Binding FieldTypeCn}" Width="70" />
                                <DataGridCheckBoxColumn Header="必填"
                                                        Binding="{Binding IsRequired}"
                                                        Width="56"
                                                        CellStyle="{StaticResource AppDataGridCenterCellStyle}"
                                                        HeaderStyle="{StaticResource AppDataGridCenterColumnHeaderStyle}"
                                                        ElementStyle="{StaticResource AppDataGridReadOnlyCheckBoxStyle}" />
                                <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="*" MinWidth="140" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="1"
                                    Style="{StaticResource AppDataGridEmptyStatePanelStyle}"
                                    Visibility="{Binding Visibility, ElementName=FieldEmptyText}">
                            <Border Style="{StaticResource AppEmptyStateIconFrameStyle}">
                                <iconPacks:PackIconMaterial Kind="FormatListText" Style="{StaticResource AppEmptyStateIconStyle}" />
                            </Border>
                            <TextBlock x:Name="FieldEmptyText"
                                       Text="请选择模板查看字段"
                                       Style="{StaticResource AppEmptyStateTitleStyle}"
                                       Visibility="Collapsed" />
                            <TextBlock Text="字段会作为 Excel 表头和报表数据源，请按打印内容维护。"
                                       Style="{StaticResource AppEmptyStateHintStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>





