<UserControl x:Class="LabelPrintClient.Modules.Template.Views.TemplateManageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <UserControl.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource AppSectionTitleStyle}" />

        <!-- 字段必填属性胶囊 Badge 模板 -->
        <DataTemplate x:Key="FieldRequiredBadgeTemplate">
            <Border x:Name="BadgeBorder" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8,3" Background="#12708090">
                <TextBlock x:Name="BadgeText" Text="选填" FontSize="11" Foreground="SlateGray" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsRequired}" Value="True">
                    <Setter TargetName="BadgeBorder" Property="Background" Value="#12E81123" />
                    <Setter TargetName="BadgeText" Property="Text" Value="必填" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="#E81123" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 字段类型属性胶囊 Badge 模板 -->
        <DataTemplate x:Key="FieldTypeBadgeTemplate">
            <Border x:Name="BadgeBorder" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8,3" Background="#120066FF">
                <TextBlock x:Name="BadgeText" Text="{Binding FieldTypeCn}" FontSize="11" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding FieldType}" Value="Number">
                    <Setter TargetName="BadgeBorder" Property="Background" Value="#1200CC66" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="#00CC66" />
                </DataTrigger>
                <DataTrigger Binding="{Binding FieldType}" Value="DateTime">
                    <Setter TargetName="BadgeBorder" Property="Background" Value="#128A2BE2" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="#8A2BE2" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 分类启用状态 Badge 模板 -->
        <DataTemplate x:Key="CategoryStatusBadgeTemplate">
            <Border x:Name="BadgeBorder" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8,3" Background="#12708090">
                <TextBlock x:Name="BadgeText" Text="禁用" FontSize="11" Foreground="SlateGray" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                    <Setter TargetName="BadgeBorder" Property="Background" Value="#1234C759" />
                    <Setter TargetName="BadgeText" Property="Text" Value="启用" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="#34C759" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部：页面命令条 -->
        <Border Grid.Row="0" Style="{StaticResource AppToolbarCardStyle}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource AppPageTitleStyle}" Text="模板维护" Margin="0,0,20,0" />
                    <TextBlock Text="模式: " VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="RunModeText" VerticalAlignment="Center" FontWeight="SemiBold" />
                </StackPanel>

                <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button  Style="{StaticResource AppSecondaryButtonStyle}" Click="Refresh_Click" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Refresh" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="刷新" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="SeedDemo_Click">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="DatabasePlusOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="初始化示例数据" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- 主从三栏大网格 (采用大Grid行级轨道物理对齐，确保所有表格与卡片在同一水平线) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1*" MinWidth="380" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="3*" MinWidth="380" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- 行 0：标题栏 -->
                <RowDefinition Height="Auto" /> <!-- 行 1：按钮控制与过滤面板 (自动对齐最高高度) -->
                <RowDefinition Height="*" />    <!-- 行 2：表格数据卡片栏 (顶端100%在同一水平线) -->
            </Grid.RowDefinitions>

            <!-- ================= 第一栏：标签分类 ================= -->
            <!-- 标题 -->
            <TextBlock Grid.Column="0" Grid.Row="0" Style="{StaticResource SectionTitleStyle}" Text="标签分类" Margin="0,0,0,6" />
            
            <!-- 按钮控制面板 -->
            <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,6,8" VerticalAlignment="Top">
                <!-- 分类操作按钮 -->
                <WrapPanel Margin="0,0,0,4">
                    <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="AddCategory_Click" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="PlusCircleOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="新增分类" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="EditCategory_Click" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="PencilOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="编辑" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppDangerButtonStyle}" Click="DeleteCategory_Click" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="TrashCanOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="删除" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <!-- 分类搜索过滤 -->
                <WrapPanel Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,8">
                        <TextBlock Style="{StaticResource AppFormLabelStyle}" Text="关键词" />
                        <TextBox x:Name="CategorySearchBox" Width="130" VerticalAlignment="Center" KeyDown="CategorySearchBox_KeyDown" />
                    </StackPanel>
                    <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="CategoryFilter_Click" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Magnify" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="查询" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppGhostButtonStyle}" Click="ClearCategoryFilter_Click" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="FilterRemoveOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="清空" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>

            <!-- 表格卡片 (顶端绝对齐平) -->
            <Border Grid.Column="0" Grid.Row="2" Margin="0,0,6,0" Style="{StaticResource AppCardStyle}" VerticalAlignment="Stretch">
                <Grid>
                    <DataGrid x:Name="CategoryGrid"
                              SelectionChanged="CategoryGrid_SelectionChanged"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Margin="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" MinWidth="120" ElementStyle="{StaticResource AppDataGridTextColumnElementStyle}" />
                            <DataGridTemplateColumn Header="状态"
                                                    Width="76"
                                                    CellStyle="{StaticResource AppDataGridCenterCellStyle}"
                                                    HeaderStyle="{StaticResource AppDataGridCenterColumnHeaderStyle}"
                                                    SortMemberPath="IsEnabled">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CategoryStatusBadgeTemplate}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Style="{StaticResource AppDataGridEmptyStatePanelStyle}"
                                Visibility="{Binding Visibility, ElementName=CategoryEmptyText}">
                        <Border Style="{StaticResource AppEmptyStateIconFrameStyle}">
                            <iconPacks:PackIconMaterial Kind="PencilBoxOutline" Style="{StaticResource AppEmptyStateIconStyle}" />
                        </Border>
                        <TextBlock x:Name="CategoryEmptyText" Text="暂无标签分类" Style="{StaticResource AppEmptyStateTitleStyle}" Visibility="Collapsed" />
                        <TextBlock Text="点击新增分类，先建立标签模板的业务分组。" Style="{StaticResource AppEmptyStateHintStyle}" />
                    </StackPanel>
                </Grid>
            </Border>


            <!-- 拖拽条 1 -->
            <GridSplitter Grid.Column="1" Grid.Row="0" Grid.RowSpan="3" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" Margin="2,0" />


            <!-- ================= 第二栏：标签模板 ================= -->
            <!-- 标题 -->
            <TextBlock Grid.Column="2" Grid.Row="0" Style="{StaticResource SectionTitleStyle}" Text="标签模板" Margin="6,0,0,6" />
            
            <!-- 按钮控制面板 -->
            <StackPanel Grid.Column="2" Grid.Row="1" Margin="6,0,6,8" VerticalAlignment="Top">
                <!-- 模板操作按钮 -->
                <WrapPanel Margin="0,0,0,2">
                    <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="AddTemplate_Click" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="PlusCircleOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="新增模板" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="EditTemplate_Click" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="PencilOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="编辑" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppDangerButtonStyle}" Click="DeleteTemplate_Click" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="TrashCanOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="删除" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="UploadTemplate_Click" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="CloudUploadOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="上传 .mrt" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="DesignTemplate_Click" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="PaletteOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="设计器" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <!-- 模板搜索过滤 -->
                <WrapPanel Margin="0,0,0,2">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,8">
                        <TextBlock Style="{StaticResource AppFormLabelStyle}" Text="关键词" />
                        <TextBox x:Name="TemplateSearchBox" Width="120" VerticalAlignment="Center" KeyDown="TemplateSearchBox_KeyDown" />
                    </StackPanel>
                    <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="TemplateFilter_Click" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Magnify" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="查询" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppGhostButtonStyle}" Click="ClearTemplateFilter_Click" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="FilterRemoveOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="清空" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>

            <!-- 表格卡片 (顶端绝对齐平) -->
            <Border Grid.Column="2" Grid.Row="2" Margin="6,0,6,0" Style="{StaticResource AppCardStyle}" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <DataGrid x:Name="TemplateGrid"
                              Grid.Row="0"
                              SelectionChanged="TemplateGrid_SelectionChanged"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Margin="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="130" ElementStyle="{StaticResource AppDataGridTextColumnElementStyle}" />
                            <!-- 存储介质 Badge 胶囊列 -->
                            <DataGridTemplateColumn Header="存储" Width="96">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="BadgeBorder" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8,3" Background="#12FF5722">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconMaterial x:Name="BadgeIcon" Kind="Folder" Foreground="#FF5722" Width="11" Height="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                <TextBlock x:Name="BadgeText" Text="本地物理" FontSize="11" Foreground="#FF5722" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding StorageType}" Value="Database">
                                                <Setter TargetName="BadgeBorder" Property="Background" Value="#120066FF" />
                                                <Setter TargetName="BadgeIcon" Property="Kind" Value="Database" />
                                                <Setter TargetName="BadgeIcon" Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                                <Setter TargetName="BadgeText" Property="Text" Value="数据库" />
                                                <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="文件" Binding="{Binding TemplateFileName}" Width="*" MinWidth="120" ElementStyle="{StaticResource AppDataGridTextColumnElementStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="0"
                                Style="{StaticResource AppDataGridEmptyStatePanelStyle}"
                                Visibility="{Binding Visibility, ElementName=TemplateEmptyText}">
                        <Border Style="{StaticResource AppEmptyStateIconFrameStyle}">
                            <iconPacks:PackIconMaterial Kind="PencilBoxOutline" Style="{StaticResource AppEmptyStateIconStyle}" />
                        </Border>
                        <TextBlock x:Name="TemplateEmptyText" Text="请选择分类查看模板" Style="{StaticResource AppEmptyStateTitleStyle}" Visibility="Collapsed" />
                        <TextBlock Text="选择分类后可新增模板、上传 .mrt 或打开设计器。" Style="{StaticResource AppEmptyStateHintStyle}" />
                    </StackPanel>

                    <!-- 分页栏 -->
                    <Border Grid.Row="1" Padding="0,8,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="每页" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ComboBox x:Name="TemplatePageSizeBox" Width="68" SelectedIndex="1" SelectionChanged="TemplatePageSizeBox_SelectionChanged" Margin="0,0,16,0" VerticalAlignment="Center">
                                <ComboBoxItem Content="10" />
                                <ComboBoxItem Content="20" />
                                <ComboBoxItem Content="50" />
                            </ComboBox>
                            <Button x:Name="TemplateFirstPageButton" Style="{StaticResource PagerButtonStyle}" Click="TemplateFirstPage_Click">
                                <iconPacks:PackIconMaterial Kind="PageFirst" Width="16" Height="16" />
                            </Button>
                            <Button x:Name="TemplatePrevPageButton" Style="{StaticResource PagerButtonStyle}" Click="TemplatePrevPage_Click">
                                <iconPacks:PackIconMaterial Kind="ChevronLeft" Width="16" Height="16" />
                            </Button>
                            <TextBlock x:Name="TemplatePageInfoText" VerticalAlignment="Center" MinWidth="70" TextAlignment="Center" FontWeight="SemiBold" />
                            <Button x:Name="TemplateNextPageButton" Style="{StaticResource PagerButtonStyle}" Click="TemplateNextPage_Click">
                                <iconPacks:PackIconMaterial Kind="ChevronRight" Width="16" Height="16" />
                            </Button>
                            <Button x:Name="TemplateLastPageButton" Style="{StaticResource PagerButtonStyle}" Click="TemplateLastPage_Click">
                                <iconPacks:PackIconMaterial Kind="PageLast" Width="16" Height="16" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>


            <!-- 拖拽条 2 -->
            <GridSplitter Grid.Column="3" Grid.Row="0" Grid.RowSpan="3" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" Margin="2,0" />


            <!-- ================= 第三栏：模板字段 ================= -->
            <!-- 标题 -->
            <TextBlock Grid.Column="4" Grid.Row="0" Style="{StaticResource SectionTitleStyle}" Text="模板字段" Margin="6,0,0,6" />
            
            <!-- 按钮控制面板 -->
            <StackPanel Grid.Column="4" Grid.Row="1" Margin="6,0,0,8" VerticalAlignment="Top">
                <!-- 字段操作按钮 -->
                <WrapPanel Margin="0,0,0,2">
                    <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="AddField_Click" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="PlusCircleOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="新增字段" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="EditField_Click" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="PencilOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="编辑" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppDangerButtonStyle}" Click="DeleteField_Click" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="TrashCanOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="删除" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="FieldHistory_Click" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="History" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="字段履历" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppGhostButtonStyle}" Click="MoveFieldUp_Click" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ChevronLeft" Margin="0,0,6,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <iconPacks:PackIconMaterial.RenderTransform>
                                    <RotateTransform Angle="90" />
                                </iconPacks:PackIconMaterial.RenderTransform>
                            </iconPacks:PackIconMaterial>
                            <TextBlock Text="上移" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppGhostButtonStyle}" Click="MoveFieldDown_Click" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ChevronLeft" Margin="0,0,6,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <iconPacks:PackIconMaterial.RenderTransform>
                                    <RotateTransform Angle="-90" />
                                </iconPacks:PackIconMaterial.RenderTransform>
                            </iconPacks:PackIconMaterial>
                            <TextBlock Text="下移" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <!-- 字段搜索过滤 -->
                <WrapPanel Margin="0,0,0,2">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,8">
                        <TextBlock Style="{StaticResource AppFormLabelStyle}" Text="关键词" />
                        <TextBox x:Name="FieldSearchBox" Width="140" VerticalAlignment="Center" KeyDown="FieldSearchBox_KeyDown" />
                    </StackPanel>
                    <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="FieldFilter_Click" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Magnify" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="查询" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppGhostButtonStyle}" Click="ClearFieldFilter_Click" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="FilterRemoveOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="清空" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>

            <!-- 表格卡片 (顶端绝对齐平) -->
            <Border Grid.Column="4" Grid.Row="2" Margin="6,0,0,0" Style="{StaticResource AppCardStyle}" VerticalAlignment="Stretch">
                <Grid>
                    <DataGrid x:Name="FieldGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionChanged="FieldGrid_SelectionChanged"
                              Margin="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="排序" Binding="{Binding Sort}" Width="52" ElementStyle="{StaticResource AppDataGridTextColumnElementStyle}" />
                            <DataGridTextColumn Header="字段名" Binding="{Binding FieldName}" Width="110" ElementStyle="{StaticResource AppDataGridTextColumnElementStyle}" />
                            <DataGridTextColumn Header="字段编码" Binding="{Binding FieldCode}" Width="120" ElementStyle="{StaticResource AppDataGridTextColumnElementStyle}" />
                            <!-- 字段数据类型 Badge 胶囊列 -->
                            <DataGridTemplateColumn Header="类型" Width="76">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldTypeBadgeTemplate}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 字段必填属性 Badge 胶囊列 -->
                            <DataGridTemplateColumn Header="必填" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldRequiredBadgeTemplate}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="校验规则" Binding="{Binding ValidationRuleSummary}" Width="160" ElementStyle="{StaticResource AppDataGridTextColumnElementStyle}" />
                            <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="*" MinWidth="140" ElementStyle="{StaticResource AppDataGridTextColumnElementStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Style="{StaticResource AppDataGridEmptyStatePanelStyle}"
                                Visibility="{Binding Visibility, ElementName=FieldEmptyText}">
                        <Border Style="{StaticResource AppEmptyStateIconFrameStyle}">
                            <iconPacks:PackIconMaterial Kind="FormatListText" Style="{StaticResource AppEmptyStateIconStyle}" />
                        </Border>
                        <TextBlock x:Name="FieldEmptyText" Text="请选择模板查看字段" Style="{StaticResource AppEmptyStateTitleStyle}" Visibility="Collapsed" />
                        <TextBlock Text="字段会作为 Excel 表头和报表数据源，请按打印内容维护。" Style="{StaticResource AppEmptyStateHintStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
