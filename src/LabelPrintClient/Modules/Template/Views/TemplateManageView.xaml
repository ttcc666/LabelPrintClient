<UserControl x:Class="LabelPrintClient.Modules.Template.Views.TemplateManageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:auth="clr-namespace:LabelPrintClient.Modules.Auth.Infrastructure"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <UserControl.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource AppSectionTitleStyle}" />

        <!-- 字段必填属性胶囊 Badge 模板 -->
        <DataTemplate x:Key="FieldRequiredBadgeTemplate">
            <Border x:Name="BadgeBorder" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8,3" Background="#12708090">
                <TextBlock x:Name="BadgeText" Text="{DynamicResource Template.Optional}" FontSize="11" Foreground="SlateGray" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsRequired}" Value="True">
                    <Setter TargetName="BadgeBorder" Property="Background" Value="#12E81123" />
                    <Setter TargetName="BadgeText" Property="Text" Value="{DynamicResource Template.Required}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="#E81123" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 字段类型属性胶囊 Badge 模板 -->
        <DataTemplate x:Key="FieldTypeBadgeTemplate">
            <Border x:Name="BadgeBorder" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8,3" Background="#120066FF">
                <TextBlock x:Name="BadgeText" Text="{Binding FieldTypeCn}" FontSize="11" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding FieldType}" Value="int">
                    <Setter TargetName="BadgeBorder" Property="Background" Value="#1200CC66" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="#00CC66" />
                </DataTrigger>
                <DataTrigger Binding="{Binding FieldType}" Value="decimal">
                    <Setter TargetName="BadgeBorder" Property="Background" Value="#1200CC66" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="#00CC66" />
                </DataTrigger>
                <DataTrigger Binding="{Binding FieldType}" Value="date">
                    <Setter TargetName="BadgeBorder" Property="Background" Value="#128A2BE2" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="#8A2BE2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding FieldType}" Value="bool">
                    <Setter TargetName="BadgeBorder" Property="Background" Value="#12FF9900" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="#FF9900" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 分类启用状态 Badge 模板 -->
        <DataTemplate x:Key="CategoryStatusBadgeTemplate">
            <Border x:Name="BadgeBorder" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8,3" Background="#12708090">
                <TextBlock x:Name="BadgeText" Text="{DynamicResource Common.Disabled}" FontSize="11" Foreground="SlateGray" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                    <Setter TargetName="BadgeBorder" Property="Background" Value="#1234C759" />
                    <Setter TargetName="BadgeText" Property="Text" Value="{DynamicResource Common.Enabled}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="#34C759" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 模板打印模式胶囊 Badge 模板 -->
        <DataTemplate x:Key="TemplateModeBadgeTemplate">
            <Border x:Name="BadgeBorder" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8,3" Background="#12708090" BorderBrush="#40708090" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial x:Name="BadgeIcon" Kind="FileOutline" Foreground="SlateGray" Width="11" Height="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="BadgeText" Text="{DynamicResource Template.Normal}" FontSize="11" Foreground="SlateGray" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding TemplateMode}" Value="Batch">
                    <Setter TargetName="BadgeBorder" Property="Background" Value="#1216803C" />
                    <Setter TargetName="BadgeBorder" Property="BorderBrush" Value="#4016803C" />
                    <Setter TargetName="BadgeIcon" Property="Kind" Value="LayersOutline" />
                    <Setter TargetName="BadgeIcon" Property="Foreground" Value="#16803C" />
                    <Setter TargetName="BadgeText" Property="Text" Value="{DynamicResource Template.Batch}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="#16803C" />
                </DataTrigger>
                <DataTrigger Binding="{Binding TemplateMode}" Value="Serialized">
                    <Setter TargetName="BadgeBorder" Property="Background" Value="#127C3AED" />
                    <Setter TargetName="BadgeBorder" Property="BorderBrush" Value="#407C3AED" />
                    <Setter TargetName="BadgeIcon" Property="Kind" Value="Numeric" />
                    <Setter TargetName="BadgeIcon" Property="Foreground" Value="#7C3AED" />
                    <Setter TargetName="BadgeText" Property="Text" Value="{DynamicResource Template.Serialized}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="#7C3AED" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部：页面命令条 -->
        <Border Grid.Row="0" Style="{StaticResource AppToolbarCardStyle}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource AppPageTitleStyle}" Text="{DynamicResource Template.Title}" Margin="0,0,20,0" />
                    <TextBlock Text="{DynamicResource Template.ModeLabel}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="RunModeText" VerticalAlignment="Center" FontWeight="SemiBold" />
                </StackPanel>

                <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button  Style="{StaticResource AppSecondaryButtonStyle}" Click="Refresh_Click" Margin="0,0,8,0" auth:PermissionAssist.PermissionKey="Button.Template.Refresh">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Refresh" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Common.Refresh}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="SeedDemo_Click" auth:PermissionAssist.PermissionKey="Button.Template.SeedDemo">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="DatabasePlusOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Template.SeedDemo}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- 主从三栏大网格 (采用大Grid行级轨道物理对齐，确保所有表格与卡片在同一水平线) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.8*" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2.2*" MinWidth="540" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2.8*" MinWidth="600" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- 行 0：标题栏 -->
                <RowDefinition Height="Auto" /> <!-- 行 1：按钮控制与过滤面板 (自动对齐最高高度) -->
                <RowDefinition Height="*" />    <!-- 行 2：表格数据卡片栏 (顶端100%在同一水平线) -->
            </Grid.RowDefinitions>

            <!-- ================= 第一栏：标签分类 ================= -->
            <!-- 标题 -->
            <TextBlock Grid.Column="0" Grid.Row="0" Style="{StaticResource SectionTitleStyle}" Text="{DynamicResource Template.Categories}" Margin="0,0,0,6" />
            
            <!-- 按钮控制面板 -->
            <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,6,8" VerticalAlignment="Top">
                <!-- 分类操作按钮 -->
                <WrapPanel Margin="0,0,0,4">
                    <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="AddCategory_Click" Margin="0,0,8,8" auth:PermissionAssist.PermissionKey="Button.Template.Category.Create">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="PlusCircleOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Template.AddCategory}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="EditCategory_Click" Margin="0,0,8,8" auth:PermissionAssist.PermissionKey="Button.Template.Category.Edit">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="PencilOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Common.Edit}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppDangerButtonStyle}" Click="DeleteCategory_Click" Margin="0,0,8,8" auth:PermissionAssist.PermissionKey="Button.Template.Category.Delete">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="TrashCanOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Common.Delete}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <!-- 分类搜索过滤 -->
                <WrapPanel Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,8">
                        <TextBlock Style="{StaticResource AppFormLabelStyle}" Text="{DynamicResource Common.Keyword}" />
                        <TextBox x:Name="CategorySearchBox" Width="130" VerticalAlignment="Center" KeyDown="CategorySearchBox_KeyDown" />
                    </StackPanel>
                    <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="CategoryFilter_Click" Margin="0,0,8,8" auth:PermissionAssist.PermissionKey="Button.Template.Category.Search">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Magnify" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Common.Search}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppGhostButtonStyle}" Click="ClearCategoryFilter_Click" Margin="0,0,8,8" auth:PermissionAssist.PermissionKey="Button.Template.Category.Search">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="FilterRemoveOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Common.Clear}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>

            <!-- 表格卡片 (顶端绝对齐平) -->
            <Border Grid.Column="0" Grid.Row="2" Margin="0,0,6,0" Style="{StaticResource AppCardStyle}" VerticalAlignment="Stretch">
                <Grid>
                    <DataGrid x:Name="CategoryGrid"
                              SelectionChanged="CategoryGrid_SelectionChanged"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Margin="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Common.Name}" Binding="{Binding Name}" Width="*" MinWidth="120" ElementStyle="{StaticResource AppDataGridTextColumnElementStyle}" />
                            <DataGridTemplateColumn Header="{DynamicResource Common.Status}"
                                                    Width="76"
                                                    CellStyle="{StaticResource AppDataGridCenterCellStyle}"
                                                    HeaderStyle="{StaticResource AppDataGridCenterColumnHeaderStyle}"
                                                    SortMemberPath="IsEnabled">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CategoryStatusBadgeTemplate}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Style="{StaticResource AppDataGridEmptyStatePanelStyle}"
                                Visibility="{Binding Visibility, ElementName=CategoryEmptyText}">
                        <Border Style="{StaticResource AppEmptyStateIconFrameStyle}">
                            <iconPacks:PackIconMaterial Kind="PencilBoxOutline" Style="{StaticResource AppEmptyStateIconStyle}" />
                        </Border>
                        <TextBlock x:Name="CategoryEmptyText" Text="{DynamicResource Template.EmptyCategoryTitle}" Style="{StaticResource AppEmptyStateTitleStyle}" Visibility="Collapsed" />
                        <TextBlock Text="{DynamicResource Template.EmptyCategoryHint}" Style="{StaticResource AppEmptyStateHintStyle}" />
                    </StackPanel>
                </Grid>
            </Border>


            <!-- 拖拽条 1 -->
            <GridSplitter Grid.Column="1" Grid.Row="0" Grid.RowSpan="3" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" Margin="2,0" />


            <!-- ================= 第二栏：标签模板 ================= -->
            <!-- 标题 -->
            <TextBlock Grid.Column="2" Grid.Row="0" Style="{StaticResource SectionTitleStyle}" Text="{DynamicResource Template.Templates}" Margin="6,0,0,6" />
            
            <!-- 按钮控制面板 -->
            <StackPanel Grid.Column="2" Grid.Row="1" Margin="6,0,6,8" VerticalAlignment="Top">
                <!-- 模板操作按钮 -->
                <WrapPanel Margin="0,0,0,2">
                    <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="AddTemplate_Click" Margin="0,0,8,8" auth:PermissionAssist.PermissionKey="Button.Template.Create">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="PlusCircleOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Template.AddTemplate}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="EditTemplate_Click" Margin="0,0,8,8" auth:PermissionAssist.PermissionKey="Button.Template.Edit">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="PencilOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Common.Edit}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppDangerButtonStyle}" Click="DeleteTemplate_Click" Margin="0,0,8,8" auth:PermissionAssist.PermissionKey="Button.Template.Delete">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="TrashCanOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Common.Delete}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="UploadTemplate_Click" Margin="0,0,8,8" auth:PermissionAssist.PermissionKey="Button.Template.Upload">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="CloudUploadOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Template.UploadMrt}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="DesignTemplate_Click" Margin="0,0,8,8" auth:PermissionAssist.PermissionKey="Button.Template.Design">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="PaletteOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Template.Designer}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <!-- 模板搜索过滤 -->
                <WrapPanel Margin="0,0,0,2">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,8">
                        <TextBlock Style="{StaticResource AppFormLabelStyle}" Text="{DynamicResource Common.Keyword}" />
                        <TextBox x:Name="TemplateSearchBox" Width="120" VerticalAlignment="Center" KeyDown="TemplateSearchBox_KeyDown" />
                    </StackPanel>
                    <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="TemplateFilter_Click" Margin="0,0,8,8" auth:PermissionAssist.PermissionKey="Button.Template.Search">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Magnify" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Common.Search}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppGhostButtonStyle}" Click="ClearTemplateFilter_Click" Margin="0,0,8,8" auth:PermissionAssist.PermissionKey="Button.Template.Search">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="FilterRemoveOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Common.Clear}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>

            <!-- 表格卡片 (顶端绝对齐平) -->
            <Border Grid.Column="2" Grid.Row="2" Margin="6,0,6,0" Style="{StaticResource AppCardStyle}" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <DataGrid x:Name="TemplateGrid"
                              Grid.Row="0"
                              SelectionChanged="TemplateGrid_SelectionChanged"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Margin="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Common.Name}" Binding="{Binding Name}" Width="130" ElementStyle="{StaticResource AppDataGridTextColumnElementStyle}" />
                            <DataGridTemplateColumn Header="{DynamicResource Template.Mode}" Width="82" SortMemberPath="TemplateMode">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TemplateModeBadgeTemplate}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- 存储介质 Badge 胶囊列 -->
                            <DataGridTemplateColumn Header="{DynamicResource Template.Storage}" Width="96">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="BadgeBorder" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8,3" Background="#12FF5722">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconMaterial x:Name="BadgeIcon" Kind="Folder" Foreground="#FF5722" Width="11" Height="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                <TextBlock x:Name="BadgeText" Text="{DynamicResource Template.LocalFile}" FontSize="11" Foreground="#FF5722" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding StorageType}" Value="Database">
                                                <Setter TargetName="BadgeBorder" Property="Background" Value="#120066FF" />
                                                <Setter TargetName="BadgeIcon" Property="Kind" Value="Database" />
                                                <Setter TargetName="BadgeIcon" Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                                <Setter TargetName="BadgeText" Property="Text" Value="{DynamicResource Template.Database}" />
                                                <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- 重置周期 Badge 胶囊列 -->
                            <DataGridTemplateColumn Header="{DynamicResource Template.ResetPeriod}" Width="90" SortMemberPath="SerialResetPeriod">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBlock x:Name="MutedText" Text="-" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="Collapsed" />
                                            <Border x:Name="BadgeBorder" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8,3" Background="#12708090">
                                                <TextBlock x:Name="BadgeText" Text="{DynamicResource Template.ResetNeverShort}" FontSize="11" Foreground="SlateGray" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding TemplateMode}" Value="Normal">
                                                <Setter TargetName="BadgeBorder" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="MutedText" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TemplateMode}" Value="Batch">
                                                <Setter TargetName="BadgeBorder" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="MutedText" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SerialResetPeriod}" Value="Daily">
                                                <Setter TargetName="BadgeBorder" Property="Background" Value="#120066FF" />
                                                <Setter TargetName="BadgeText" Property="Text" Value="{DynamicResource Template.ResetDailyShort}" />
                                                <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SerialResetPeriod}" Value="Monthly">
                                                <Setter TargetName="BadgeBorder" Property="Background" Value="#128A2BE2" />
                                                <Setter TargetName="BadgeText" Property="Text" Value="{DynamicResource Template.ResetMonthlyShort}" />
                                                <Setter TargetName="BadgeText" Property="Foreground" Value="#8A2BE2" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SerialResetPeriod}" Value="Yearly">
                                                <Setter TargetName="BadgeBorder" Property="Background" Value="#12FF9900" />
                                                <Setter TargetName="BadgeText" Property="Text" Value="{DynamicResource Template.ResetYearlyShort}" />
                                                <Setter TargetName="BadgeText" Property="Foreground" Value="#FF9900" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{DynamicResource Template.File}" Binding="{Binding TemplateFileName}" Width="*" MinWidth="120" ElementStyle="{StaticResource AppDataGridTextColumnElementStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="0"
                                Style="{StaticResource AppDataGridEmptyStatePanelStyle}"
                                Visibility="{Binding Visibility, ElementName=TemplateEmptyText}">
                        <Border Style="{StaticResource AppEmptyStateIconFrameStyle}">
                            <iconPacks:PackIconMaterial Kind="PencilBoxOutline" Style="{StaticResource AppEmptyStateIconStyle}" />
                        </Border>
                        <TextBlock x:Name="TemplateEmptyText" Text="{DynamicResource Template.EmptyTemplateTitle}" Style="{StaticResource AppEmptyStateTitleStyle}" Visibility="Collapsed" />
                        <TextBlock Text="{DynamicResource Template.EmptyTemplateHint}" Style="{StaticResource AppEmptyStateHintStyle}" />
                    </StackPanel>
                    <Border Grid.Row="1" Padding="0,8,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{DynamicResource Common.PageSize}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ComboBox x:Name="TemplatePageSizeBox" Width="68" SelectedIndex="1" SelectionChanged="TemplatePageSizeBox_SelectionChanged" Margin="0,0,16,0" VerticalAlignment="Center">
                                <ComboBoxItem Content="10" />
                                <ComboBoxItem Content="20" />
                                <ComboBoxItem Content="50" />
                            </ComboBox>
                            <Button x:Name="TemplateFirstPageButton" Style="{StaticResource PagerButtonStyle}" Click="TemplateFirstPage_Click">
                                <iconPacks:PackIconMaterial Kind="PageFirst" Width="16" Height="16" />
                            </Button>
                            <Button x:Name="TemplatePrevPageButton" Style="{StaticResource PagerButtonStyle}" Click="TemplatePrevPage_Click">
                                <iconPacks:PackIconMaterial Kind="ChevronLeft" Width="16" Height="16" />
                            </Button>
                            <TextBlock x:Name="TemplatePageInfoText" VerticalAlignment="Center" MinWidth="70" TextAlignment="Center" FontWeight="SemiBold" />
                            <Button x:Name="TemplateNextPageButton" Style="{StaticResource PagerButtonStyle}" Click="TemplateNextPage_Click">
                                <iconPacks:PackIconMaterial Kind="ChevronRight" Width="16" Height="16" />
                            </Button>
                            <Button x:Name="TemplateLastPageButton" Style="{StaticResource PagerButtonStyle}" Click="TemplateLastPage_Click">
                                <iconPacks:PackIconMaterial Kind="PageLast" Width="16" Height="16" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>


            <!-- 拖拽条 2 -->
            <GridSplitter Grid.Column="3" Grid.Row="0" Grid.RowSpan="3" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" Margin="2,0" />


            <!-- ================= 第三栏：模板字段 ================= -->
            <!-- 标题 -->
            <TextBlock Grid.Column="4" Grid.Row="0" Style="{StaticResource SectionTitleStyle}" Text="{DynamicResource Template.Fields}" Margin="6,0,0,6" />
            
            <!-- 按钮控制面板 -->
            <StackPanel Grid.Column="4" Grid.Row="1" Margin="6,0,0,8" VerticalAlignment="Top">
                <!-- 字段操作按钮 -->
                <WrapPanel Margin="0,0,0,2">
                    <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="AddField_Click" Margin="0,0,8,8" auth:PermissionAssist.PermissionKey="Button.Template.Field.Create">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="PlusCircleOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Template.AddField}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="EditField_Click" Margin="0,0,8,8" auth:PermissionAssist.PermissionKey="Button.Template.Field.Edit">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="PencilOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Common.Edit}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppDangerButtonStyle}" Click="DeleteField_Click" Margin="0,0,8,8" auth:PermissionAssist.PermissionKey="Button.Template.Field.Delete">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="TrashCanOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Common.Delete}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="FieldHistory_Click" Margin="0,0,8,8" auth:PermissionAssist.PermissionKey="Button.Template.Field.History">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="History" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Template.FieldHistory}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppGhostButtonStyle}" Click="MoveFieldUp_Click" Margin="0,0,8,8" auth:PermissionAssist.PermissionKey="Button.Template.Field.Sort">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ChevronLeft" Margin="0,0,6,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <iconPacks:PackIconMaterial.RenderTransform>
                                    <RotateTransform Angle="90" />
                                </iconPacks:PackIconMaterial.RenderTransform>
                            </iconPacks:PackIconMaterial>
                            <TextBlock Text="{DynamicResource Template.MoveUp}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppGhostButtonStyle}" Click="MoveFieldDown_Click" Margin="0,0,8,8" auth:PermissionAssist.PermissionKey="Button.Template.Field.Sort">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ChevronLeft" Margin="0,0,6,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <iconPacks:PackIconMaterial.RenderTransform>
                                    <RotateTransform Angle="-90" />
                                </iconPacks:PackIconMaterial.RenderTransform>
                            </iconPacks:PackIconMaterial>
                            <TextBlock Text="{DynamicResource Template.MoveDown}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <!-- 字段搜索过滤 -->
                <WrapPanel Margin="0,0,0,2">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,8">
                        <TextBlock Style="{StaticResource AppFormLabelStyle}" Text="{DynamicResource Common.Keyword}" />
                        <TextBox x:Name="FieldSearchBox" Width="140" VerticalAlignment="Center" KeyDown="FieldSearchBox_KeyDown" />
                    </StackPanel>
                    <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="FieldFilter_Click" Margin="0,0,8,8" auth:PermissionAssist.PermissionKey="Button.Template.Field.Search">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Magnify" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Common.Search}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppGhostButtonStyle}" Click="ClearFieldFilter_Click" Margin="0,0,8,8" auth:PermissionAssist.PermissionKey="Button.Template.Field.Search">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="FilterRemoveOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Common.Clear}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>

            <!-- 表格卡片 (顶端绝对齐平) -->
            <Border Grid.Column="4" Grid.Row="2" Margin="6,0,0,0" Style="{StaticResource AppCardStyle}" VerticalAlignment="Stretch">
                <Grid>
                    <DataGrid x:Name="FieldGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionChanged="FieldGrid_SelectionChanged"
                              Margin="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Template.Sort}" Binding="{Binding Sort}" Width="52" ElementStyle="{StaticResource AppDataGridTextColumnElementStyle}" />
                            <DataGridTextColumn Header="{DynamicResource Template.FieldName}" Binding="{Binding FieldName}" Width="110" ElementStyle="{StaticResource AppDataGridTextColumnElementStyle}" />
                            <DataGridTextColumn Header="{DynamicResource Template.FieldCode}" Binding="{Binding FieldCode}" Width="120" ElementStyle="{StaticResource AppDataGridTextColumnElementStyle}" />
                            <!-- 字段数据类型 Badge 胶囊列 -->
                            <DataGridTemplateColumn Header="{DynamicResource Template.Type}" Width="76">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldTypeBadgeTemplate}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 字段必填属性 Badge 胶囊列 -->
                            <DataGridTemplateColumn Header="{DynamicResource Template.Required}" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldRequiredBadgeTemplate}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{DynamicResource Template.ValidationRule}" Binding="{Binding ValidationRuleSummary}" Width="160" ElementStyle="{StaticResource AppDataGridTextColumnElementStyle}" />
                            <DataGridTextColumn Header="{DynamicResource Template.Remark}" Binding="{Binding Remark}" Width="*" MinWidth="140" ElementStyle="{StaticResource AppDataGridTextColumnElementStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Style="{StaticResource AppDataGridEmptyStatePanelStyle}"
                                Visibility="{Binding Visibility, ElementName=FieldEmptyText}">
                        <Border Style="{StaticResource AppEmptyStateIconFrameStyle}">
                            <iconPacks:PackIconMaterial Kind="FormatListText" Style="{StaticResource AppEmptyStateIconStyle}" />
                        </Border>
                        <TextBlock x:Name="FieldEmptyText" Text="{DynamicResource Template.EmptyFieldTitle}" Style="{StaticResource AppEmptyStateTitleStyle}" Visibility="Collapsed" />
                        <TextBlock Text="{DynamicResource Template.EmptyFieldHint}" Style="{StaticResource AppEmptyStateHintStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
