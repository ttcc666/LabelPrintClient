<Window x:Class="LabelPrintClient.Modules.Template.Views.TemplateEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="{DynamicResource Template.EditTitle}"
        Width="540"
        Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource SecondaryRegionBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock x:Name="TitleText" Grid.Row="0" Style="{StaticResource AppPageTitleStyle}" Text="{DynamicResource Template.AddTemplate}" Margin="0,0,0,16" />

        <!-- 表单 -->
        <StackPanel Grid.Row="1">
            <!-- 模板名称 -->
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="{DynamicResource Template.Name}" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBox x:Name="NameBox" MaxLength="50" Padding="8,8" />
            </StackPanel>

            <!-- 存储介质 -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="{DynamicResource Template.StorageType}" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ComboBox x:Name="StorageTypeBox" SelectedIndex="0">
                    <ComboBoxItem Content="{DynamicResource Template.LocalFileFull}" Tag="LocalFile" />
                    <ComboBoxItem Content="{DynamicResource Template.DatabaseFull}" Tag="Database" />
                </ComboBox>
            </StackPanel>

            <!-- 模板模式与规则配置 -->
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="{DynamicResource Template.TemplateMode}" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ComboBox x:Name="TemplateModeBox" SelectedIndex="0" SelectionChanged="Rule_Changed">
                    <ComboBoxItem Content="{DynamicResource Template.Normal}" Tag="Normal" />
                    <ComboBoxItem Content="{DynamicResource Template.Batch}" Tag="Batch" />
                    <ComboBoxItem Content="{DynamicResource Template.Serialized}" Tag="Serialized" />
                </ComboBox>

                <Border CornerRadius="8" 
                        Background="#050066FF" 
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" 
                        Padding="14"
                        Margin="0,12,0,0"
                        x:Name="RulePanel">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 规则配置 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Template.Rule}" FontSize="12.5" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBox x:Name="RulePatternBox" Grid.Row="0" Grid.Column="1" Text="BATCH-{yyyy}{MM}{dd}" MaxLength="200" Padding="8,6" TextChanged="Rule_Changed" />

                        <!-- 重置周期 -->
                        <TextBlock x:Name="ResetPeriodLabel" Grid.Row="1" Grid.Column="0" Text="{DynamicResource Template.ResetPeriod}" FontSize="12.5" VerticalAlignment="Center" Margin="0,12,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ComboBox x:Name="SerialResetPeriodBox" Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" SelectedIndex="0" SelectionChanged="Rule_Changed">
                            <ComboBoxItem Content="{DynamicResource Template.ResetNever}" Tag="Never" />
                            <ComboBoxItem Content="{DynamicResource Template.ResetDaily}" Tag="Daily" />
                            <ComboBoxItem Content="{DynamicResource Template.ResetMonthly}" Tag="Monthly" />
                            <ComboBoxItem Content="{DynamicResource Template.ResetYearly}" Tag="Yearly" />
                        </ComboBox>

                        <!-- 变量提示与胶囊预览 -->
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,10,0,0">
                            <TextBlock x:Name="RuleExampleText" Text="{DynamicResource Template.RuleExampleBatch}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="RuleVariableText" Text="{DynamicResource Template.RuleVariablesBatch}" FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            
                            <!-- 胶囊状的高颜值预览 Badge -->
                            <Border CornerRadius="12" 
                                    Background="#1A0066FF" 
                                    HorizontalAlignment="Left" 
                                    Padding="10,4" 
                                    Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Eye" Foreground="{DynamicResource PrimaryBrush}" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="RulePreviewText" FontSize="11.5" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <CheckBox x:Name="IsEnabledBox" Content="{DynamicResource Template.EnableTemplate}" IsChecked="True" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="90" Style="{StaticResource AppDialogPrimaryButtonStyle}" Click="Ok_Click" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Check" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Common.Ok}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Width="90" Style="{StaticResource AppDialogCancelButtonStyle}" Click="Cancel_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Common.Cancel}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
