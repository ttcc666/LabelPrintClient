<Window x:Class="LabelPrintClient.Modules.Template.Views.FieldHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:auth="clr-namespace:LabelPrintClient.Modules.Auth.Infrastructure"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="{DynamicResource FieldHistory.Title}"
        Width="1080"
        Height="640"
        MinWidth="980"
        MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="HistoryRestoreButtonStyle" TargetType="Button" BasedOn="{StaticResource AppSecondaryButtonStyle}">
            <Setter Property="Width" Value="34" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#4034C759" />
            <Setter Property="Foreground" Value="#34C759" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1234C759" />
                    <Setter Property="BorderBrush" Value="#34C759" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HistoryCopyButtonStyle" TargetType="Button" BasedOn="{StaticResource AppSecondaryButtonStyle}">
            <Setter Property="Width" Value="34" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#402563EB" />
            <Setter Property="Foreground" Value="#2563EB" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#122563EB" />
                    <Setter Property="BorderBrush" Value="#2563EB" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 操作类型 Badge 模板 -->
        <DataTemplate x:Key="HistoryOperationBadgeTemplate">
            <Border x:Name="BadgeBorder" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8,3" Background="#120066FF">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial x:Name="BadgeIcon" Kind="PencilOutline" Foreground="{DynamicResource PrimaryBrush}" Width="11" Height="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="BadgeText" Text="{DynamicResource FieldHistory.Change}" FontSize="11" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding OperationType}" Value="Delete">
                    <Setter TargetName="BadgeBorder" Property="Background" Value="#12FF3B30" />
                    <Setter TargetName="BadgeIcon" Property="Kind" Value="TrashCanOutline" />
                    <Setter TargetName="BadgeIcon" Property="Foreground" Value="#FF3B30" />
                    <Setter TargetName="BadgeText" Property="Text" Value="{DynamicResource FieldHistory.Delete}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="#FF3B30" />
                </DataTrigger>
                <DataTrigger Binding="{Binding OperationType}" Value="Restore">
                    <Setter TargetName="BadgeBorder" Property="Background" Value="#1234C759" />
                    <Setter TargetName="BadgeIcon" Property="Kind" Value="BackupRestore" />
                    <Setter TargetName="BadgeIcon" Property="Foreground" Value="#34C759" />
                    <Setter TargetName="BadgeText" Property="Text" Value="{DynamicResource FieldHistory.Restore}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="#34C759" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource AppToolbarCardStyle}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource AppPageTitleStyle}" Text="{DynamicResource FieldHistory.Title}" Margin="0,0,16,0" />
                    <TextBlock x:Name="TemplateNameText"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button x:Name="RefreshButton"
                        DockPanel.Dock="Right"
                        Style="{StaticResource AppSecondaryButtonStyle}"
                        Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Refresh" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Common.Refresh}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <DataGrid x:Name="HistoryGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding CreateTime, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}"
                                        Width="170"
                                        ElementStyle="{StaticResource AppDataGridTextColumnElementStyle}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{DynamicResource FieldHistory.Time}" />
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Width="82" MinWidth="82" SortMemberPath="OperationType">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{DynamicResource Common.Operation}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource HistoryOperationBadgeTemplate}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Binding="{Binding FieldName}" Width="130" ElementStyle="{StaticResource AppDataGridTextColumnElementStyle}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{DynamicResource Field.Name}" />
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding FieldCode}" Width="130" ElementStyle="{StaticResource AppDataGridTextColumnElementStyle}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{DynamicResource Field.Code}" />
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding ChangeSummary}" Width="*" MinWidth="260" ElementStyle="{StaticResource AppDataGridTextColumnElementStyle}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{DynamicResource FieldHistory.ChangeSummary}" />
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding OperatorName}" Width="100" ElementStyle="{StaticResource AppDataGridTextColumnElementStyle}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{DynamicResource PrintCenter.Operator}" />
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Width="92" MinWidth="92">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{DynamicResource Common.Operation}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource HistoryRestoreButtonStyle}"
                                            ToolTip="{DynamicResource FieldHistory.RestoreField}"
                                            IsEnabled="{Binding CanRestoreField}"
                                            Click="RestoreHistoryField_Click"
                                            auth:PermissionAssist.PermissionKey="Button.Template.Field.Restore">
                                        <iconPacks:PackIconMaterial Kind="BackupRestore" Width="14" Height="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Button>
                                    <Button Style="{StaticResource HistoryCopyButtonStyle}"
                                            ToolTip="{DynamicResource FieldHistory.CopyAsField}"
                                            IsEnabled="{Binding CanCopyAsField}"
                                            Click="CopyHistoryField_Click">
                                        <iconPacks:PackIconMaterial Kind="ContentCopy" Width="14" Height="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <Grid x:Name="HistoryLoadingOverlay" Visibility="Collapsed">
                <Border Background="{DynamicResource RegionBrush}" Opacity="0.75" CornerRadius="6" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <hc:LoadingCircle Width="36" Height="36" Foreground="{DynamicResource PrimaryBrush}" />
                    <TextBlock Text="{DynamicResource FieldHistory.Loading}"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="12" />
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Padding="0,8,0,0"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Margin="0,10,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="StatusText"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{DynamicResource Common.PageSize}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="HistoryPageSizeBox"
                              Width="68"
                              SelectedIndex="1"
                              SelectionChanged="HistoryPageSizeBox_SelectionChanged"
                              Margin="0,0,16,0"
                              VerticalAlignment="Center">
                        <ComboBoxItem Content="10" />
                        <ComboBoxItem Content="20" />
                        <ComboBoxItem Content="50" />
                    </ComboBox>
                    <Button x:Name="HistoryFirstPageButton" Style="{StaticResource PagerButtonStyle}" Click="HistoryFirstPage_Click">
                        <iconPacks:PackIconMaterial Kind="PageFirst" Width="16" Height="16" />
                    </Button>
                    <Button x:Name="HistoryPrevPageButton" Style="{StaticResource PagerButtonStyle}" Click="HistoryPrevPage_Click">
                        <iconPacks:PackIconMaterial Kind="ChevronLeft" Width="16" Height="16" />
                    </Button>
                    <TextBlock x:Name="HistoryPageInfoText"
                               VerticalAlignment="Center"
                               MinWidth="90"
                               TextAlignment="Center"
                               FontWeight="SemiBold" />
                    <Button x:Name="HistoryNextPageButton" Style="{StaticResource PagerButtonStyle}" Click="HistoryNextPage_Click">
                        <iconPacks:PackIconMaterial Kind="ChevronRight" Width="16" Height="16" />
                    </Button>
                    <Button x:Name="HistoryLastPageButton" Style="{StaticResource PagerButtonStyle}" Click="HistoryLastPage_Click">
                        <iconPacks:PackIconMaterial Kind="PageLast" Width="16" Height="16" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
