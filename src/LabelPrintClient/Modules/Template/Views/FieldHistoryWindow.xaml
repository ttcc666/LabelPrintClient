<Window x:Class="LabelPrintClient.Modules.Template.Views.FieldHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="字段变更履历"
        Width="980"
        Height="640"
        MinWidth="860"
        MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource AppToolbarCardStyle}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource AppPageTitleStyle}" Text="字段变更履历" Margin="0,0,16,0" />
                    <TextBlock x:Name="TemplateNameText"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button x:Name="RefreshButton"
                        DockPanel.Dock="Right"
                        Style="{StaticResource AppSecondaryButtonStyle}"
                        Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Refresh" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="刷新" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <DataGrid x:Name="HistoryGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="时间"
                                        Binding="{Binding CreateTime, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}"
                                        Width="170" />
                    <DataGridTextColumn Header="操作" Binding="{Binding OperationTypeText}" Width="72" />
                    <DataGridTextColumn Header="字段名" Binding="{Binding FieldName}" Width="130" />
                    <DataGridTextColumn Header="字段编码" Binding="{Binding FieldCode}" Width="130" />
                    <DataGridTextColumn Header="变更内容" Binding="{Binding ChangeSummary}" Width="*" MinWidth="260" />
                    <DataGridTextColumn Header="操作人" Binding="{Binding OperatorName}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>
            <Grid x:Name="HistoryLoadingOverlay" Visibility="Collapsed">
                <Border Background="{DynamicResource RegionBrush}" Opacity="0.75" CornerRadius="6" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <hc:LoadingCircle Width="36" Height="36" Foreground="{DynamicResource PrimaryBrush}" />
                    <TextBlock Text="正在加载字段履历..."
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="12" />
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Padding="0,8,0,0"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Margin="0,10,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="StatusText"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="每页" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="HistoryPageSizeBox"
                              Width="68"
                              SelectedIndex="1"
                              SelectionChanged="HistoryPageSizeBox_SelectionChanged"
                              Margin="0,0,16,0"
                              VerticalAlignment="Center">
                        <ComboBoxItem Content="10" />
                        <ComboBoxItem Content="20" />
                        <ComboBoxItem Content="50" />
                    </ComboBox>
                    <Button x:Name="HistoryFirstPageButton" Style="{StaticResource PagerButtonStyle}" Click="HistoryFirstPage_Click">
                        <iconPacks:PackIconMaterial Kind="PageFirst" Width="16" Height="16" />
                    </Button>
                    <Button x:Name="HistoryPrevPageButton" Style="{StaticResource PagerButtonStyle}" Click="HistoryPrevPage_Click">
                        <iconPacks:PackIconMaterial Kind="ChevronLeft" Width="16" Height="16" />
                    </Button>
                    <TextBlock x:Name="HistoryPageInfoText"
                               VerticalAlignment="Center"
                               MinWidth="90"
                               TextAlignment="Center"
                               FontWeight="SemiBold" />
                    <Button x:Name="HistoryNextPageButton" Style="{StaticResource PagerButtonStyle}" Click="HistoryNextPage_Click">
                        <iconPacks:PackIconMaterial Kind="ChevronRight" Width="16" Height="16" />
                    </Button>
                    <Button x:Name="HistoryLastPageButton" Style="{StaticResource PagerButtonStyle}" Click="HistoryLastPage_Click">
                        <iconPacks:PackIconMaterial Kind="PageLast" Width="16" Height="16" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
