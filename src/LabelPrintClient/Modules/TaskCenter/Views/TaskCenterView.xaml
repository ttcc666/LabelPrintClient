<UserControl x:Class="LabelPrintClient.Modules.TaskCenter.Views.TaskCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="ui:TextBlock">
            <Setter Property="FontTypography" Value="BodyStrong" />
            <Setter Property="Margin" Value="4,0,0,8" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:Card Grid.Row="0" Margin="0,0,0,8" Padding="10">
            <DockPanel LastChildFill="False">
                <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <ui:TextBlock FontTypography="Subtitle"
                                  Text="任务中心"
                                  VerticalAlignment="Center"
                                  Margin="0,0,20,0" />
                    <ComboBox x:Name="KindFilterBox" Width="100" SelectedIndex="0" SelectionChanged="Filter_Changed" Margin="0,0,8,0">
                        <ComboBoxItem Content="全部类型" Tag="All" />
                        <ComboBoxItem Content="导入" Tag="Import" />
                        <ComboBoxItem Content="导出" Tag="Export" />
                        <ComboBoxItem Content="预览" Tag="Preview" />
                        <ComboBoxItem Content="设计" Tag="Design" />
                        <ComboBoxItem Content="打印" Tag="Print" />
                        <ComboBoxItem Content="上传" Tag="Upload" />
                    </ComboBox>
                    <ComboBox x:Name="StatusFilterBox" Width="100" SelectedIndex="0" SelectionChanged="Filter_Changed" Margin="0,0,8,0">
                        <ComboBoxItem Content="全部状态" Tag="All" />
                        <ComboBoxItem Content="等待中" Tag="Pending" />
                        <ComboBoxItem Content="执行中" Tag="Running" />
                        <ComboBoxItem Content="已完成" Tag="Completed" />
                        <ComboBoxItem Content="失败" Tag="Failed" />
                        <ComboBoxItem Content="已取消" Tag="Canceled" />
                    </ComboBox>
                    <ui:TextBox x:Name="TaskSearchBox"
                                Width="180"
                                PlaceholderText="任务关键字"
                                Margin="0,0,8,0"
                                KeyDown="TaskSearchBox_KeyDown" />
                    <ui:Button Content="查询" Click="ApplyFilter_Click" Margin="0,0,8,0" />
                    <ui:Button Content="清空" Click="ClearFilter_Click" />
                </WrapPanel>
                <ui:Button DockPanel.Dock="Right"
                           Content="清理已结束"
                           Icon="{ui:SymbolIcon Delete24}"
                           Click="ClearCompleted_Click" />
            </DockPanel>
        </ui:Card>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ui:TextBlock Grid.Row="0" Style="{StaticResource SectionTitleStyle}" Text="后台任务" />

            <ui:Card Grid.Row="1" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid>
                    <ui:DataGrid x:Name="TaskGrid"
                                 AutoGenerateColumns="False"
                                 IsReadOnly="True"
                                 Margin="0"
                                 BorderThickness="0"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="类型" Binding="{Binding KindText}" Width="70" />
                            <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="80" />
                            <DataGridTextColumn Header="任务" Binding="{Binding Title}" Width="190" />
                            <DataGridTemplateColumn Header="进度" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center">
                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" Height="10" />
                                            <TextBlock Text="{Binding ProgressText, Mode=OneWay}" HorizontalAlignment="Center" FontSize="11" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="180" />
                            <DataGridTextColumn Header="创建时间" Binding="{Binding CreateTime, StringFormat=MM-dd HH:mm:ss}" Width="120" />
                            <DataGridTextColumn Header="完成时间" Binding="{Binding FinishTime, StringFormat=MM-dd HH:mm:ss}" Width="120" />
                            <DataGridTextColumn Header="错误" Binding="{Binding ErrorMessage}" Width="*" MinWidth="180" />
                        </DataGrid.Columns>
                    </ui:DataGrid>
                    <TextBlock x:Name="EmptyText"
                               Text="暂无后台任务"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="Collapsed" />
                </Grid>
            </ui:Card>
        </Grid>

        <ui:Card Grid.Row="2" Padding="10" Margin="0,8,0,0">
            <ui:TextBlock x:Name="SummaryText"
                          FontTypography="BodyStrong"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </ui:Card>
    </Grid>
</UserControl>
