<UserControl x:Class="LabelPrintClient.Modules.TaskCenter.Views.TaskCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <UserControl.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource AppSectionTitleStyle}" />

        <Style x:Key="TaskProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="8" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="PART_Track"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    CornerRadius="4">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FF3A5CE5" Offset="0" />
                                        <GradientStop Color="#FF00D2FF" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource AppToolbarCardStyle}">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Style="{StaticResource AppPageTitleStyle}"
                           Text="任务中心"
                           Margin="0,0,16,0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Style="{StaticResource AppFormLabelStyle}" Text="类型" />
                    <ComboBox x:Name="KindFilterBox" Width="100" SelectedIndex="0" SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="全部类型" Tag="All" />
                        <ComboBoxItem Content="导入" Tag="Import" />
                        <ComboBoxItem Content="导出" Tag="Export" />
                        <ComboBoxItem Content="预览" Tag="Preview" />
                        <ComboBoxItem Content="设计" Tag="Design" />
                        <ComboBoxItem Content="打印" Tag="Print" />
                        <ComboBoxItem Content="上传" Tag="Upload" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Style="{StaticResource AppFormLabelStyle}" Text="状态" />
                    <ComboBox x:Name="StatusFilterBox" Width="100" SelectedIndex="0" SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="全部状态" Tag="All" />
                        <ComboBoxItem Content="等待中" Tag="Pending" />
                        <ComboBoxItem Content="执行中" Tag="Running" />
                        <ComboBoxItem Content="已完成" Tag="Completed" />
                        <ComboBoxItem Content="失败" Tag="Failed" />
                        <ComboBoxItem Content="已取消" Tag="Canceled" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Style="{StaticResource AppFormLabelStyle}" Text="关键词" />
                    <TextBox x:Name="TaskSearchBox"
                             MinWidth="120"
                             MaxWidth="220"
                             Width="220"
                             VerticalAlignment="Center"
                             KeyDown="TaskSearchBox_KeyDown" />
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="ApplyFilter_Click" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Magnify" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="查询" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppGhostButtonStyle}" Click="ClearFilter_Click" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="FilterRemoveOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="清空" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppDangerButtonStyle}" Click="ClearCompleted_Click" Margin="0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="TrashCanOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="清理已结束" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource SectionTitleStyle}" Text="后台任务" />

            <Border Grid.Row="1" Style="{StaticResource AppDataCardStyle}" VerticalAlignment="Stretch">
                <Grid>
                    <DataGrid x:Name="TaskGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Margin="0"
                              BorderThickness="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="类型" Width="82" SortMemberPath="Kind">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="KindBadge" CornerRadius="11" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="8,2.5" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconMaterial x:Name="KindIcon" Kind="HelpCircleOutline" Width="11" Height="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                <TextBlock x:Name="KindText" Text="{Binding KindText}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="Import">
                                                <Setter TargetName="KindBadge" Property="Background" Value="#122563EB" />
                                                <Setter TargetName="KindBadge" Property="BorderBrush" Value="#402563EB" />
                                                <Setter TargetName="KindIcon" Property="Kind" Value="FileImportOutline" />
                                                <Setter TargetName="KindIcon" Property="Foreground" Value="#2563EB" />
                                                <Setter TargetName="KindText" Property="Foreground" Value="#2563EB" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Export">
                                                <Setter TargetName="KindBadge" Property="Background" Value="#1216803C" />
                                                <Setter TargetName="KindBadge" Property="BorderBrush" Value="#4016803C" />
                                                <Setter TargetName="KindIcon" Property="Kind" Value="FileExportOutline" />
                                                <Setter TargetName="KindIcon" Property="Foreground" Value="#16803C" />
                                                <Setter TargetName="KindText" Property="Foreground" Value="#16803C" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Preview">
                                                <Setter TargetName="KindBadge" Property="Background" Value="#127C3AED" />
                                                <Setter TargetName="KindBadge" Property="BorderBrush" Value="#407C3AED" />
                                                <Setter TargetName="KindIcon" Property="Kind" Value="EyeOutline" />
                                                <Setter TargetName="KindIcon" Property="Foreground" Value="#7C3AED" />
                                                <Setter TargetName="KindText" Property="Foreground" Value="#7C3AED" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Design">
                                                <Setter TargetName="KindBadge" Property="Background" Value="#12B45309" />
                                                <Setter TargetName="KindBadge" Property="BorderBrush" Value="#40B45309" />
                                                <Setter TargetName="KindIcon" Property="Kind" Value="PaletteOutline" />
                                                <Setter TargetName="KindIcon" Property="Foreground" Value="#B45309" />
                                                <Setter TargetName="KindText" Property="Foreground" Value="#B45309" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Print">
                                                <Setter TargetName="KindBadge" Property="Background" Value="#1200CC66" />
                                                <Setter TargetName="KindBadge" Property="BorderBrush" Value="#4000CC66" />
                                                <Setter TargetName="KindIcon" Property="Kind" Value="Printer" />
                                                <Setter TargetName="KindIcon" Property="Foreground" Value="#00CC66" />
                                                <Setter TargetName="KindText" Property="Foreground" Value="#00CC66" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Upload">
                                                <Setter TargetName="KindBadge" Property="Background" Value="#120284C7" />
                                                <Setter TargetName="KindBadge" Property="BorderBrush" Value="#400284C7" />
                                                <Setter TargetName="KindIcon" Property="Kind" Value="CloudUploadOutline" />
                                                <Setter TargetName="KindIcon" Property="Foreground" Value="#0284C7" />
                                                <Setter TargetName="KindText" Property="Foreground" Value="#0284C7" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="状态" Width="96" SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentControl Content="{Binding StatusText}" ContentTemplate="{StaticResource AppStatusBadgeTemplate}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="任务" Binding="{Binding DisplayTitle}" Width="220" ElementStyle="{StaticResource AppDataGridTextColumnElementStyle}" />
                            <DataGridTemplateColumn Header="进度" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="48" />
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar Grid.Column="0"
                                                         Minimum="0"
                                                         Maximum="100"
                                                         Value="{Binding Percent, Mode=OneWay}"
                                                         Style="{StaticResource TaskProgressBarStyle}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ProgressText, Mode=OneWay}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Right"
                                                       FontSize="11"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="说明" Binding="{Binding Description}" Width="260" ElementStyle="{StaticResource AppDataGridTextColumnElementStyle}" />
                            <DataGridTextColumn Header="创建时间" Binding="{Binding CreateTime, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}" Width="170" ElementStyle="{StaticResource AppDataGridTextColumnElementStyle}" />
                            <DataGridTextColumn Header="完成时间" Binding="{Binding FinishTime, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}" Width="170" ElementStyle="{StaticResource AppDataGridTextColumnElementStyle}" />
                            <DataGridTextColumn Header="错误" Binding="{Binding ErrorMessage}" Width="*" MinWidth="180" ElementStyle="{StaticResource AppDataGridTextColumnElementStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Style="{StaticResource AppDataGridEmptyStatePanelStyle}"
                                Visibility="{Binding Visibility, ElementName=EmptyText}">
                        <Border Style="{StaticResource AppEmptyStateIconFrameStyle}">
                            <iconPacks:PackIconMaterial Kind="FormatListText" Style="{StaticResource AppEmptyStateIconStyle}" />
                        </Border>
                        <TextBlock x:Name="EmptyText"
                                   Text="暂无后台任务"
                                   Style="{StaticResource AppEmptyStateTitleStyle}"
                                   Visibility="Collapsed" />
                        <TextBlock Text="导入、导出、预览、设计和打印任务会显示在这里。"
                                   Style="{StaticResource AppEmptyStateHintStyle}" />
                    </StackPanel>
                    <!-- 任务加载遮罩层 -->
                    <Grid x:Name="TaskLoadingOverlay" Visibility="Collapsed">
                        <Border Background="{DynamicResource RegionBrush}" Opacity="0.75" CornerRadius="6" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <hc:LoadingCircle Width="36" Height="36" Foreground="{DynamicResource PrimaryBrush}" />
                            <TextBlock Text="正在更新任务日志..." Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource AppFooterCardStyle}">
            <TextBlock x:Name="SummaryText"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Border>
    </Grid>
</UserControl>