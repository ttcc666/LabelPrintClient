<UserControl x:Class="LabelPrintClient.Modules.TaskCenter.Views.TaskCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:auth="clr-namespace:LabelPrintClient.Modules.Auth.Infrastructure"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource AppSectionTitleStyle}" />
        <Style x:Key="SearchLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource AppFormLabelStyle}" />
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Style="{StaticResource AppToolbarCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <!-- 任务类型 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                        <TextBlock Text="{DynamicResource TaskCenter.TaskType}" Style="{StaticResource SearchLabelStyle}" />
                        <ComboBox x:Name="KindFilterBox" Width="120" SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="{DynamicResource Common.All}" Tag="All" IsSelected="True" />
                            <ComboBoxItem Content="{DynamicResource TaskCenter.KindImport}" Tag="Import" />
                            <ComboBoxItem Content="{DynamicResource TaskCenter.KindExport}" Tag="Export" />
                            <ComboBoxItem Content="{DynamicResource TaskCenter.KindPreview}" Tag="Preview" />
                            <ComboBoxItem Content="{DynamicResource TaskCenter.KindDesign}" Tag="Design" />
                            <ComboBoxItem Content="{DynamicResource TaskCenter.KindPrint}" Tag="Print" />
                        </ComboBox>
                    </StackPanel>

                    <!-- 任务状态 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                        <TextBlock Text="{DynamicResource Common.Status}" Style="{StaticResource SearchLabelStyle}" />
                        <ComboBox x:Name="StatusFilterBox" Width="120" SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="{DynamicResource Common.All}" Tag="All" IsSelected="True" />
                            <ComboBoxItem Content="{DynamicResource TaskCenter.StatusRunning}" Tag="Running" />
                            <ComboBoxItem Content="{DynamicResource TaskCenter.StatusCompleted}" Tag="Completed" />
                            <ComboBoxItem Content="{DynamicResource TaskCenter.StatusFailed}" Tag="Failed" />
                            <ComboBoxItem Content="{DynamicResource TaskCenter.StatusCancelled}" Tag="Canceled" />
                        </ComboBox>
                    </StackPanel>

                    <!-- 关键词 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                        <TextBlock Text="{DynamicResource Common.Keyword}" Style="{StaticResource SearchLabelStyle}" />
                        <TextBox x:Name="TaskSearchBox" Width="180" 
                                 hc:InfoElement.Placeholder="{DynamicResource TaskCenter.KeywordPlaceholder}"
                                 KeyDown="TaskSearchBox_KeyDown"
                                 Style="{StaticResource TextBoxExtend}" />
                    </StackPanel>
                </WrapPanel>

                <!-- 操作按钮组 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,8">
                    <Button Style="{StaticResource AppPrimaryButtonStyle}" Click="ApplyFilter_Click" Margin="0,0,8,0" auth:PermissionAssist.PermissionKey="Button.TaskCenter.Search">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Magnify" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Common.Search}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppGhostButtonStyle}" Click="ClearFilter_Click" Margin="0,0,8,0" auth:PermissionAssist.PermissionKey="Button.TaskCenter.Search">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="FilterRemoveOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Common.Clear}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppDangerButtonStyle}" Click="ClearCompleted_Click" auth:PermissionAssist.PermissionKey="Button.TaskCenter.ClearCompleted">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="TrashCanOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource TaskCenter.ClearCompleted}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource SectionTitleStyle}" Text="{DynamicResource TaskCenter.BackgroundTasks}" />

            <Border Grid.Row="1" Style="{StaticResource AppDataCardStyle}" VerticalAlignment="Stretch">
                <Grid>
                    <DataGrid x:Name="TaskGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Margin="0"
                              BorderThickness="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <!-- 1. 类型列 (HeaderTemplate 完美动态多语言) -->
                            <DataGridTemplateColumn Width="82" SortMemberPath="Kind">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{DynamicResource TaskCenter.Kind}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="KindBadge" CornerRadius="11" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="8,2.5" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconMaterial x:Name="KindIcon" Kind="HelpCircleOutline" Width="11" Height="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                <TextBlock x:Name="KindText" Text="{Binding KindText}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="Import">
                                                <Setter TargetName="KindBadge" Property="Background" Value="#122563EB" />
                                                <Setter TargetName="KindBadge" Property="BorderBrush" Value="#402563EB" />
                                                <Setter TargetName="KindIcon" Property="Kind" Value="FileImportOutline" />
                                                <Setter TargetName="KindIcon" Property="Foreground" Value="#2563EB" />
                                                <Setter TargetName="KindText" Property="Foreground" Value="#2563EB" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Export">
                                                <Setter TargetName="KindBadge" Property="Background" Value="#1216803C" />
                                                <Setter TargetName="KindBadge" Property="BorderBrush" Value="#4016803C" />
                                                <Setter TargetName="KindIcon" Property="Kind" Value="FileExportOutline" />
                                                <Setter TargetName="KindIcon" Property="Foreground" Value="#16803C" />
                                                <Setter TargetName="KindText" Property="Foreground" Value="#16803C" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Preview">
                                                <Setter TargetName="KindBadge" Property="Background" Value="#127C3AED" />
                                                <Setter TargetName="KindBadge" Property="BorderBrush" Value="#407C3AED" />
                                                <Setter TargetName="KindIcon" Property="Kind" Value="EyeOutline" />
                                                <Setter TargetName="KindIcon" Property="Foreground" Value="#7C3AED" />
                                                <Setter TargetName="KindText" Property="Foreground" Value="#7C3AED" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Design">
                                                <Setter TargetName="KindBadge" Property="Background" Value="#12B45309" />
                                                <Setter TargetName="KindBadge" Property="BorderBrush" Value="#40B45309" />
                                                <Setter TargetName="KindIcon" Property="Kind" Value="PaletteOutline" />
                                                <Setter TargetName="KindIcon" Property="Foreground" Value="#B45309" />
                                                <Setter TargetName="KindText" Property="Foreground" Value="#B45309" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Print">
                                                <Setter TargetName="KindBadge" Property="Background" Value="#1200CC66" />
                                                <Setter TargetName="KindBadge" Property="BorderBrush" Value="#4000CC66" />
                                                <Setter TargetName="KindIcon" Property="Kind" Value="Printer" />
                                                <Setter TargetName="KindIcon" Property="Foreground" Value="#00CC66" />
                                                <Setter TargetName="KindText" Property="Foreground" Value="#00CC66" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Upload">
                                                <Setter TargetName="KindBadge" Property="Background" Value="#120284C7" />
                                                <Setter TargetName="KindBadge" Property="BorderBrush" Value="#400284C7" />
                                                <Setter TargetName="KindIcon" Property="Kind" Value="CloudUploadOutline" />
                                                <Setter TargetName="KindIcon" Property="Foreground" Value="#0284C7" />
                                                <Setter TargetName="KindText" Property="Foreground" Value="#0284C7" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 2. 状态列 (HeaderTemplate 完美动态多语言) -->
                            <DataGridTemplateColumn Width="96" SortMemberPath="Status">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{DynamicResource Common.Status}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentControl Content="{Binding StatusText}" ContentTemplate="{StaticResource AppStatusBadgeTemplate}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 3. 任务列 -->
                            <DataGridTextColumn Binding="{Binding DisplayTitle}" Width="220" ElementStyle="{StaticResource AppDataGridTextColumnElementStyle}">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{DynamicResource TaskCenter.Task}" />
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>

                            <!-- 4. 进度列 -->
                            <DataGridTemplateColumn Width="180">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{DynamicResource TaskCenter.Progress}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="48" />
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar Grid.Column="0"
                                                         Minimum="0"
                                                         Maximum="100"
                                                         Value="{Binding Percent, Mode=OneWay}"
                                                         Style="{StaticResource TaskProgressBarStyle}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ProgressText, Mode=OneWay}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Right"
                                                       FontSize="11"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 5. 描述列 -->
                            <DataGridTextColumn Binding="{Binding Description}" Width="260" ElementStyle="{StaticResource AppDataGridTextColumnElementStyle}">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{DynamicResource TaskCenter.Description}" />
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>

                            <!-- 6. 创建时间 -->
                            <DataGridTextColumn Binding="{Binding CreateTime, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}" Width="170" ElementStyle="{StaticResource AppDataGridTextColumnElementStyle}">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{DynamicResource PrintHistory.CreateTime}" />
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>

                            <!-- 7. 完成时间 -->
                            <DataGridTextColumn Binding="{Binding FinishTime, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}" Width="170" ElementStyle="{StaticResource AppDataGridTextColumnElementStyle}">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{DynamicResource TaskCenter.FinishTime}" />
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>

                            <!-- 8. 错误信息 -->
                            <DataGridTextColumn Binding="{Binding ErrorMessage}" Width="*" MinWidth="180" ElementStyle="{StaticResource AppDataGridTextColumnElementStyle}">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{DynamicResource TaskCenter.Error}" />
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 空状态面板 -->
                    <StackPanel Style="{StaticResource AppDataGridEmptyStatePanelStyle}"
                                Visibility="{Binding Visibility, ElementName=EmptyText}">
                        <Border Style="{StaticResource AppEmptyStateIconFrameStyle}">
                            <iconPacks:PackIconMaterial Kind="FormatListText" Style="{StaticResource AppEmptyStateIconStyle}" />
                        </Border>
                        <TextBlock x:Name="EmptyText"
                                   Text="{DynamicResource TaskCenter.EmptyTitle}"
                                   Style="{StaticResource AppEmptyStateTitleStyle}"
                                   Visibility="Collapsed" />
                        <TextBlock Text="{DynamicResource TaskCenter.EmptyHint}"
                                   Style="{StaticResource AppEmptyStateHintStyle}" />
                    </StackPanel>

                    <!-- 任务加载遮罩层 -->
                    <Grid x:Name="TaskLoadingOverlay" Visibility="Collapsed">
                        <Border Background="{DynamicResource RegionBrush}" Opacity="0.75" CornerRadius="6" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <hc:LoadingCircle Width="36" Height="36" Foreground="{DynamicResource PrimaryBrush}" />
                            <TextBlock Text="{DynamicResource TaskCenter.Loading}" Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 页脚统计 -->
        <Border Grid.Row="2" Style="{StaticResource AppFooterCardStyle}">
            <TextBlock x:Name="SummaryText"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Border>
    </Grid>
</UserControl>
