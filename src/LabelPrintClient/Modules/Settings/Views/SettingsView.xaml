<UserControl x:Class="LabelPrintClient.Modules.Settings.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:infra="clr-namespace:LabelPrintClient.Infrastructure"
             xmlns:auth="clr-namespace:LabelPrintClient.Modules.Auth.Infrastructure"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <UserControl.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource AppSectionTitleStyle}" />

        <Style x:Key="FormLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource AppFormLabelStyle}">
            <Setter Property="Width" Value="130" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style x:Key="FormRowStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- 卡片内板块小 Title 样式 -->
        <Style x:Key="ConfigTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 表单 Label 样式 -->
        <Style x:Key="ConfigLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource AppToolbarCardStyle}">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left"
                           Style="{StaticResource AppPageTitleStyle}"
                           Text="{DynamicResource Settings.Title}"
                           Margin="0,0,20,0" />
                <TextBlock x:Name="ConfigPathText"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- 滚动区域包裹以适应不同分辨率 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" MinWidth="480" />
                    <ColumnDefinition Width="1*" MinWidth="380" />
                </Grid.ColumnDefinitions>

                <!-- 左栏：数据源连接与备份卡片组 -->
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    
                    <!-- 卡片 1：数据源连接配置 -->
                    <Border Style="{StaticResource AppCardStyle}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <iconPacks:PackIconMaterial Kind="Database" Foreground="{DynamicResource PrimaryBrush}" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource ConfigTitleStyle}" Text="{DynamicResource Settings.DataSource}" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="{DynamicResource Settings.RunMode}" Style="{StaticResource ConfigLabelStyle}" />
                                <ComboBox x:Name="RunModeBox" Width="200" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="{DynamicResource Settings.LocalSqlite}" Tag="LocalSqlite" />
                                    <ComboBoxItem Content="{DynamicResource Settings.LanPostgreSql}" Tag="LanPostgreSql" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="{DynamicResource Settings.SqliteConnection}" Style="{StaticResource ConfigLabelStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SqliteConnectionBox" Grid.Column="0" Margin="0,0,8,0" Padding="8,6" />
                                    <Button Grid.Column="1" Style="{StaticResource AppSecondaryButtonStyle}" Click="TestSqliteConnection_Click" Width="72" auth:PermissionAssist.PermissionKey="Button.Settings.TestConnection">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Connection" Margin="0,0,4,0" VerticalAlignment="Center" Width="12" Height="12" />
                                            <TextBlock Text="{DynamicResource Settings.Test}" VerticalAlignment="Center" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,4">
                                <TextBlock Text="{DynamicResource Settings.PostgreSqlConnection}" Style="{StaticResource ConfigLabelStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PostgreSqlConnectionBox" Grid.Column="0" Margin="0,0,8,0" Padding="8,6" />
                                    <Button Grid.Column="1" Style="{StaticResource AppSecondaryButtonStyle}" Click="TestPostgreSqlConnection_Click" Width="72" auth:PermissionAssist.PermissionKey="Button.Settings.TestConnection">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Connection" Margin="0,0,4,0" VerticalAlignment="Center" Width="12" Height="12" />
                                            <TextBlock Text="{DynamicResource Settings.Test}" VerticalAlignment="Center" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 卡片 2：数据备份与恢复 -->
                    <Border Style="{StaticResource AppCardStyle}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <iconPacks:PackIconMaterial Kind="ArchiveOutline" Foreground="{DynamicResource PrimaryBrush}" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource ConfigTitleStyle}" Text="{DynamicResource Settings.BackupRestore}" />
                            </StackPanel>

                            <TextBlock x:Name="BackupModeText"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       LineHeight="18"
                                       Margin="0,0,0,16" />

                            <WrapPanel HorizontalAlignment="Left">
                                <Button x:Name="BackupDataButton"
                                        Style="{StaticResource AppSecondaryButtonStyle}"
                                        Click="BackupData_Click"
                                        Margin="0,0,12,0"
                                        auth:PermissionAssist.PermissionKey="Button.Settings.Backup">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="ArchiveArrowDownOutline" Margin="0,0,6,0" VerticalAlignment="Center" Width="14" Height="14" />
                                        <TextBlock Text="{DynamicResource Settings.Backup}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RestoreDataButton"
                                        Style="{StaticResource AppDangerButtonStyle}"
                                        Click="RestoreData_Click"
                                        auth:PermissionAssist.PermissionKey="Button.Settings.Restore">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="ArchiveArrowUpOutline" Margin="0,0,6,0" VerticalAlignment="Center" Width="14" Height="14" />
                                        <TextBlock Text="{DynamicResource Settings.Restore}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- 卡片 3：授权使用配置 -->
                    <Border Style="{StaticResource AppCardStyle}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <iconPacks:PackIconMaterial Kind="ShieldKey" Foreground="{DynamicResource PrimaryBrush}" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource ConfigTitleStyle}" Text="{DynamicResource License.SettingsTitle}" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="{DynamicResource License.Status}" Style="{StaticResource ConfigLabelStyle}" />
                                <TextBlock x:Name="LicenseStatusText" TextWrapping="Wrap" FontSize="12.5" LineHeight="18" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="{DynamicResource License.MachineCode}" Style="{StaticResource ConfigLabelStyle}" />
                                <TextBox x:Name="MachineCodeBox" IsReadOnly="True" TextWrapping="Wrap" Padding="8,6" />
                            </StackPanel>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="{DynamicResource License.Mode}" Style="{StaticResource ConfigLabelStyle}" />
                                    <ComboBox x:Name="LicenseModeBox">
                                        <ComboBoxItem Content="{DynamicResource License.ModeStandalone}" Tag="Standalone" />
                                        <ComboBoxItem Content="{DynamicResource License.ModeFloating}" Tag="Floating" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="{DynamicResource License.ProductCode}" Style="{StaticResource ConfigLabelStyle}" />
                                    <TextBox x:Name="ProductCodeBox" Padding="8,6" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="{DynamicResource License.FilePath}" Style="{StaticResource ConfigLabelStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="LicenseFilePathBox" Grid.Column="0" Margin="0,0,8,0" Padding="8,6" />
                                    <Button Grid.Column="1" Style="{StaticResource AppSecondaryButtonStyle}" Click="BrowseLicenseFile_Click" Width="72" auth:PermissionAssist.PermissionKey="Button.Settings.Save">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="FolderOpen" Margin="0,0,4,0" VerticalAlignment="Center" Width="12" Height="12" />
                                            <TextBlock Text="{DynamicResource Settings.Browse}" VerticalAlignment="Center" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="{DynamicResource License.ServerUrl}" Style="{StaticResource ConfigLabelStyle}" />
                                <TextBox x:Name="LicenseServerUrlBox" Padding="8,6" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="{DynamicResource License.AccessKey}" Style="{StaticResource ConfigLabelStyle}" />
                                <PasswordBox x:Name="LicenseAccessKeyBox" Padding="8,6" />
                            </StackPanel>

                            <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="ValidateLicense_Click" HorizontalAlignment="Left" auth:PermissionAssist.PermissionKey="Button.Settings.Save">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="ShieldCheck" Margin="0,0,6,0" VerticalAlignment="Center" Width="14" Height="14" />
                                    <TextBlock Text="{DynamicResource License.Validate}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 右栏：打印默认预设与个性化基础配置 -->
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    
                    <!-- 卡片 3：打印默认预设 -->
                    <Border Style="{StaticResource AppCardStyle}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <iconPacks:PackIconMaterial Kind="PrinterSettings" Foreground="{DynamicResource PrimaryBrush}" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource ConfigTitleStyle}" Text="{DynamicResource Settings.PrintDefaults}" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="{DynamicResource Settings.DefaultPrinter}" Style="{StaticResource ConfigLabelStyle}" />
                                <ComboBox x:Name="DefaultPrinterBox"
                                          infra:SearchableComboBoxBehavior.IsEnabled="True" />
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1.2*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{DynamicResource Settings.DefaultPrintCopies}" Style="{StaticResource ConfigLabelStyle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="DefaultPrintCopiesBox" Grid.Column="0" Padding="8,6" />
                                        <TextBlock Grid.Column="1" Text="{DynamicResource Settings.CopyUnit}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12.5" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="12,0,0,8">
                                    <CheckBox x:Name="ConfirmBeforePrintBox" Content="{DynamicResource Settings.ConfirmBeforePrint}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 卡片 4：基础与个性化 -->
                    <Border Style="{StaticResource AppCardStyle}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <iconPacks:PackIconMaterial Kind="PaletteOutline" Foreground="{DynamicResource PrimaryBrush}" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource ConfigTitleStyle}" Text="{DynamicResource Settings.Personalization}" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="{DynamicResource Settings.TemplateFolder}" Style="{StaticResource ConfigLabelStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="LocalTemplateFolderBox" Grid.Column="0" Margin="0,0,8,0" Padding="8,6" />
                                    <Button Grid.Column="1" Style="{StaticResource AppSecondaryButtonStyle}" Click="BrowseTemplateFolder_Click" Width="72" auth:PermissionAssist.PermissionKey="Button.Settings.BrowseTemplateFolder">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="FolderOpen" Margin="0,0,4,0" VerticalAlignment="Center" Width="12" Height="12" />
                                            <TextBlock Text="{DynamicResource Settings.Browse}" VerticalAlignment="Center" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="{DynamicResource Settings.CurrentUser}" Style="{StaticResource ConfigLabelStyle}" />
                                <TextBox x:Name="OperatorNameBox" Padding="8,6" IsReadOnly="True" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,4">
                                <TextBlock Text="{DynamicResource Settings.ThemeMode}" Style="{StaticResource ConfigLabelStyle}" />
                                <ComboBox x:Name="ThemeModeBox" Width="200" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="{DynamicResource Settings.ThemeSystem}" Tag="System" />
                                    <ComboBoxItem Content="{DynamicResource Settings.ThemeLight}" Tag="Light" />
                                    <ComboBoxItem Content="{DynamicResource Settings.ThemeDark}" Tag="Dark" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Margin="0,12,0,4">
                                <TextBlock Text="{DynamicResource Settings.Language}" Style="{StaticResource ConfigLabelStyle}" />
                                <ComboBox x:Name="LanguageBox" Width="200" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="{DynamicResource Settings.LanguageZhCn}" Tag="ZhCn" />
                                    <ComboBoxItem Content="{DynamicResource Settings.LanguageEnUs}" Tag="EnUs" />
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 运行模式重启生效警告 -->
                    <Border CornerRadius="8" 
                            Background="#0D0066FF" 
                            BorderThickness="1,0,0,0" 
                            BorderBrush="{DynamicResource PrimaryBrush}" 
                            Padding="12" 
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconMaterial Kind="AlertCircleOutline" 
                                                       Foreground="{DynamicResource PrimaryBrush}" 
                                                       Width="16" 
                                                       Height="16" 
                                                       Margin="0,2,8,0" 
                                                       VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" 
                                       Text="{DynamicResource Settings.RestartHint}" 
                                       TextWrapping="Wrap" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                       LineHeight="18" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource AppFooterCardStyle}">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="StatusText"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="Reload_Click" Margin="0,0,8,0" auth:PermissionAssist.PermissionKey="Button.Settings.Reload">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Reload" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Settings.Reload}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppPrimaryButtonStyle}" Click="Save_Click" auth:PermissionAssist.PermissionKey="Button.Settings.Save">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ContentSave" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Settings.SaveConfig}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
