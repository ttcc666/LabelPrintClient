<UserControl x:Class="LabelPrintClient.Modules.Settings.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:infra="clr-namespace:LabelPrintClient.Infrastructure"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <UserControl.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource AppSectionTitleStyle}" />

        <Style x:Key="FormLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource AppFormLabelStyle}">
            <Setter Property="Width" Value="130" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style x:Key="FormRowStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource AppToolbarCardStyle}">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left"
                           Style="{StaticResource AppPageTitleStyle}"
                              Text="系统配置"
                              Margin="0,0,20,0" />
                <TextBlock x:Name="ConfigPathText"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource SectionTitleStyle}" Text="应用运行配置" />

            <Border Grid.Row="1" Style="{StaticResource AppCardStyle}" Padding="16" VerticalAlignment="Top">
                <Grid MaxWidth="920" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Style="{StaticResource FormRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="360" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FormLabelStyle}" Text="运行模式" />
                        <ComboBox x:Name="RunModeBox" Grid.Column="1" Width="220" HorizontalAlignment="Left">
                            <ComboBoxItem Content="LocalSqlite" Tag="LocalSqlite" />
                            <ComboBoxItem Content="LanPostgreSql" Tag="LanPostgreSql" />
                        </ComboBox>
                    </Grid>

                    <Grid Grid.Row="1" Style="{StaticResource FormRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FormLabelStyle}" Text="SQLite 连接串" />
                        <TextBox x:Name="SqliteConnectionBox" Grid.Column="1" MinWidth="520" Margin="0,0,8,0" />
                        <Button Grid.Column="2" Style="{StaticResource AppSecondaryButtonStyle}" Click="TestSqliteConnection_Click">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Connection" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="测试" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="2" Style="{StaticResource FormRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FormLabelStyle}" Text="PostgreSQL 连接串" />
                        <TextBox x:Name="PostgreSqlConnectionBox" Grid.Column="1" MinWidth="520" Margin="0,0,8,0" />
                        <Button Grid.Column="2" Style="{StaticResource AppSecondaryButtonStyle}" Click="TestPostgreSqlConnection_Click">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Connection" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="测试" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="3" Style="{StaticResource FormRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FormLabelStyle}" Text="本地模板目录" />
                        <TextBox x:Name="LocalTemplateFolderBox" Grid.Column="1" MinWidth="420" Margin="0,0,8,0" />
                        <Button Grid.Column="2" Style="{StaticResource AppSecondaryButtonStyle}" Click="BrowseTemplateFolder_Click" >
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="FolderOpen" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="浏览" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
                    </Grid>

                    <Grid Grid.Row="4" Style="{StaticResource FormRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="360" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FormLabelStyle}" Text="操作人" />
                        <TextBox x:Name="OperatorNameBox" Grid.Column="1" Width="260" HorizontalAlignment="Left" />
                    </Grid>

                    <Grid Grid.Row="5" Style="{StaticResource FormRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="360" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FormLabelStyle}" Text="默认打印机" />
                        <ComboBox x:Name="DefaultPrinterBox"
                                  Grid.Column="1"
                                  Width="300"
                                  HorizontalAlignment="Left"
                                  infra:SearchableComboBoxBehavior.IsEnabled="True" />
                    </Grid>

                    <Grid Grid.Row="6" Style="{StaticResource FormRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="360" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FormLabelStyle}" Text="默认打印" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="DefaultPrintCopiesBox" Width="80" Margin="0,0,12,0" />
                            <TextBlock Text="份" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <CheckBox x:Name="ConfirmBeforePrintBox" Content="打印前确认" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="7" Style="{StaticResource FormRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="360" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FormLabelStyle}" Text="应用主题" />
                        <ComboBox x:Name="ThemeModeBox" Grid.Column="1" Width="220" HorizontalAlignment="Left">
                            <ComboBoxItem Content="跟随系统" Tag="System" />
                            <ComboBoxItem Content="浅色" Tag="Light" />
                            <ComboBoxItem Content="深色" Tag="Dark" />
                        </ComboBox>
                    </Grid>

                    <TextBlock Grid.Row="8"
                               Margin="142,4,0,0"
                               Text="保存后会写入 appsettings.json；运行模式、连接串、模板目录等配置需要重启应用后完全生效。"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource AppFooterCardStyle}">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="StatusText"
                              DockPanel.Dock="Left"
                              VerticalAlignment="Center"
                             
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="Reload_Click" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Reload" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="重新加载" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppPrimaryButtonStyle}" Click="Save_Click">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ContentSave" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="保存配置" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>





