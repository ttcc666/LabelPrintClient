<UserControl x:Class="LabelPrintClient.Modules.Settings.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:infra="clr-namespace:LabelPrintClient.Infrastructure"
             xmlns:auth="clr-namespace:LabelPrintClient.Modules.Auth.Infrastructure"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <UserControl.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource AppSectionTitleStyle}" />

        <Style x:Key="FormLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource AppFormLabelStyle}">
            <Setter Property="Width" Value="130" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style x:Key="FormRowStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- 卡片内板块小 Title 样式 -->
        <Style x:Key="ConfigTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 表单 Label 样式 -->
        <Style x:Key="ConfigLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource AppToolbarCardStyle}">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left"
                           Style="{StaticResource AppPageTitleStyle}"
                           Text="系统配置"
                           Margin="0,0,20,0" />
                <TextBlock x:Name="ConfigPathText"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- 滚动区域包裹以适应不同分辨率 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" MinWidth="480" />
                    <ColumnDefinition Width="1*" MinWidth="380" />
                </Grid.ColumnDefinitions>

                <!-- 左栏：数据源连接与备份卡片组 -->
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    
                    <!-- 卡片 1：数据源连接配置 -->
                    <Border Style="{StaticResource AppCardStyle}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <iconPacks:PackIconMaterial Kind="Database" Foreground="{DynamicResource PrimaryBrush}" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource ConfigTitleStyle}" Text="数据源连接配置" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="运行模式" Style="{StaticResource ConfigLabelStyle}" />
                                <ComboBox x:Name="RunModeBox" Width="200" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="本地数据库 (SQLite)" Tag="LocalSqlite" />
                                    <ComboBoxItem Content="局域网服务端 (PostgreSQL)" Tag="LanPostgreSql" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="SQLite 连接串" Style="{StaticResource ConfigLabelStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SqliteConnectionBox" Grid.Column="0" Margin="0,0,8,0" Padding="8,6" />
                                    <Button Grid.Column="1" Style="{StaticResource AppSecondaryButtonStyle}" Click="TestSqliteConnection_Click" Width="72" auth:PermissionAssist.PermissionKey="Button.Settings.TestConnection">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Connection" Margin="0,0,4,0" VerticalAlignment="Center" Width="12" Height="12" />
                                            <TextBlock Text="测试" VerticalAlignment="Center" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,4">
                                <TextBlock Text="PostgreSQL 连接串" Style="{StaticResource ConfigLabelStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PostgreSqlConnectionBox" Grid.Column="0" Margin="0,0,8,0" Padding="8,6" />
                                    <Button Grid.Column="1" Style="{StaticResource AppSecondaryButtonStyle}" Click="TestPostgreSqlConnection_Click" Width="72" auth:PermissionAssist.PermissionKey="Button.Settings.TestConnection">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Connection" Margin="0,0,4,0" VerticalAlignment="Center" Width="12" Height="12" />
                                            <TextBlock Text="测试" VerticalAlignment="Center" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 卡片 2：数据备份与恢复 -->
                    <Border Style="{StaticResource AppCardStyle}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <iconPacks:PackIconMaterial Kind="ArchiveOutline" Foreground="{DynamicResource PrimaryBrush}" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource ConfigTitleStyle}" Text="数据备份 / 恢复" />
                            </StackPanel>

                            <TextBlock x:Name="BackupModeText"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       LineHeight="18"
                                       Margin="0,0,0,16" />

                            <WrapPanel HorizontalAlignment="Left">
                                <Button x:Name="BackupDataButton"
                                        Style="{StaticResource AppSecondaryButtonStyle}"
                                        Click="BackupData_Click"
                                        Margin="0,0,12,0"
                                        auth:PermissionAssist.PermissionKey="Button.Settings.Backup">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="ArchiveArrowDownOutline" Margin="0,0,6,0" VerticalAlignment="Center" Width="14" Height="14" />
                                        <TextBlock Text="一键备份" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RestoreDataButton"
                                        Style="{StaticResource AppDangerButtonStyle}"
                                        Click="RestoreData_Click"
                                        auth:PermissionAssist.PermissionKey="Button.Settings.Restore">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="ArchiveArrowUpOutline" Margin="0,0,6,0" VerticalAlignment="Center" Width="14" Height="14" />
                                        <TextBlock Text="恢复备份" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 右栏：打印默认预设与个性化基础配置 -->
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    
                    <!-- 卡片 3：打印默认预设 -->
                    <Border Style="{StaticResource AppCardStyle}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <iconPacks:PackIconMaterial Kind="PrinterSettings" Foreground="{DynamicResource PrimaryBrush}" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource ConfigTitleStyle}" Text="打印默认预设" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="默认物理打印机" Style="{StaticResource ConfigLabelStyle}" />
                                <ComboBox x:Name="DefaultPrinterBox"
                                          infra:SearchableComboBoxBehavior.IsEnabled="True" />
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1.2*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="默认打印份数" Style="{StaticResource ConfigLabelStyle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="DefaultPrintCopiesBox" Grid.Column="0" Padding="8,6" />
                                        <TextBlock Grid.Column="1" Text="份" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12.5" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="12,0,0,8">
                                    <CheckBox x:Name="ConfirmBeforePrintBox" Content="物理打印前进行弹窗确认" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 卡片 4：基础与个性化 -->
                    <Border Style="{StaticResource AppCardStyle}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <iconPacks:PackIconMaterial Kind="PaletteOutline" Foreground="{DynamicResource PrimaryBrush}" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource ConfigTitleStyle}" Text="基础与个性化" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="本地模板保存目录" Style="{StaticResource ConfigLabelStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="LocalTemplateFolderBox" Grid.Column="0" Margin="0,0,8,0" Padding="8,6" />
                                    <Button Grid.Column="1" Style="{StaticResource AppSecondaryButtonStyle}" Click="BrowseTemplateFolder_Click" Width="72" auth:PermissionAssist.PermissionKey="Button.Settings.BrowseTemplateFolder">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="FolderOpen" Margin="0,0,4,0" VerticalAlignment="Center" Width="12" Height="12" />
                                            <TextBlock Text="浏览" VerticalAlignment="Center" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="当前登录用户" Style="{StaticResource ConfigLabelStyle}" />
                                <TextBox x:Name="OperatorNameBox" Padding="8,6" IsReadOnly="True" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,4">
                                <TextBlock Text="应用主题方式" Style="{StaticResource ConfigLabelStyle}" />
                                <ComboBox x:Name="ThemeModeBox" Width="200" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="跟随系统" Tag="System" />
                                    <ComboBoxItem Content="优雅浅色" Tag="Light" />
                                    <ComboBoxItem Content="深邃暗色" Tag="Dark" />
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 运行模式重启生效警告 -->
                    <Border CornerRadius="8" 
                            Background="#0D0066FF" 
                            BorderThickness="1,0,0,0" 
                            BorderBrush="{DynamicResource PrimaryBrush}" 
                            Padding="12" 
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconMaterial Kind="AlertCircleOutline" 
                                                       Foreground="{DynamicResource PrimaryBrush}" 
                                                       Width="16" 
                                                       Height="16" 
                                                       Margin="0,2,8,0" 
                                                       VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" 
                                       Text="保存后会写入 appsettings.json；运行模式、连接串、模板目录等配置需要重启应用后完全生效。" 
                                       TextWrapping="Wrap" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                       LineHeight="18" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource AppFooterCardStyle}">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="StatusText"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="Reload_Click" Margin="0,0,8,0" auth:PermissionAssist.PermissionKey="Button.Settings.Reload">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Reload" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="重新加载" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppPrimaryButtonStyle}" Click="Save_Click" auth:PermissionAssist.PermissionKey="Button.Settings.Save">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ContentSave" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="保存配置" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
