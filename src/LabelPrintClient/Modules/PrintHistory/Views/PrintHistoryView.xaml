<UserControl x:Class="LabelPrintClient.Modules.PrintHistory.Views.PrintHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:infra="clr-namespace:LabelPrintClient.Infrastructure"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <UserControl.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource AppSectionTitleStyle}" />

        <Style x:Key="FormLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource AppFormLabelStyle}" />
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource AppToolbarCardStyle}">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{StaticResource AppPageTitleStyle}" Text="打印记录" Margin="0,0,12,0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource FormLabelStyle}" Text="状态" />
                    <ComboBox x:Name="StatusFilterBox" Width="96" SelectedIndex="0" SelectionChanged="Filter_Changed" Margin="0">
                        <ComboBoxItem Content="全部" />
                        <ComboBoxItem Content="已打印" Tag="Printed" />
                        <ComboBoxItem Content="失败" Tag="Failed" />
                        <ComboBoxItem Content="打印中" Tag="Printing" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource FormLabelStyle}" Text="打印机" />
                    <ComboBox x:Name="PrinterNameBox"
                              Width="180"
                              infra:SearchableComboBoxBehavior.IsEnabled="True"
                              Margin="0" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource FormLabelStyle}" Text="份数" />
                    <TextBox x:Name="PrintCopiesBox" Width="56" Text="1" Margin="0" />
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Style="{StaticResource FormLabelStyle}" Text="关键词" />
                    <TextBox x:Name="JobSearchBox"
                             MinWidth="80"
                             MaxWidth="130"
                             Width="130"
                             VerticalAlignment="Center"
                             KeyDown="JobSearchBox_KeyDown" />
                </StackPanel>

                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="JobFilter_Click" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Magnify" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="查询" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppGhostButtonStyle}" Click="ClearJobFilter_Click" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="FilterRemoveOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="清空" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppSecondaryButtonStyle}" Click="Refresh_Click" Margin="0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Refresh" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="刷新" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" MinHeight="200" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1*" MinHeight="200" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="打印任务" Margin="4,0,0,0" />
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource AppDataCardStyle}" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="JobGrid" Grid.Row="0"
                                     SelectionChanged="JobGrid_SelectionChanged"
                                     AutoGenerateColumns="False"
                                     IsReadOnly="True"
                                     Margin="0"
                                     BorderThickness="0"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="操作" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Style="{StaticResource AppSecondaryButtonStyle}" Height="28" Click="RetryJob_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <iconPacks:PackIconMaterial Kind="Reload" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="重试" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="状态" Width="96" SortMemberPath="Status">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentControl Content="{Binding StatusText}" ContentTemplate="{StaticResource AppStatusBadgeTemplate}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="创建时间" Binding="{Binding CreateTime, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}" Width="170" />
                                <DataGridTextColumn Header="打印时间" Binding="{Binding PrintTime, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}" Width="170" />
                                <DataGridTextColumn Header="模板名称" Binding="{Binding TemplateName}" Width="160" />
                                <DataGridTextColumn Header="打印张数" Binding="{Binding SelectedRowCount}" Width="80" />
                                <DataGridTextColumn Header="打印机" Binding="{Binding PrinterNameText}" Width="150" />
                                <DataGridTextColumn Header="操作人" Binding="{Binding OperatorName}" Width="100" />
                                <DataGridTextColumn Header="错误信息" Binding="{Binding ErrorMessage}" Width="*" MinWidth="180" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="1" Padding="0,8,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="8,8,8,8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="每页" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ComboBox x:Name="JobPageSizeBox" Width="68" SelectedIndex="1" SelectionChanged="JobPageSizeBox_SelectionChanged" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <ComboBoxItem Content="10" />
                                    <ComboBoxItem Content="20" />
                                    <ComboBoxItem Content="50" />
                                </ComboBox>
                                <Button x:Name="JobFirstPageButton" Style="{StaticResource PagerButtonStyle}" Click="JobFirstPage_Click">
                                    <iconPacks:PackIconMaterial Kind="PageFirst" Width="16" Height="16" />
                                </Button>
                                <Button x:Name="JobPrevPageButton" Style="{StaticResource PagerButtonStyle}" Click="JobPrevPage_Click">
                                    <iconPacks:PackIconMaterial Kind="ChevronLeft" Width="16" Height="16" />
                                </Button>
                                <TextBlock x:Name="JobPageInfoText" VerticalAlignment="Center" MinWidth="70" TextAlignment="Center" FontWeight="SemiBold" />
                                <Button x:Name="JobNextPageButton" Style="{StaticResource PagerButtonStyle}" Click="JobNextPage_Click">
                                    <iconPacks:PackIconMaterial Kind="ChevronRight" Width="16" Height="16" />
                                </Button>
                                <Button x:Name="JobLastPageButton" Style="{StaticResource PagerButtonStyle}" Click="JobLastPage_Click">
                                    <iconPacks:PackIconMaterial Kind="PageLast" Width="16" Height="16" />
                                </Button>
                            </StackPanel>
                        </Border>
                        <!-- 任务加载遮罩层 -->
                        <Grid x:Name="JobLoadingOverlay" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed">
                            <Border Background="{DynamicResource RegionBrush}" Opacity="0.75" CornerRadius="6" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <hc:LoadingCircle Width="36" Height="36" Foreground="{DynamicResource PrimaryBrush}" />
                                <TextBlock Text="正在读取打印任务..." Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                            </StackPanel>
                        </Grid>
                        <!-- 暂无打印任务空状态 -->
                        <StackPanel Grid.Row="0"
                                    Style="{StaticResource AppDataGridEmptyStatePanelStyle}"
                                    Visibility="{Binding Visibility, ElementName=JobEmptyText}">
                            <Border Style="{StaticResource AppEmptyStateIconFrameStyle}">
                                <iconPacks:PackIconMaterial Kind="History" Style="{StaticResource AppEmptyStateIconStyle}" />
                            </Border>
                            <TextBlock x:Name="JobEmptyText"
                                       Text="暂无打印任务"
                                       Style="{StaticResource AppEmptyStateTitleStyle}"
                                       Visibility="Collapsed" />
                            <TextBlock Text="完成预览、打印或重试后，任务记录会出现在这里。"
                                       Style="{StaticResource AppEmptyStateHintStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Row="1" Style="{StaticResource AppRowResizeSplitterStyle}" Margin="0,2" />

            <Grid Grid.Row="2" Margin="0,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource SectionTitleStyle}" Text="打印明细" Margin="4,0,16,0" />
                    <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource FormLabelStyle}" Text="关键词" />
                            <TextBox x:Name="RowSearchBox"
                                     Width="180"
                                     VerticalAlignment="Center"
                                     KeyDown="RowSearchBox_KeyDown" />
                        </StackPanel>
                        <Button  Style="{StaticResource AppSecondaryButtonStyle}" Click="RowFilter_Click" Margin="0,0,8,0">
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="Magnify" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="查询" VerticalAlignment="Center" />
        </StackPanel>
    </Button>
                        <Button  Style="{StaticResource AppGhostButtonStyle}" Click="ClearRowFilter_Click">
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="FilterRemoveOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="清空" VerticalAlignment="Center" />
        </StackPanel>
    </Button>
                    </WrapPanel>
                </DockPanel>

                <Border Grid.Row="1" Style="{StaticResource AppDataCardStyle}" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="RowGrid" Grid.Row="0"
                                     AutoGenerateColumns="False"
                                     IsReadOnly="True"
                                     Margin="0"
                                     BorderThickness="0"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto" />
                        <StackPanel Grid.Row="0"
                                    Style="{StaticResource AppDataGridEmptyStatePanelStyle}"
                                    Visibility="{Binding Visibility, ElementName=RowEmptyText}">
                            <Border Style="{StaticResource AppEmptyStateIconFrameStyle}">
                                <iconPacks:PackIconMaterial Kind="FormatListText" Style="{StaticResource AppEmptyStateIconStyle}" />
                            </Border>
                            <TextBlock x:Name="RowEmptyText"
                                       Text="请选择打印任务查看明细"
                                       Style="{StaticResource AppEmptyStateTitleStyle}"
                                       Visibility="Collapsed" />
                            <TextBlock Text="选择打印任务后，可查看本次任务包含的历史打印行。"
                                       Style="{StaticResource AppEmptyStateHintStyle}" />
                        </StackPanel>
                        <Border Grid.Row="1" Padding="0,8,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="8,8,8,8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="每页" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ComboBox x:Name="RowPageSizeBox" Width="68" SelectedIndex="1" SelectionChanged="RowPageSizeBox_SelectionChanged" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <ComboBoxItem Content="20" />
                                    <ComboBoxItem Content="50" />
                                    <ComboBoxItem Content="100" />
                                    <ComboBoxItem Content="200" />
                                </ComboBox>
                                <Button x:Name="RowFirstPageButton" Style="{StaticResource PagerButtonStyle}" Click="RowFirstPage_Click">
                                    <iconPacks:PackIconMaterial Kind="PageFirst" Width="16" Height="16" />
                                </Button>
                                <Button x:Name="RowPrevPageButton" Style="{StaticResource PagerButtonStyle}" Click="RowPrevPage_Click">
                                    <iconPacks:PackIconMaterial Kind="ChevronLeft" Width="16" Height="16" />
                                </Button>
                                <TextBlock x:Name="RowPageInfoText" VerticalAlignment="Center" MinWidth="70" TextAlignment="Center" FontWeight="SemiBold" />
                                <Button x:Name="RowNextPageButton" Style="{StaticResource PagerButtonStyle}" Click="RowNextPage_Click">
                                    <iconPacks:PackIconMaterial Kind="ChevronRight" Width="16" Height="16" />
                                </Button>
                                <Button x:Name="RowLastPageButton" Style="{StaticResource PagerButtonStyle}" Click="RowLastPage_Click">
                                    <iconPacks:PackIconMaterial Kind="PageLast" Width="16" Height="16" />
                                </Button>
                            </StackPanel>
                        </Border>
                        <!-- 明细加载遮罩层 -->
                        <Grid x:Name="RowLoadingOverlay" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed">
                            <Border Background="{DynamicResource RegionBrush}" Opacity="0.75" CornerRadius="6" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <hc:LoadingCircle Width="36" Height="36" Foreground="{DynamicResource PrimaryBrush}" />
                                <TextBlock Text="正在加载明细..." Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>


        <Border Grid.Row="2" Style="{StaticResource AppFooterCardStyle}">
            <TextBlock x:Name="HistorySummaryText"
                          VerticalAlignment="Center"

                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Border>
    </Grid>
</UserControl>
