<UserControl x:Class="LabelPrintClient.Modules.PrintHistory.Views.PrintHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:infra="clr-namespace:LabelPrintClient.Infrastructure"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <UserControl.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">

            <Setter Property="Margin" Value="4,0,0,8" />
        </Style>

        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource RegionBrush}" CornerRadius="4" Grid.Row="0" Margin="0,0,0,8" Padding="10">
            <DockPanel LastChildFill="False">
                <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="打印记录" VerticalAlignment="Center" Margin="0,0,20,0" />
                    <TextBlock Style="{StaticResource FormLabelStyle}" Text="状态" />
                    <ComboBox x:Name="StatusFilterBox" Width="120" SelectedIndex="0" SelectionChanged="Filter_Changed" Margin="0,0,16,0">
                        <ComboBoxItem Content="全部" />
                        <ComboBoxItem Content="已打印" Tag="Printed" />
                        <ComboBoxItem Content="失败" Tag="Failed" />
                        <ComboBoxItem Content="打印中" Tag="Printing" />
                    </ComboBox>
                    <TextBlock Style="{StaticResource FormLabelStyle}" Text="打印机" />
                    <ComboBox x:Name="PrinterNameBox"
                              Width="220"
                              infra:SearchableComboBoxBehavior.IsEnabled="True"
                              Margin="0,0,16,0" />
                    <TextBlock Style="{StaticResource FormLabelStyle}" Text="份数" />
                    <TextBox x:Name="PrintCopiesBox" Width="72" Text="1" Margin="0,0,16,0" />
                    <TextBox x:Name="JobSearchBox"
                                Width="180"
                               
                                Margin="0,0,8,0"
                                KeyDown="JobSearchBox_KeyDown" />
                    <Button  Style="{StaticResource ButtonPrimary}" Click="JobFilter_Click" Margin="0,0,8,0" >
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="Magnify" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="查询" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
                    <Button  Style="{StaticResource ButtonDanger}" Click="ClearJobFilter_Click" >
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="FilterRemoveOutline" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="清空" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
                </WrapPanel>

                <Button DockPanel.Dock="Right"
                           
                          
                           Click="Refresh_Click" >
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="Refresh" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="刷新" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" MinHeight="180" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1.4*" MinHeight="220" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="打印任务" Margin="4,0,0,0" />
                </Grid>

                <Border Background="{DynamicResource RegionBrush}" CornerRadius="4" Grid.Row="1" Padding="0" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="JobGrid" Grid.Row="0"
                                     SelectionChanged="JobGrid_SelectionChanged"
                                     AutoGenerateColumns="False"
                                     IsReadOnly="True"
                                     Margin="0"
                                     BorderThickness="0"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="操作" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button  Style="{StaticResource ButtonPrimary}" Height="28" Margin="0,0,6,0" Click="ReprintJob_Click" >
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="PrinterAlert" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="重打" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
                                                <Button  Height="28" Click="RetryJob_Click" >
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="Reload" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="重试" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="90" />
                                <DataGridTextColumn Header="创建时间" Binding="{Binding CreateTime, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}" Width="170" />
                                <DataGridTextColumn Header="打印时间" Binding="{Binding PrintTime, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}" Width="170" />
                                <DataGridTextColumn Header="模板名称" Binding="{Binding TemplateName}" Width="160" />
                                <DataGridTextColumn Header="打印张数" Binding="{Binding SelectedRowCount}" Width="80" />
                                <DataGridTextColumn Header="打印机" Binding="{Binding PrinterNameText}" Width="150" />
                                <DataGridTextColumn Header="操作人" Binding="{Binding OperatorName}" Width="100" />
                                <DataGridTextColumn Header="错误信息" Binding="{Binding ErrorMessage}" Width="*" MinWidth="180" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="1" Padding="0,8,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="8,8,8,8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="每页" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ComboBox x:Name="JobPageSizeBox" Width="68" SelectedIndex="1" SelectionChanged="JobPageSizeBox_SelectionChanged" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <ComboBoxItem Content="10" />
                                    <ComboBoxItem Content="20" />
                                    <ComboBoxItem Content="50" />
                                </ComboBox>
                                <Button x:Name="JobFirstPageButton" Content="&lt;&lt;" Style="{StaticResource PagerButtonStyle}" Click="JobFirstPage_Click" />
                                <Button x:Name="JobPrevPageButton" Content="&lt;" Style="{StaticResource PagerButtonStyle}" Click="JobPrevPage_Click" />
                                <TextBlock x:Name="JobPageInfoText" VerticalAlignment="Center" MinWidth="70" TextAlignment="Center" FontWeight="SemiBold" />
                                <Button x:Name="JobNextPageButton" Content="&gt;" Style="{StaticResource PagerButtonStyle}" Click="JobNextPage_Click" />
                                <Button x:Name="JobLastPageButton" Content="&gt;&gt;" Style="{StaticResource PagerButtonStyle}" Click="JobLastPage_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent" Cursor="SizeNS" Margin="0,2" />

            <Grid Grid.Row="2" Margin="0,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource SectionTitleStyle}" Text="打印明细" Margin="4,0,16,0" />
                    <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <TextBox x:Name="RowSearchBox"
                                    Width="180"
                                   
                                    Margin="0,0,8,0"
                                    KeyDown="RowSearchBox_KeyDown" />
                        <Button  Style="{StaticResource ButtonPrimary}" Click="RowFilter_Click" Margin="0,0,8,0" >
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="Magnify" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="查询" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
                        <Button  Style="{StaticResource ButtonDanger}" Click="ClearRowFilter_Click" >
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="FilterRemoveOutline" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="清空" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
                    </WrapPanel>
                </DockPanel>

                <Border Background="{DynamicResource RegionBrush}" CornerRadius="4" Grid.Row="1" Padding="0" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="RowGrid" Grid.Row="0"
                                     AutoGenerateColumns="False"
                                     IsReadOnly="True"
                                     Margin="0"
                                     BorderThickness="0"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto" />
                        <TextBlock x:Name="RowEmptyText"
                                   Grid.Row="0"
                                   Text="请选择打印任务查看明细"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="Collapsed" />
                        <Border Grid.Row="1" Padding="0,8,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="8,8,8,8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="每页" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ComboBox x:Name="RowPageSizeBox" Width="68" SelectedIndex="1" SelectionChanged="RowPageSizeBox_SelectionChanged" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <ComboBoxItem Content="20" />
                                    <ComboBoxItem Content="50" />
                                    <ComboBoxItem Content="100" />
                                    <ComboBoxItem Content="200" />
                                </ComboBox>
                                <Button x:Name="RowFirstPageButton" Content="&lt;&lt;" Style="{StaticResource PagerButtonStyle}" Click="RowFirstPage_Click" />
                                <Button x:Name="RowPrevPageButton" Content="&lt;" Style="{StaticResource PagerButtonStyle}" Click="RowPrevPage_Click" />
                                <TextBlock x:Name="RowPageInfoText" VerticalAlignment="Center" MinWidth="70" TextAlignment="Center" FontWeight="SemiBold" />
                                <Button x:Name="RowNextPageButton" Content="&gt;" Style="{StaticResource PagerButtonStyle}" Click="RowNextPage_Click" />
                                <Button x:Name="RowLastPageButton" Content="&gt;&gt;" Style="{StaticResource PagerButtonStyle}" Click="RowLastPage_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <TextBlock x:Name="JobEmptyText"
                   Grid.Row="1"
                   Text="暂无打印任务"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Visibility="Collapsed"
                   IsHitTestVisible="False" />

        <Border Background="{DynamicResource RegionBrush}" CornerRadius="4" Grid.Row="2" Padding="10" Margin="0,8,0,0">
            <TextBlock x:Name="HistorySummaryText"
                          VerticalAlignment="Center"
                         
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Border>
    </Grid>
</UserControl>





