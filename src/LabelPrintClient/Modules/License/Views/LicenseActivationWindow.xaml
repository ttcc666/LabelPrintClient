<hc:Window x:Class="LabelPrintClient.Modules.License.Views.LicenseActivationWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
           Title="{DynamicResource License.WindowTitle}"
           Width="560"
           Height="560"
           MinHeight="520"
           WindowStartupLocation="CenterScreen"
           ResizeMode="CanResize"
           Foreground="{DynamicResource PrimaryTextBrush}">
    <hc:Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFF2F5FA" Offset="0.0"/>
            <GradientStop Color="#FFFFFFFF" Offset="0.6"/>
            <GradientStop Color="#FFEAF0FB" Offset="1.0"/>
        </LinearGradientBrush>
    </hc:Window.Background>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <Border Width="46" Height="46" CornerRadius="10" Margin="0,0,12,0" VerticalAlignment="Center" Background="#120066FF">
                <iconPacks:PackIconMaterial Kind="ShieldKey" Width="22" Height="22" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource License.Title}" Style="{StaticResource AppPageTitleStyle}" FontSize="18" FontWeight="Bold" Margin="0,0,0,3" />
                <TextBlock Text="{DynamicResource License.Hint}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border CornerRadius="8" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource PrimaryBrush}" Background="#0D0066FF" Padding="12" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource License.MachineCode}" Style="{StaticResource AppFormLabelStyle}" Margin="0,0,0,6" FontWeight="SemiBold" />
                        <TextBox x:Name="MachineCodeBox" IsReadOnly="True" TextWrapping="Wrap" Padding="8,6" />
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="{DynamicResource License.Mode}" Style="{StaticResource AppFormLabelStyle}" Margin="0,0,0,6" FontWeight="SemiBold" />
                    <ComboBox x:Name="LicenseModeBox" Width="220" HorizontalAlignment="Left" SelectionChanged="LicenseModeBox_SelectionChanged">
                        <ComboBoxItem Content="{DynamicResource License.ModeStandalone}" Tag="Standalone" />
                        <ComboBoxItem Content="{DynamicResource License.ModeFloating}" Tag="Floating" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="{DynamicResource License.ProductCode}" Style="{StaticResource AppFormLabelStyle}" Margin="0,0,0,6" FontWeight="SemiBold" />
                    <TextBox x:Name="ProductCodeBox" Padding="8,6" />
                </StackPanel>

                <StackPanel x:Name="StandalonePanel" Margin="0,0,0,14">
                    <TextBlock Text="{DynamicResource License.FilePath}" Style="{StaticResource AppFormLabelStyle}" Margin="0,0,0,6" FontWeight="SemiBold" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="LicenseFilePathBox" Grid.Column="0" Margin="0,0,8,0" Padding="8,6" />
                        <Button Grid.Column="1" Width="86" Style="{StaticResource AppSecondaryButtonStyle}" Click="BrowseLicenseFile_Click">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="FolderOpen" Width="13" Height="13" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Settings.Browse}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="FloatingServerPanel" Margin="0,0,0,14">
                    <TextBlock Text="{DynamicResource License.ServerUrl}" Style="{StaticResource AppFormLabelStyle}" Margin="0,0,0,6" FontWeight="SemiBold" />
                    <TextBox x:Name="LicenseServerUrlBox" Padding="8,6" />
                </StackPanel>

                <StackPanel x:Name="FloatingKeyPanel" Margin="0,0,0,14">
                    <TextBlock Text="{DynamicResource License.AccessKey}" Style="{StaticResource AppFormLabelStyle}" Margin="0,0,0,6" FontWeight="SemiBold" />
                    <PasswordBox x:Name="LicenseAccessKeyBox" Padding="8,6" />
                </StackPanel>

                <!-- 高科技磨砂警示卡片 -->
                <Border x:Name="StatusBorder" CornerRadius="6" Background="#0DFD4E4E" BorderThickness="1" BorderBrush="#26FD4E4E" Padding="12,10" Margin="0,10,0,0" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <iconPacks:PackIconMaterial Kind="AlertCircle" Grid.Column="0" Width="16" Height="16" Foreground="{DynamicResource AppDangerBrush}" Margin="0,0,8,0" VerticalAlignment="Top" />
                        <TextBlock x:Name="StatusText" Grid.Column="1" Foreground="{DynamicResource AppDangerBrush}" TextWrapping="Wrap" FontSize="12" LineHeight="16" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Width="105" Style="{StaticResource AppDialogCancelButtonStyle}" Click="Cancel_Click" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Common.Exit}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Width="145" Style="{StaticResource AppDialogPrimaryButtonStyle}" Click="Validate_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="ShieldCheck" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource License.Validate}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</hc:Window>
