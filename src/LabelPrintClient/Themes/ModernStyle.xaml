<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">

    <Color x:Key="AppSuccessColor">#16803C</Color>
    <Color x:Key="AppInfoColor">#2563EB</Color>
    <Color x:Key="AppWarningColor">#B45309</Color>
    <Color x:Key="AppDangerColor">#C42B1C</Color>
    <Color x:Key="AppNeutralColor">#6B7280</Color>

    <SolidColorBrush x:Key="AppSuccessBrush" Color="{StaticResource AppSuccessColor}" />
    <SolidColorBrush x:Key="AppInfoBrush" Color="{StaticResource AppInfoColor}" />
    <SolidColorBrush x:Key="AppWarningBrush" Color="{StaticResource AppWarningColor}" />
    <SolidColorBrush x:Key="AppDangerBrush" Color="{StaticResource AppDangerColor}" />
    <SolidColorBrush x:Key="AppNeutralBrush" Color="{StaticResource AppNeutralColor}" />

    <SolidColorBrush x:Key="AppSuccessSubtleBrush" Color="#2216803C" />
    <SolidColorBrush x:Key="AppInfoSubtleBrush" Color="#222563EB" />
    <SolidColorBrush x:Key="AppWarningSubtleBrush" Color="#22B45309" />
    <SolidColorBrush x:Key="AppDangerSubtleBrush" Color="#22C42B1C" />
    <SolidColorBrush x:Key="AppNeutralSubtleBrush" Color="#226B7280" />
    <SolidColorBrush x:Key="AppDataGridDividerBrush" Color="#1F808080" />
    <SolidColorBrush x:Key="AppDataGridHeaderBrush" Color="#0A808080" />
    <SolidColorBrush x:Key="AppDataGridHoverBrush" Color="#142563EB" />
    <SolidColorBrush x:Key="AppDataGridSelectedBrush" Color="#1F2563EB" />

    <!-- 全局 DataGridTextColumn 的文本显示 ElementStyle -->
    <Style x:Key="AppDataGridTextColumnElementStyle" TargetType="TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
    </Style>

    <Style x:Key="AppPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <Style x:Key="AppSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="4,0,0,8" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <Style x:Key="AppMutedTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="AppFormLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource AppMutedTextStyle}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style x:Key="AppCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style x:Key="AppToolbarCardStyle" TargetType="Border" BasedOn="{StaticResource AppCardStyle}">
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="AppDataCardStyle" TargetType="Border" BasedOn="{StaticResource AppCardStyle}">
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="AppFooterCardStyle" TargetType="Border" BasedOn="{StaticResource AppCardStyle}">
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,10,0,0" />
    </Style>

    <!-- 全局现代物理按钮动效基础样式 -->
    <Style x:Key="AppButtonBaseStyle" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <Border.RenderTransform>
                            <TranslateTransform Y="0" />
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect x:Name="Shadow" Color="#000000" BlurRadius="6" ShadowDepth="1.5" Opacity="0.08" Direction="270" />
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 悬浮微移、阴影放大 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         To="-1.5" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                         Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                                         To="10" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                         Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                         To="0.14" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         To="0" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                         Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                                         To="6" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                         Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                         To="0.08" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- 物理回弹下压 -->
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         To="0.5" Duration="0:0:0.04" />
                                        <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                         Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                                         To="3" Duration="0:0:0.04" />
                                        <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                         Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                         To="0.04" Duration="0:0:0.04" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         To="-1.5" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                         Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                                         To="10" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                         Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                         To="0.14" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- 禁用灰色 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlFillColorDisabledBrush}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            <Setter TargetName="ButtonBorder" Property="Effect" Value="{x:Null}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 主按钮样式：立体靛蓝渐变 -->
    <Style x:Key="AppPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonBaseStyle}">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF3A5CE5" Offset="0" />
                    <GradientStop Color="#FF1F40B3" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 危险/警告按钮样式：高雅红渐变 -->
    <Style x:Key="AppDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonBaseStyle}">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFE24C4C" Offset="0" />
                    <GradientStop Color="#FFC12D2D" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 成功按钮样式：森林绿渐变 -->
    <Style x:Key="AppSuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonBaseStyle}">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF2CB572" Offset="0" />
                    <GradientStop Color="#FF1B824F" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style x:Key="AppGhostButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="AppDialogCancelButtonStyle" TargetType="Button" BasedOn="{StaticResource AppSecondaryButtonStyle}">
        <Setter Property="Width" Value="84" />
    </Style>

    <Style x:Key="AppDialogPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
        <Setter Property="Width" Value="84" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style x:Key="AppPagerIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="PagerButtonStyle" TargetType="Button" BasedOn="{StaticResource AppPagerIconButtonStyle}" />

    <Style x:Key="AppStatusBadgeStyle" TargetType="Border">
        <Setter Property="MinWidth" Value="56" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource AppNeutralSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppNeutralBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding}" Value="Imported">
                <Setter Property="Background" Value="{StaticResource AppSuccessSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AppSuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="已导入">
                <Setter Property="Background" Value="{StaticResource AppSuccessSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AppSuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="Printed">
                <Setter Property="Background" Value="{StaticResource AppSuccessSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AppSuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="已打印">
                <Setter Property="Background" Value="{StaticResource AppSuccessSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AppSuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="Completed">
                <Setter Property="Background" Value="{StaticResource AppSuccessSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AppSuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="已完成">
                <Setter Property="Background" Value="{StaticResource AppSuccessSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AppSuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="Printing">
                <Setter Property="Background" Value="{StaticResource AppInfoSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AppInfoBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="打印中">
                <Setter Property="Background" Value="{StaticResource AppInfoSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AppInfoBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="Running">
                <Setter Property="Background" Value="{StaticResource AppInfoSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AppInfoBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="执行中">
                <Setter Property="Background" Value="{StaticResource AppInfoSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AppInfoBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="Preview">
                <Setter Property="Background" Value="{StaticResource AppInfoSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AppInfoBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="预览">
                <Setter Property="Background" Value="{StaticResource AppInfoSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AppInfoBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="Pending">
                <Setter Property="Background" Value="{StaticResource AppWarningSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AppWarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="等待中">
                <Setter Property="Background" Value="{StaticResource AppWarningSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AppWarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="Failed">
                <Setter Property="Background" Value="{StaticResource AppDangerSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AppDangerBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="失败">
                <Setter Property="Background" Value="{StaticResource AppDangerSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AppDangerBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="PartError">
                <Setter Property="Background" Value="{StaticResource AppDangerSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AppDangerBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="部分错误">
                <Setter Property="Background" Value="{StaticResource AppDangerSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AppDangerBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="Voided">
                <Setter Property="Background" Value="{StaticResource AppNeutralSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AppNeutralBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="已作废">
                <Setter Property="Background" Value="{StaticResource AppNeutralSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AppNeutralBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="Canceled">
                <Setter Property="Background" Value="{StaticResource AppNeutralSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AppNeutralBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="已取消">
                <Setter Property="Background" Value="{StaticResource AppNeutralSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AppNeutralBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AppStatusBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource AppNeutralBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding}" Value="Imported">
                <Setter Property="Foreground" Value="{StaticResource AppSuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="已导入">
                <Setter Property="Foreground" Value="{StaticResource AppSuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="Printed">
                <Setter Property="Foreground" Value="{StaticResource AppSuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="已打印">
                <Setter Property="Foreground" Value="{StaticResource AppSuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="Completed">
                <Setter Property="Foreground" Value="{StaticResource AppSuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="已完成">
                <Setter Property="Foreground" Value="{StaticResource AppSuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="Printing">
                <Setter Property="Foreground" Value="{StaticResource AppInfoBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="打印中">
                <Setter Property="Foreground" Value="{StaticResource AppInfoBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="Running">
                <Setter Property="Foreground" Value="{StaticResource AppInfoBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="执行中">
                <Setter Property="Foreground" Value="{StaticResource AppInfoBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="Preview">
                <Setter Property="Foreground" Value="{StaticResource AppInfoBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="预览">
                <Setter Property="Foreground" Value="{StaticResource AppInfoBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="Pending">
                <Setter Property="Foreground" Value="{StaticResource AppWarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="等待中">
                <Setter Property="Foreground" Value="{StaticResource AppWarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="Failed">
                <Setter Property="Foreground" Value="{StaticResource AppDangerBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="失败">
                <Setter Property="Foreground" Value="{StaticResource AppDangerBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="PartError">
                <Setter Property="Foreground" Value="{StaticResource AppDangerBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="部分错误">
                <Setter Property="Foreground" Value="{StaticResource AppDangerBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="AppStatusBadgeTemplate">
        <Border Style="{StaticResource AppStatusBadgeStyle}">
            <TextBlock x:Name="BadgeText" Text="{Binding}" Style="{StaticResource AppStatusBadgeTextStyle}" />
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding}" Value="Imported">
                <Setter TargetName="BadgeText" Property="Text" Value="已导入" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="PartError">
                <Setter TargetName="BadgeText" Property="Text" Value="部分错误" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="Voided">
                <Setter TargetName="BadgeText" Property="Text" Value="已作废" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="Printed">
                <Setter TargetName="BadgeText" Property="Text" Value="已打印" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="Printing">
                <Setter TargetName="BadgeText" Property="Text" Value="打印中" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="Preview">
                <Setter TargetName="BadgeText" Property="Text" Value="预览" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="Failed">
                <Setter TargetName="BadgeText" Property="Text" Value="失败" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="Pending">
                <Setter TargetName="BadgeText" Property="Text" Value="等待中" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="Running">
                <Setter TargetName="BadgeText" Property="Text" Value="执行中" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="Completed">
                <Setter TargetName="BadgeText" Property="Text" Value="已完成" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="Canceled">
                <Setter TargetName="BadgeText" Property="Text" Value="已取消" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="AppEmptyStateTextStyle" TargetType="TextBlock" BasedOn="{StaticResource AppMutedTextStyle}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="AppEmptyStatePanelStyle" TargetType="StackPanel">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style x:Key="AppDataGridEmptyStatePanelStyle" TargetType="StackPanel" BasedOn="{StaticResource AppEmptyStatePanelStyle}">
        <Setter Property="Margin" Value="0,42,0,0" />
    </Style>

    <Style x:Key="AppRowResizeSplitterStyle" TargetType="GridSplitter">
        <Setter Property="Height" Value="18" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="SizeNS" />
        <Setter Property="ResizeDirection" Value="Rows" />
        <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
        <Setter Property="ShowsPreview" Value="False" />
        <Setter Property="ToolTip" Value="拖动调整上下表格高度" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="{TemplateBinding Background}"
                          Height="{TemplateBinding Height}"
                          SnapsToDevicePixels="True">
                        <Border x:Name="SplitterLine"
                                Height="1"
                                VerticalAlignment="Center"
                                Background="{StaticResource AppDataGridDividerBrush}" />
                        <Border x:Name="SplitterGrip"
                                Width="56"
                                Height="6"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                CornerRadius="3"
                                Background="{StaticResource AppDataGridDividerBrush}"
                                Opacity="0.85" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SplitterLine" Property="Background" Value="{StaticResource AppInfoBrush}" />
                            <Setter TargetName="SplitterGrip" Property="Background" Value="{StaticResource AppInfoBrush}" />
                            <Setter TargetName="SplitterGrip" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppEmptyStateIconFrameStyle" TargetType="Border">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="CornerRadius" Value="21" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Background" Value="{StaticResource AppInfoSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppDataGridDividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="AppEmptyStateIconStyle" TargetType="iconPacks:PackIconMaterial">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource AppInfoBrush}" />
    </Style>

    <Style x:Key="AppEmptyStateTitleStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="AppEmptyStateHintStyle" TargetType="TextBlock" BasedOn="{StaticResource AppMutedTextStyle}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="AppDataGridCellStyle" TargetType="DataGridCell">
        <Setter Property="MinHeight" Value="46" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource AppDataGridDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border x:Name="CellBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="10,0">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="CellBorder" Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppDataGridCenterCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource AppDataGridCellStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- DataGrid 列头拖拽调整大小的 Gripper Thumb 样式 -->
    <Style x:Key="ColumnHeaderGripperStyle" TargetType="Thumb">
        <Setter Property="Width" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Background" Value="{StaticResource AppDataGridHeaderBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppDataGridDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SeparatorBrush" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border x:Name="HeaderChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <DockPanel LastChildFill="True">
                                <Path x:Name="SortArrow"
                                      DockPanel.Dock="Right"
                                      Width="8"
                                      Height="5"
                                      Margin="8,0,0,0"
                                      Data="M 0 5 L 4 0 L 8 5 Z"
                                      Fill="{DynamicResource TextFillColorSecondaryBrush}"
                                      Stretch="Fill"
                                      Visibility="Collapsed"
                                      VerticalAlignment="Center" />
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True" />
                            </DockPanel>
                        </Border>
                        <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Style="{StaticResource ColumnHeaderGripperStyle}"/>
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Style="{StaticResource ColumnHeaderGripperStyle}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderChrome" Property="Background" Value="{StaticResource AppDataGridHoverBrush}" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SortArrow" Property="RenderTransformOrigin" Value="0.5,0.5" />
                            <Setter TargetName="SortArrow" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppDataGridCenterColumnHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource AppDataGridColumnHeaderStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="AppDataGridReadOnlyCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style TargetType="DataGrid" BasedOn="{StaticResource DataGridBaseStyle}">
        <Setter Property="CanUserResizeColumns" Value="True" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="HorizontalGridLinesBrush" Value="Transparent" />
        <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
        <Setter Property="ColumnHeaderHeight" Value="42" />
        <Setter Property="RowHeight" Value="46" />
        <Setter Property="AlternationCount" Value="2" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="RowBackground" Value="{DynamicResource RegionBrush}" />
        <Setter Property="AlternatingRowBackground" Value="Transparent" />
        <Setter Property="CellStyle" Value="{StaticResource AppDataGridCellStyle}" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource AppDataGridColumnHeaderStyle}" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="EnableColumnVirtualization" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    </Style>

    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource AppDataGridColumnHeaderStyle}" />

    <Style TargetType="DataGridRow">
        <Setter Property="MinHeight" Value="46" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AppDataGridHoverBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource AppDataGridSelectedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 彻底解决第三方库 ComboBoxItem 向上寻址祖先 ItemsControl 导致的控制台 Binding Error 4 绑定红字报错 -->
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
</ResourceDictionary>