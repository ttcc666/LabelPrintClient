<ui:FluentWindow x:Class="LabelPrintClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="标签打印客户端" Height="760" Width="1180"
        Icon="Assets/app-icon.ico"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <ui:TitleBar x:Name="TitleBar" Title="标签打印客户端" Grid.Row="0" Margin="0,0,0,0" />

        <ui:NavigationView x:Name="RootNavigation"
                           Grid.Row="1"
                           PaneDisplayMode="Left"
                           OpenPaneLength="180"
                           IsBackButtonVisible="Collapsed">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="标签打印中心"
                                       Tag="PrintCenter"
                                       Icon="{ui:SymbolIcon Print24}"
                                       Click="NavItem_Click" />
                <ui:NavigationViewItem Content="打印记录"
                                       Tag="PrintHistory"
                                       Icon="{ui:SymbolIcon History24}"
                                       Click="NavItem_Click" />
                <ui:NavigationViewItem Content="任务中心"
                                       Tag="TaskCenter"
                                       Icon="{ui:SymbolIcon List24}"
                                       Click="NavItem_Click" />
                <ui:NavigationViewItem Content="模板维护"
                                       Tag="TemplateManage"
                                       Icon="{ui:SymbolIcon Document24}"
                                       Click="NavItem_Click" />
                <ui:NavigationViewItem Content="系统配置"
                                       Tag="Settings"
                                       Icon="{ui:SymbolIcon Options24}"
                                       Click="NavItem_Click" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.ContentOverlay>
                <ContentControl x:Name="WorkspaceContent" Margin="0,0,0,0" />
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <ui:SnackbarPresenter x:Name="RootSnackbar" Grid.Row="1" />
    </Grid>
</ui:FluentWindow>
