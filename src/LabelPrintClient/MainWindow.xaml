<ui:FluentWindow x:Class="LabelPrintClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="标签打印客户端" Height="760" Width="1180"
        Icon="Assets/app-icon.ico"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">
    <ui:FluentWindow.Resources>
        <Style x:Key="SideNavListStyle" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="SideNavItemStyle" TargetType="ListBoxItem">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <ui:TitleBar Title="标签打印客户端" Grid.Row="0" />

        <Grid Grid.Row="1" Margin="8,4,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="148" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,0,8,0"
                    Padding="0,12"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="16,0,16,12">
                        <ui:TextBlock FontTypography="BodyStrong" Text="工作台" />
                        <ui:TextBlock Margin="0,4,0,0"
                                      FontTypography="Caption"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="选择业务模块" />
                    </StackPanel>

                    <ListBox x:Name="NavigationList"
                             Grid.Row="1"
                             Style="{StaticResource SideNavListStyle}"
                             ItemContainerStyle="{StaticResource SideNavItemStyle}"
                             SelectionChanged="NavigationList_SelectionChanged">
                        <ListBoxItem Tag="PrintCenter" Content="标签打印中心" />
                        <ListBoxItem Tag="TemplateManage" Content="模板维护" />
                    </ListBox>
                </Grid>
            </Border>

            <ContentControl x:Name="WorkspaceContent" Grid.Column="1" />
        </Grid>
    </Grid>
</ui:FluentWindow>
