<hc:Window x:Class="LabelPrintClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="标签打印客户端" Height="760" Width="1180"
        Icon="Assets/app-icon.ico"
        Background="{DynamicResource SecondaryRegionBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        WindowStartupLocation="CenterScreen"
        ShowTitle="True"
        NonClientAreaBackground="{DynamicResource RegionBrush}">

    <hc:Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="SideMenuToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="8,8,8,10"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SideNavigationListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style x:Key="SideNavigationItemStyle" TargetType="ListBoxItem">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="8,0,8,8"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="SelectionRail"
                                        Width="3"
                                        HorizontalAlignment="Left"
                                        Margin="-6,8,0,8"
                                        CornerRadius="2"
                                        Background="{DynamicResource PrimaryBrush}"
                                        Visibility="Collapsed"/>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                <Setter TargetName="SelectionRail" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </hc:Window.Resources>

    <hc:Window.NonClientAreaContent>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
            <TextBlock Text="主题" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource PrimaryTextBrush}" />
            <Border CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="2">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="SystemThemeButton" Style="{StaticResource AppGhostButtonStyle}" Width="62" MinWidth="62" Height="28" Padding="0" Click="ThemeButton_Click" Tag="System">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Monitor" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="系统" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="LightThemeButton" Style="{StaticResource AppGhostButtonStyle}" Width="62" MinWidth="62" Height="28" Padding="0" Margin="2,0,0,0" Click="ThemeButton_Click" Tag="Light">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="WeatherSunny" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="浅色" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="DarkThemeButton" Style="{StaticResource AppGhostButtonStyle}" Width="62" MinWidth="62" Height="28" Padding="0" Margin="2,0,0,0" Click="ThemeButton_Click" Tag="Dark">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="WeatherNight" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="深色" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </hc:Window.NonClientAreaContent>

    <DockPanel>
        <Border x:Name="SideMenuBorder"
                DockPanel.Dock="Left"
                Width="208"
                ClipToBounds="True"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Background="{DynamicResource SecondaryRegionBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ToggleButton x:Name="MenuToggleButton"
                              Grid.Row="0"
                              IsChecked="True"
                              Style="{StaticResource SideMenuToggleButtonStyle}"
                              ToolTip="收起 / 展开">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <iconPacks:PackIconMaterial Kind="Menu"
                                                    Width="20"
                                                    Height="20"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                        <TextBlock Grid.Column="1"
                                   Text="收起 / 展开"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                   Visibility="{Binding IsChecked, ElementName=MenuToggleButton, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                    <ToggleButton.Triggers>
                        <EventTrigger RoutedEvent="ToggleButton.Checked">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="SideMenuBorder" Storyboard.TargetProperty="Width" To="208" Duration="0:0:0.2">
                                        <DoubleAnimation.EasingFunction>
                                            <QuadraticEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="ToggleButton.Unchecked">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="SideMenuBorder" Storyboard.TargetProperty="Width" To="72" Duration="0:0:0.2">
                                        <DoubleAnimation.EasingFunction>
                                            <QuadraticEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ToggleButton.Triggers>
                </ToggleButton>

                <ListBox x:Name="RootNavigation"
                         Grid.Row="1"
                         SelectionChanged="RootNavigation_SelectionChanged"
                         Style="{StaticResource SideNavigationListStyle}">
                    <ListBoxItem Tag="PrintCenter" Style="{StaticResource SideNavigationItemStyle}" ToolTip="标签打印中心">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconMaterial Kind="Printer" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                            <TextBlock Grid.Column="1" Text="标签打印中心" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Visibility="{Binding IsChecked, ElementName=MenuToggleButton, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </ListBoxItem>
                    <ListBoxItem Tag="PrintHistory" Style="{StaticResource SideNavigationItemStyle}" ToolTip="打印记录">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconMaterial Kind="History" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                            <TextBlock Grid.Column="1" Text="打印记录" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Visibility="{Binding IsChecked, ElementName=MenuToggleButton, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </ListBoxItem>
                    <ListBoxItem Tag="TaskCenter" Style="{StaticResource SideNavigationItemStyle}" ToolTip="任务中心">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconMaterial Kind="FormatListText" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                            <TextBlock Grid.Column="1" Text="任务中心" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Visibility="{Binding IsChecked, ElementName=MenuToggleButton, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </ListBoxItem>
                    <ListBoxItem Tag="TemplateManage" Style="{StaticResource SideNavigationItemStyle}" ToolTip="模板维护">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconMaterial Kind="PencilBoxOutline" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                            <TextBlock Grid.Column="1" Text="模板维护" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Visibility="{Binding IsChecked, ElementName=MenuToggleButton, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </ListBoxItem>
                    <ListBoxItem Tag="Settings" Style="{StaticResource SideNavigationItemStyle}" ToolTip="系统配置">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconMaterial Kind="Cog" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                            <TextBlock Grid.Column="1" Text="系统配置" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Visibility="{Binding IsChecked, ElementName=MenuToggleButton, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </ListBoxItem>
                </ListBox>
            </Grid>
        </Border>

        <Grid Background="Transparent">
            <Border Margin="16"
                    Background="{DynamicResource RegionBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.06" ShadowDepth="3" BlurRadius="14"/>
                </Border.Effect>
                <hc:TransitioningContentControl x:Name="WorkspaceContent" TransitionMode="Fade" Margin="4"/>
            </Border>
        </Grid>
    </DockPanel>
</hc:Window>
