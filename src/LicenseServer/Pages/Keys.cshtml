@page
@model LicenseServer.Pages.KeysModel
@{
    ViewData["Title"] = "安全数字签名密钥 (Signing Key)";
}

<div class="console-card">
    <div class="card-title-bar">
        <h5 class="card-heading">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
            非对称数字签名保护证书说明
        </h5>
    </div>
    <div class="alert @(Model.HasMasterKey ? "alert-success" : "alert-info") mb-0">
        <div class="d-flex align-items-center gap-2">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span>
                系统运行保护状态：@(Model.HasMasterKey ? "已配置 LICENSE_SERVER_MASTER_KEY，系统具有离线私钥生成特权。" : "当前处于局域网托管运行模式，不配置或解密私钥，防窃密防篡改已自动生效。")
            </span>
        </div>
    </div>
</div>

@if (Model.ActiveKey != null)
{
    <div class="console-card">
        <div class="card-title-bar">
            <h5 class="card-heading">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
                当前激活的公钥指纹 (Active Public Key)
            </h5>
        </div>
        <dl class="row mb-0 align-items-center">
            <dt class="col-sm-2 text-muted fw-medium">公钥指纹 Hash</dt>
            <dd class="col-sm-10 m-0"><code class="code-sm fw-bold">@Model.ActiveKey.PublicKeyFingerprint</code></dd>
            
            <dt class="col-sm-2 text-muted mt-3 fw-medium">创建并激活时间</dt>
            <dd class="col-sm-10 m-0 mt-3 text-dark fw-medium">@Model.ActiveKey.CreateTime.ToString("yyyy-MM-dd HH:mm:ss")</dd>
        </dl>
    </div>
}

@if (Model.HasMasterKey)
{
    <div class="console-card">
        <div class="card-title-bar">
            <h5 class="card-heading">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"/>
                </svg>
                导入公司持有签发私钥
            </h5>
        </div>
        
        <form method="post">
            <div class="mb-3">
                <label asp-for="PrivateKeyPem" class="form-label">RSA 签名私钥明文 (PEM 格式)</label>
                <textarea asp-for="PrivateKeyPem" class="form-control font-monospace" rows="8" placeholder="请在此处粘贴带保护和标记的 -----BEGIN PRIVATE KEY----- 私钥串..."></textarea>
            </div>
            
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger py-2 mb-3">
                    @Model.ErrorMessage
                </div>
            }
            
            <button class="btn btn-primary" type="submit">导入并覆盖激活新签名密钥</button>
        </form>
    </div>
}
else
{
    <div class="console-card">
        <div class="card-title-bar">
            <h5 class="card-heading">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                </svg>
                安全限制运行自锁中
            </h5>
        </div>
        <p class="copy-muted mb-0">
            由于此 `LicenseServer` 实例运行在客户的局域网内部，本平台已经<strong>自动屏蔽了私钥导入表单</strong>。
            浮动许可证将通过内置于服务端的公开公钥进行高强度验签。您无需也不应在此服务器配置任何签名私钥，这极大地防范了私钥由于第三方逆向、硬件遗失等带来的外泄风险。
        </p>
    </div>
}
