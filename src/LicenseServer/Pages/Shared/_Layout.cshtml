<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LicenseServer Console</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- 引入 Google Fonts Outfit 字体 -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LicenseServer.styles.css" asp-append-version="true" />
</head>
<body>
@inject LicenseServer.Services.PrivateKeyProtector Protector
@{
    var activePage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    var pageTitle = ViewData["Title"]?.ToString() ?? "Console";
    var hasMasterKey = Protector.HasMasterKey;
}

    <div class="layout-container">
        <!-- 左侧工业常驻侧边栏 -->
        <aside class="sidebar-console">
            <div class="sidebar-header">
                <div class="sidebar-logo">
                    <div class="sidebar-logo-icon">LS</div>
                    <span>LicenseServer</span>
                </div>
            </div>
            
            <nav class="sidebar-menu">
                <a class="sidebar-item @(activePage == "/Index" ? "active" : "")" asp-page="/Index">
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <rect x="3" y="3" width="7" height="9" rx="1"/>
                        <rect x="14" y="3" width="7" height="5" rx="1"/>
                        <rect x="14" y="12" width="7" height="9" rx="1"/>
                        <rect x="3" y="16" width="7" height="5" rx="1"/>
                    </svg>
                    概览 (Dashboard)
                </a>
                
                @if (hasMasterKey)
                {
                    <a class="sidebar-item @(activePage == "/Customers" ? "active" : "")" asp-page="/Customers">
                        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                            <circle cx="9" cy="7" r="4"/>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                        </svg>
                        客户维护 (Customers)
                    </a>
                }
                
                <a class="sidebar-item @(activePage == "/Licenses" ? "active" : "")" asp-page="/Licenses">
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    </svg>
                    证书维护 (Licenses)
                </a>
                
                @if (!hasMasterKey)
                {
                    <a class="sidebar-item @(activePage == "/Sessions" ? "active" : "")" asp-page="/Sessions">
                        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M12 2a10 10 0 0 0-10 10v7a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-7a10 10 0 0 0-10-10z"/>
                            <circle cx="12" cy="13" r="3"/>
                        </svg>
                        在线会话 (Sessions)
                    </a>
                }
                
                @if (hasMasterKey)
                {
                    <a class="sidebar-item @(activePage == "/Keys" ? "active" : "")" asp-page="/Keys">
                        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.778-7.778zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5l-.5-.5"/>
                        </svg>
                        签名密钥 (Signing Key)
                    </a>
                }
                
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="sidebar-item text-danger mt-auto" asp-page="/Logout">
                        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                            <polyline points="16 17 21 12 16 7"/>
                            <line x1="21" y1="12" x2="9" y2="12"/>
                        </svg>
                        退出系统 (Logout)
                    </a>
                }
            </nav>
            
            <div class="sidebar-footer">
                <span>&copy; 2026 License Server</span>
            </div>
        </aside>

        <!-- 右侧工作主面板 -->
        <main class="main-workspace">
            <header class="workspace-header">
                <h2 class="header-title">@pageTitle</h2>
                
                <div class="header-user">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="text-muted">当前用户:</span>
                        <strong class="text-white">@User.Identity.Name</strong>
                        <span class="header-badge">系统管理员</span>
                    }
                    else
                    {
                        <span class="text-muted">未登录</span>
                    }
                </div>
            </header>
            
            <div class="workspace-body">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
