@page
@model LicenseServer.Pages.SessionsModel
@{
    ViewData["Title"] = "在线浮动会话 (Sessions)";
}

<div class="console-card">
    <div class="card-title-bar">
        <h5 class="card-heading">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            并发会话托管监控说明
        </h5>
    </div>
    <p class="copy-muted mb-0">
        本仪表板显示局域网客户端正在连接使用的<strong>实时并发浮动席位</strong>。
        当客户端意外关机或网络中断时，系统在心跳超时后会自动清理释放其席位占用。管理员也可以在下表中，针对由于非正常离线导致席位被长期锁定的客户端，执行手动<strong>【强制释放】</strong>。
    </p>
</div>

<div class="table-responsive">
    <table class="console-table align-middle">
        <thead>
            <tr>
                <th>产品代号</th>
                <th>机器码 (MachineCode)</th>
                <th>客户端主机名</th>
                <th>初次授权时间</th>
                <th>最后活跃心跳</th>
                <th>系统超时期截止</th>
                <th class="table-action-narrow">会话强制操作</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td><code class="code-pill code-sm">@item.ProductCode</code></td>
                <td><code class="code-xs">@item.Session.MachineCode</code></td>
                <td class="fw-medium">@item.Session.MachineName</td>
                <td>@item.Session.LoginTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td>@item.Session.LastHeartbeat.ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td>
                    @if (item.Session.ExpireTime <= DateTime.Now)
                    {
                        <span class="text-danger">已超时过期</span>
                    }
                    else
                    {
                        <span>@item.Session.ExpireTime.ToString("yyyy-MM-dd HH:mm:ss")</span>
                    }
                </td>
                <td>
                    <form method="post" asp-page-handler="Release" asp-route-id="@item.Session.Id" class="m-0">
                        <button class="btn btn-sm btn-outline-danger py-1" type="submit" onclick="return confirm('确定要强行踢掉并释放该客户端的浮动授权席位吗？');">
                            强制断开会话
                        </button>
                    </form>
                </td>
            </tr>
        }
        @if (!Model.Items.Any())
        {
            <tr>
                <td colspan="7" class="text-center text-muted py-4">
                    当前暂无任何活跃的浮动授权会话连接。
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
