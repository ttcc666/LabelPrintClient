@page
@model LicenseServer.Pages.SetupModel
@{
    ViewData["Title"] = "Setup";
}

<h1>初始化管理员</h1>
<form method="post" class="w-50">
    <div class="mb-3">
        <label class="form-label">账号</label>
        <input class="form-control" value="System" disabled />
    </div>
    <div class="mb-3">
        <label asp-for="DisplayName" class="form-label"></label>
        <input asp-for="DisplayName" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" type="password" class="form-control" />
    </div>
    <div class="text-danger">@Model.ErrorMessage</div>
    <button class="btn btn-primary" type="submit">创建管理员</button>
</form>
