@page
@model LicenseServer.Pages.SetupModel
@{
    Layout = null;
    ViewData["Title"] = "Setup";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>初始化管理员 - LicenseServer Console</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-body">
    <div class="login-glass-card login-glass-card-wide">
        <div class="auth-brand">
            <div class="sidebar-logo-icon">LS</div>
            <span class="auth-brand-name">LicenseServer</span>
        </div>
        
        <h5 class="auth-title">初始化系统管理员</h5>
        
        <form method="post" class="text-start">
            <div class="mb-3">
                <label class="form-label">管理员登录账号</label>
                <input class="form-control setup-fixed-user" value="System" disabled />
                <span class="text-muted small mt-1 d-block">系统固定的主系统管理员账号名称</span>
            </div>
            
            <div class="mb-3">
                <label asp-for="DisplayName" class="form-label">显示名称 (DisplayName)</label>
                <input asp-for="DisplayName" class="form-control" placeholder="请输入管理员公开昵称" required />
            </div>
            
            <div class="mb-4">
                <label asp-for="Password" class="form-label">安全验证密码 (Password)</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="设置后台管理的登录密码" required autocomplete="new-password" />
            </div>
            
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger py-2 mb-3 text-center">
                    @Model.ErrorMessage
                </div>
            }
            
            <button class="btn btn-primary w-100 py-2.5" type="submit">
                创建系统管理员并登录
            </button>
        </form>
    </div>
</body>
</html>
