@page
@model IndexModel
@{
    ViewData["Title"] = "控制台概览 (Dashboard)";
}

<div class="row g-4">
    <div class="col-md-3">
        <div class="console-card metric-card d-flex align-items-center justify-content-between">
            <div>
                <span class="metric-label">合作客户总数</span>
                <span class="metric-value">@Model.CustomerCount</span>
            </div>
            <div class="metric-icon">
                <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                </svg>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="console-card metric-card d-flex align-items-center justify-content-between">
            <div>
                <span class="metric-label">存量许可证</span>
                <span class="metric-value">@Model.LicenseCount</span>
            </div>
            <div class="metric-icon metric-icon-success">
                <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="console-card metric-card d-flex align-items-center justify-content-between">
            <div>
                <span class="metric-label">实时浮动会话</span>
                <span class="metric-value">@Model.SessionCount</span>
            </div>
            <div class="metric-icon metric-icon-warning">
                <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path d="M12 2a10 10 0 0 0-10 10v7a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-7a10 10 0 0 0-10-10z"/>
                    <circle cx="12" cy="13" r="3"/>
                </svg>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="console-card metric-card d-flex align-items-center justify-content-between">
            <div>
                <span class="metric-label">离线签名状态</span>
                <span class="metric-status text-dark">
                    @if (Model.HasSigningKey)
                    {
                        <span class="text-success">● 已导入私钥</span>
                    }
                    else
                    {
                        <span class="text-muted">○ 局域网托管</span>
                    }
                </span>
            </div>
            <div class="metric-icon metric-icon-info">
                <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.778-7.778zm0 0L15.5 7.5"/>
                </svg>
            </div>
        </div>
    </div>
</div>

<div class="console-card mt-4">
    <h5 class="card-heading mb-3">快捷向导与说明</h5>
    <p class="copy-muted mb-0">
        欢迎使用 <strong>LicenseServer 核心授权中转与管理控制台</strong>。本平台采用非对称加密算法对客户端授权进行高强度防篡改保护。
        在公司端运行时，您可以导入私钥进行离线许可证生成；当部署于客户隔离的内网时，该平台作为席位人数控制中心，运维人员在此导入由公司签发的许可证文件，以便内网客户端进行浮动许可授权分发。
    </p>
</div>
