@page
@model LicenseServer.Pages.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Login";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>管理员登录 - LicenseServer Console</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-body">
    <div class="login-glass-card">
        <div class="auth-brand">
            <div class="sidebar-logo-icon">LS</div>
            <span class="auth-brand-name">LicenseServer</span>
        </div>
        
        <h5 class="auth-title">安全凭证验证登录</h5>
        
        <form method="post" class="text-start">
            <div class="mb-3">
                <label asp-for="UserName" class="form-label">管理员用户名</label>
                <input asp-for="UserName" class="form-control" placeholder="输入管理员账户名" required autocomplete="username" />
            </div>
            <div class="mb-4">
                <label asp-for="Password" class="form-label">系统管理密码</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="输入管理安全密码" required autocomplete="current-password" />
            </div>
            
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger py-2 mb-3 text-center">
                    @Model.ErrorMessage
                </div>
            }
            
            <button class="btn btn-primary w-100 py-2.5" type="submit">
                验证并进入控制台
            </button>
        </form>
    </div>
</body>
</html>
