@page
@model LicenseServer.Pages.CustomersModel
@{
    ViewData["Title"] = "客户维护 (Customers)";
}

<div class="console-card">
    <div class="card-title-bar">
        <h5 class="card-heading">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
            </svg>
            登记合作客户
        </h5>
    </div>
    
    <form method="post" class="row g-3 align-items-end">
        <input type="hidden" asp-for="Input.Id" />
        <div class="col-md-3">
            <label asp-for="Input.Name" class="form-label">客户公司名称</label>
            <input asp-for="Input.Name" class="form-control" placeholder="输入客户全称" required />
        </div>
        <div class="col-md-2">
            <label asp-for="Input.Contact" class="form-label">首要联系人</label>
            <input asp-for="Input.Contact" class="form-control" placeholder="姓名 / 电话" />
        </div>
        <div class="col-md-4">
            <label asp-for="Input.Remark" class="form-label">合作备注信息</label>
            <input asp-for="Input.Remark" class="form-control" placeholder="如：XX事业部、首批合作等" />
        </div>
        <div class="col-md-1.5 pb-2">
            <div class="form-check form-switch pt-1">
                <input asp-for="Input.IsEnabled" class="form-check-input" type="checkbox" role="switch" checked id="isEnabledSwitch" />
                <label class="form-check-label form-label m-0" for="isEnabledSwitch">启用状态</label>
            </div>
        </div>
        <div class="col-md-1">
            <button class="btn btn-primary w-100" type="submit">保存</button>
        </div>
    </form>
</div>

<div class="table-responsive">
    <table class="console-table">
        <thead>
            <tr>
                <th>客户名称</th>
                <th>首要联系人</th>
                <th>系统状态</th>
                <th>备注说明</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Customers)
        {
            <tr>
                <td style="font-weight: 600;">@item.Name</td>
                <td>@item.Contact</td>
                <td>
                    @if (item.IsEnabled)
                    {
                        <span class="badge bg-success">启用中</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">已禁用</span>
                    }
                </td>
                <td class="text-muted">@item.Remark</td>
            </tr>
        }
        </tbody>
    </table>
</div>
