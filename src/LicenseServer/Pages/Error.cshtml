@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="console-card error-panel">
    <h1 class="text-danger mb-2">Error.</h1>
    <h2 class="text-muted fs-5 mb-3">An error occurred while processing your request.</h2>

    @if (Model.ShowRequestId)
    {
        <p class="mb-0">
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }
</div>
