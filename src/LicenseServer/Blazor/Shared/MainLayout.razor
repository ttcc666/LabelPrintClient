@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject LicenseServer.Services.PrivateKeyProtector Protector
@inject AuthenticationStateProvider AuthStateProvider

<MudThemeProvider Theme="MyCustomTheme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <!-- 顶部高透磨砂 Appbar -->
    <MudAppBar Elevation="0" Style="border-bottom: 1px solid rgba(228, 228, 231, 0.8); background-color: rgba(255, 255, 255, 0.85); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); color: #09090b; height: 68px;">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        <MudText Typo="Typo.h6" Class="ml-2 font-weight-bold" Style="font-size: 1.05rem; letter-spacing: 0.5px;">@_pageTitle</MudText>
        <MudSpacer />
        
        <!-- 用户个人中心下拉浮动舱（完美替换左侧 mt-auto 退出以杜绝误触） -->
        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Class="mr-2">
            <ActivatorContent>
                <MudChip T="string" Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Default" Variant="Variant.Text" Style="cursor: pointer; border: 1px solid rgba(228, 228, 231, 0.8); background: rgba(255, 255, 255, 0.9); font-weight: 600; padding: 6px 14px; border-radius: 9999px;">
                    @_userName (管理员)
                </MudChip>
            </ActivatorContent>
            <ChildContent>
                <div class="pa-4 d-flex flex-column align-center" style="width: 220px; background: #ffffff;">
                    <div style="width: 44px; height: 44px; background: rgba(14, 165, 233, 0.08); color: #0ea5e9; border-radius: 50%; display: flex; align-items: center; justify-content: center;" class="mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Medium" />
                    </div>
                    <MudText Style="font-weight: 700; color: #09090b; font-size: 0.95rem;">@_userName</MudText>
                    <MudText Style="font-size: 0.75rem; color: #71717a;" Class="mt-0.5">Console Administrator</MudText>
                    
                    <MudDivider Class="my-3" Style="width: 100%; border-color: rgba(228, 228, 231, 0.8);" />
                    
                    <MudButton OnClick="PerformLogout" Color="Color.Error" Variant="Variant.Outlined" FullWidth="true" StartIcon="@Icons.Material.Filled.Logout" Style="border-radius: 8px; font-weight: 600; font-size: 0.825rem; padding: 6px 12px; text-transform: none;">
                        退出系统
                    </MudButton>
                </div>
            </ChildContent>
        </MudMenu>
    </MudAppBar>

    <!-- 左侧工业常驻 Navigation Drawer (升级为 Mini 模式，大屏下可点击汉堡菜单自动缩窄为极简图标窄条，且图标全部可见) -->
    <MudDrawer @bind-Open="_drawerOpen" Elevation="0" ClipMode="DrawerClipMode.Always" Style="border-right: 1px solid rgba(228, 228, 231, 0.8); background-color: #ffffff;" Width="280px" MiniWidth="70px" Variant="DrawerVariant.Mini" OpenMiniOnHover="false">
        <MudDrawerHeader Class="align-center px-6 py-5" Style="border-bottom: 1px solid rgba(228, 228, 231, 0.8); height: 68px;">
            <div class="d-flex align-center gap-3">
                <div style="width: 28px; height: 28px; background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%); border-radius: 7px; display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 800; font-size: 0.85rem; box-shadow: 0 4px 10px rgba(14, 165, 233, 0.25);">LS</div>
                @if (_drawerOpen)
                {
                    <span style="font-weight: 700; font-size: 1.15rem; background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; letter-spacing: -0.02em;">LicenseServer</span>
                }
            </div>
        </MudDrawerHeader>
        
        <!-- SPA 极其平滑的零刷新路由菜单 (已彻底清除易发生误触的退出按钮) -->
        <MudNavMenu Class="pa-3">
            <MudNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard" Href="" Style="font-size: 0.9rem; font-weight: 500; border-radius: 8px;">系统概览</MudNavLink>
            
            @if (_hasMasterKey)
            {
                <MudNavLink Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People" Href="customers" Style="font-size: 0.9rem; font-weight: 500; border-radius: 8px;">客户管理</MudNavLink>
            }
            
            <MudNavLink Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Security" Href="licenses" Style="font-size: 0.9rem; font-weight: 500; border-radius: 8px;">证书管理</MudNavLink>
            
            @if (!_hasMasterKey)
            {
                <MudNavLink Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.LeakAdd" Href="sessions" Style="font-size: 0.9rem; font-weight: 500; border-radius: 8px;">会话监控</MudNavLink>
            }
            
            @if (_hasMasterKey)
            {
                <MudNavLink Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.VpnKey" Href="keys" Style="font-size: 0.9rem; font-weight: 500; border-radius: 8px;">签名密钥</MudNavLink>
            }
        </MudNavMenu>
    </MudDrawer>

    <!-- 右侧主工作面板 (解耦剥离外部硬包装，让 padding 完全由具体页面 MudContainer 黄金呈现) -->
    <MudMainContent>
        @Body
    </MudMainContent>

<style>
    .mud-main-content {
        background-color: #f8fafc !important;
    }
</style>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _hasMasterKey;
    private string _userName = "Admin";
    private string _pageTitle = "系统概览";

    // 浅色冷白极客主题定制 (Premium Cold-Light spec)
    private MudTheme MyCustomTheme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#0ea5e9",
            Secondary = "#71717a", // 显式自定义为高级工业冷灰色，彻底替换默认玫红色
            Success = "#16a34a",
            Error = "#ef4444",
            Warning = "#f59e0b",
            Background = "#f8fafc",
            Surface = "#ffffff",
            AppbarBackground = "rgba(255, 255, 255, 0.8)",
            DrawerBackground = "#ffffff",
            TextPrimary = "#09090b",
            TextSecondary = "#71717a",
            ActionDefault = "#64748b",
            TableHover = "rgba(14, 165, 233, 0.04)",
            Divider = "rgba(228, 228, 231, 0.8)"
        }
    };

    protected override async Task OnInitializedAsync()
    {
        _hasMasterKey = Protector.HasMasterKey;
        
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            _userName = user.Identity.Name ?? "Admin";
        }

        // 订阅路由变化以动态精细调整顶栏标题
        NavigationManager.LocationChanged += OnLocationChanged;
        UpdatePageTitle(NavigationManager.Uri);
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdatePageTitle(e.Location);
        StateHasChanged();
    }

    private void UpdatePageTitle(string uri)
    {
        var relativePath = NavigationManager.ToBaseRelativePath(uri).ToLower();
        if (string.IsNullOrEmpty(relativePath) || relativePath == "/")
        {
            _pageTitle = "系统概览";
        }
        else if (relativePath.StartsWith("customers"))
        {
            _pageTitle = "客户管理";
        }
        else if (relativePath.StartsWith("licenses"))
        {
            _pageTitle = "证书管理";
        }
        else if (relativePath.StartsWith("sessions"))
        {
            _pageTitle = "会话监控";
        }
        else if (relativePath.StartsWith("keys"))
        {
            _pageTitle = "签名密钥";
        }
        else
        {
            _pageTitle = "管理控制台";
        }
    }

    private void PerformLogout()
    {
        NavigationManager.NavigateTo("logout", forceLoad: true);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
