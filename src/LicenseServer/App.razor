@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Authorization

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(LicenseServer.Blazor.Shared.MainLayout)">
                <NotAuthorized>
                    <p class="p-4">正在重定向到登录页面...</p>
                    @{
                        // 双重安全保险：未授权时重加载回到 login 登录页
                        NavigationManager.NavigateTo("login", forceLoad: true);
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(LicenseServer.Blazor.Shared.MainLayout)">
                <div class="p-8 text-center">
                    <p class="text-muted mb-4">抱歉，您访问的页面不存在或没有权限访问。</p>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick='() => NavigationManager.NavigateTo("")'>返回主页</MudButton>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;
}
