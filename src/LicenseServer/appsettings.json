{
  "LicenseServer": {
    "RunMode": "LocalSqlite",
    "SqliteConnection": "DataSource=Data/license_server.db",
    "PostgreSqlConnection": "Host=127.0.0.1;Port=5432;Username=postgres;Database=license_server;",
    "HeartbeatIntervalSeconds": 30,
    "SessionTimeoutSeconds": 120,
    "MasterKeyEnvironmentName": "LICENSE_SERVER_MASTER_KEY",
    "MasterKey": "11111"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
